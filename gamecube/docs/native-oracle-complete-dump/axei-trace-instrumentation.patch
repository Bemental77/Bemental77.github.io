diff --git a/Source/Core/Core/PowerPC/PowerPC.cpp b/Source/Core/Core/PowerPC/PowerPC.cpp
index 564d74d..3abad20 100644
--- a/Source/Core/Core/PowerPC/PowerPC.cpp
+++ b/Source/Core/Core/PowerPC/PowerPC.cpp
@@ -583,12 +583,46 @@ void PowerPCManager::CheckExceptions()
 
 void PowerPCManager::CheckExternalExceptions()
 {
+  // [ax-wp-native] Mirror WASM-side PC watchpoint at AX-init function entries.
+  // Logs canonical register state native passes through these PCs so the WASM
+  // build can be compared against it.
+  if (m_ppc_state.pc == 0x800f8344u || m_ppc_state.pc == 0x800f5728u ||
+      m_ppc_state.pc == 0x800f8370u)
+  {
+    static u32 wp_hits = 0;
+    wp_hits++;
+    if (wp_hits <= 16 || (wp_hits & 0x3F) == 1)
+    {
+      NOTICE_LOG_FMT(POWERPC,
+                     "[ax-wp-native] pc={:#x} hit={} r3={:#x} r13={:#x} r31={:#x} r1={:#x} r0={:#x}",
+                     m_ppc_state.pc, wp_hits, m_ppc_state.gpr[3], m_ppc_state.gpr[13],
+                     m_ppc_state.gpr[31], m_ppc_state.gpr[1], m_ppc_state.gpr[0]);
+    }
+  }
+
   const u32 exceptions = m_ppc_state.Exceptions;
 
   // EXTERNAL INTERRUPT
   // Handling is delayed until MSR.EE=1.
+  static u64 axei_cee_logged = 0;
+  if (exceptions != 0 && axei_cee_logged < 100)
+  {
+    axei_cee_logged++;
+    NOTICE_LOG_FMT(POWERPC,
+                   "[axei-trace] CheckExtExc n={} Exceptions={:#x} msr.EE={} pc={:#x} npc={:#x}",
+                   axei_cee_logged, exceptions, m_ppc_state.msr.EE ? 1 : 0,
+                   m_ppc_state.pc, m_ppc_state.npc);
+  }
   if (exceptions == 0 || !m_ppc_state.msr.EE)
     return;
+  static u64 axei_deliver_logged = 0;
+  if (axei_deliver_logged < 100)
+  {
+    axei_deliver_logged++;
+    NOTICE_LOG_FMT(POWERPC,
+                   "[axei-trace] CheckExtExc DELIVER n={} Exceptions={:#x} pc={:#x}",
+                   axei_deliver_logged, exceptions, m_ppc_state.pc);
+  }
 
   u32 exception_vector = 0;
 
