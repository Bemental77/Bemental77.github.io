+    break;
+  case SAL_AUXT_CHORUS:
+    AUXP(SND_AUX_CHORUS, ch, baseDelay); AUXP(SND_AUX_CHORUS, ch, variation); AUXP(SND_AUX_CHORUS, ch, period);
+    break;
+  case SAL_AUXT_DELAY:
