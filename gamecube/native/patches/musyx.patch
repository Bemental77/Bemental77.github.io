+static void *logPut(u32 type, u32 bytes) {
+  const u32 need = 4 + ((bytes + 3) & ~3u);
+  if (!salPCLogBuf || salPCLogLen + need > salPCLogCap) {
+    salPCLogOverflow = 1;
+    return NULL;
+  }
+  u8 *p = salPCLogBuf + salPCLogLen;
+  ((u16 *)p)[0] = (u16)type;
+  ((u16 *)p)[1] = (u16)bytes;
+  salPCLogLen += need;
+  memset(p + 4 + bytes, 0, need - 4 - bytes);
+  return p + 4;
