+static void resync(const u8 *p) {
+  const int first = !rSynced;
+  if (first) {
+    ++rStats[1];
+    renderInit();
+#if MUSY_VERSION >= MUSY_VERSION_CHECK(2, 0, 1)
+    memset(filterState, 0, sizeof(filterState));
+#endif
+    for (u32 i = 0; i < 8; ++i) { auxShutdown(&rAux[i]); rAux[i].key = 0; }
+    memset(rVoices, 0, sizeof rVoices);
+  } else {
+    ++rStats[9];
+  }
+  u8 seen[SYNTH_MAX_VOICES];
+  memset(seen, 0, sizeof seen);
+  const u32 nv = ((const u32 *)p)[1]; p += 8;
+  for (u32 i = 0; i < nv; ++i, p += sizeof(SalSnapVoice)) {
+    const SalSnapVoice *o = (const SalSnapVoice *)p;
+    if (o->voice >= SYNTH_MAX_VOICES) continue;
+    seen[o->voice] = 1;
+    if (!first && sameVoice(o)) continue;
+    if (!first) { retireVoice(o->voice); ++rStats[8]; }
+    setVoice(o);
+  }
+  if (!first)
+    for (u32 v = 0; v < SYNTH_MAX_VOICES; ++v)
+      if (!seen[v]) retireVoice(v);
+  const u32 ns = *(const u32 *)p; p += 4;
+  for (u32 i = 0; i < ns; ++i, p += sizeof(SalSnapStudio)) {
+    const SalSnapStudio *o = (const SalSnapStudio *)p;
+    if (o->studio >= 8) continue;
+    DSPstudioinfo *sp = &dspStudio[o->studio];
+    if (o->active) {
+      if (first || sp->state != DSP_STUDIO_STATE_ACTIVE || sp->isMaster != (u8)o->isMaster || sp->type != (SND_STUDIO_TYPE)o->type)
+        renderActivateStudio(o->studio, o->isMaster, o->type);
+    } else sp->state = DSP_STUDIO_STATE_INACTIVE;
+  }
+  const u32 na = *(const u32 *)p; p += 4;
+  u8 keep[8];
+  memset(keep, 0, sizeof keep);
+  for (u32 i = 0; i < na; ++i, p += sizeof(SalSnapAux)) {
+    const SalSnapAux *o = (const SalSnapAux *)p;
+    RenderAux *a = auxFind(o->key, 0);
+    if (a && a->live && a->type == o->type) {
+      RenderAux t = *a;
+      auxParams(&t, o->type, o->data);
+      if (!memcmp(&t.u, &a->u, sizeof t.u)) { keep[a - rAux] = 1; continue; }   /* the same effect: its tail continues */
+    }
+    if (a) { auxShutdown(a); a->key = 0; }
+    auxPrepare(o->type, o->key, o->data);
+    a = auxFind(o->key, 0);
+    if (a) keep[a - rAux] = 1;
+  }
+  for (u32 i = 0; i < 8; ++i)
+    if (rAux[i].key && !keep[i]) { auxShutdown(&rAux[i]); rAux[i].key = 0; }
+  rSynced = 1;
+}
+
+static void outCycle(void) {
+  const u32 need = (rOutLen + cycleFrames) * rChannels;
+  if (need > rOutCap) return;   /* the caller sized it for a frame; never write past it */
+  cycleOutput(rOut + rOutLen * rChannels);
+  rOutLen += cycleFrames;
+}
+
+/* replay one guest frame's log; returns the frames of PCM written to out (stereo s16 at the cycle rate) */
+u32 salPCRenderLog(const u8 *log, u32 len, s16 *out, u32 outFrames) {
+  rOut = out; rOutCap = outFrames * 2; rOutLen = 0;
+  if (!dspVoice) {   /* first use */
+    dspVoice = rVoices;
+    salNumVoices = SYNTH_MAX_VOICES; salMaxStudioNum = 8;
+    for (u32 i = 0; i < 8; ++i) {
+      DSPstudioinfo *studio = &dspStudio[i];
+      studio->main[0] = calloc(1, SAL_PC_STUDIO_BYTES);
+      studio->main[1] = studio->main[0] + 3 * SAL_SAMPLES_PER_FRAME;
+      for (u32 j = 0; j < 3; ++j) {
+        studio->auxA[j] = studio->main[0] + (2 + j) * 3 * SAL_SAMPLES_PER_FRAME;
+        studio->auxB[j] = studio->main[0] + (5 + j) * 3 * SAL_SAMPLES_PER_FRAME;
+      }
+    }
+    initResampleTables();
+    renderInit();
+  }
+  ++rStats[0];
+  const u8 *p = log, *end = log + len;
+  u8 st = 0;
+  DSPstudioinfo *stp = NULL;
+  int inCycle = 0;
+  while (p + 4 <= end) {
+    const u32 type = ((const u16 *)p)[0], bytes = ((const u16 *)p)[1];
+    const u8 *d = p + 4;
+    p += 4 + ((bytes + 3) & ~3u);
+    if (p > end) break;
+    ++rStats[3];
+    const u32 *w = (const u32 *)d;
+    switch (type) {
+    case SALR_FRAME: {
+      const u32 serial = w[0];
+      if (!rSynced || serial != rSerial + 1) resync(d);
+      rSerial = serial;
+      break;
+    }
+    case SALR_INIT: renderInit(); break;
+    case SALR_STUDIO_ACTIVATE: if (w[0] < 8) renderActivateStudio(w[0], w[1], w[2]); break;
+    case SALR_AUX_PREPARE: auxPrepare(w[0], w[1], (const u8 *)(w + 2)); break;
+    case SALR_AUX_UPDATE: auxUpdate(w[0], w[1], (const u8 *)(w + 2)); break;
+    case SALR_AUX_SHUTDOWN: { RenderAux *a = auxFind(w[1], 0); if (a) { auxShutdown(a); a->key = 0; } break; }
+    case SALR_RETIRE: {
+      if (w[0] >= SYNTH_MAX_VOICES) break;
+      DSPvoice *vp = &rVoices[w[0]];
+      vp->studio = (u8)w[1];
+      const u32 saved = renderOffset;
+      renderOffset = w[2];
+      retireContribution(vp);
+      ++rStats[7];
+      renderOffset = saved;
+      vp->state = DSP_VOICE_STATE_INACTIVE;
+      break;
+    }
+    case SALR_CYCLE: {
+      const SalRecCycle *c = (const SalRecCycle *)d;
+      cycleFrames = c->cycleFrames;
+      for (u32 i = 0; i < 6; ++i) segmentOffset[i] = c->segmentOffset[i];
+      cycleTick = ((u64)c->cycleTickHi << 32) | c->cycleTickLo;
+      salFrame = (u8)c->salFrame; salAuxFrame = (u8)c->salAuxFrame;
+      rRate = c->rate; rChannels = c->channels;
+      renderOffset = 0;
+      memset(mixBufferL, 0, sizeof(mixBufferL));
+      memset(mixBufferR, 0, sizeof(mixBufferR));
+      memset(mixBufferRear, 0, sizeof(mixBufferRear));
+      inCycle = 1;
+      ++rStats[2];
+      break;
+    }
+    case SALR_STUDIO_BEGIN:
+      st = (u8)w[0]; stp = &dspStudio[st];
+      studioBegin(st, stp);
+      break;
+    case SALR_DATA: mirrorWrite(w[0], (const u8 *)(w + 2), w[1]); rStats[5] += w[1]; break;
+    case SALR_ADPCM: if (w[0] < SYNTH_MAX_VOICES) setAdpcm(w[0], (const SalRecAdpcm *)(w + 1)); break;
+    case SALR_VSTART: {
+      const SalRecVStart *o = (const SalRecVStart *)d;
+      if (o->voice >= SYNTH_MAX_VOICES) break;
+      VoiceResamplerState *rs = &voiceResampler[o->voice];
+      memset(rs, 0, sizeof(*rs));
+      rs->itdDelay[0] = o->itd0; rs->itdDelay[1] = o->itd1;
+      setReader(&rs->reader, &o->reader);
+      setAdpcm(o->voice, &o->adpcm);
+#if MUSY_VERSION >= MUSY_VERSION_CHECK(2, 0, 1)
+      filterState[o->voice] = 0;
+#endif
+      break;
+    }
+    case SALR_VCYCLE: {
+      const SalRecVCycle *o = (const SalRecVCycle *)d;
+      if (o->voice >= SYNTH_MAX_VOICES) break;
+      DSPvoice *vp = &rVoices[o->voice];
+      vp->state = DSP_VOICE_STATE_PLAYING; vp->studio = (u8)o->studio;
+      void *extra = vp->smp_info.extraData;
+      setSample(vp, &o->smp);
+      vp->smp_info.extraData = extra;
+      u16 *v[9] = {&vp->volL, &vp->volR, &vp->volS, &vp->volLa, &vp->volRa, &vp->volSa, &vp->volLb, &vp->volRb, &vp->volSb};
+      u16 *l[9] = {&vp->lastVolL, &vp->lastVolR, &vp->lastVolS, &vp->lastVolLa, &vp->lastVolRa, &vp->lastVolSa, &vp->lastVolLb, &vp->lastVolRb, &vp->lastVolSb};
+      for (u32 i = 0; i < 9; ++i) { *v[i] = o->vol[i]; *l[i] = o->lastVol[i]; }
+      vp->volRear[0] = o->volRear[0]; vp->volRear[1] = o->volRear[1];
+      vp->lastVolRear[0] = o->lastVolRear[0]; vp->lastVolRear[1] = o->lastVolRear[1];
+      vp->srcTypeSelect = (u16)o->srcTypeSelect; vp->srcCoefSelect = (u16)o->srcCoefSelect;
+#if MUSY_VERSION >= MUSY_VERSION_CHECK(2, 0, 1)
+      vp->filter.on = (u8)o->filterOn; vp->filter.coefA = o->coefA; vp->filter.coefB = o->coefB;
+#endif
+      vp->flags = o->flags; vp->itdShiftL = (u16)o->itdShiftL; vp->itdShiftR = (u16)o->itdShiftR;
+      break;
+    }
+    case SALR_SEG: {
+      const SalRecSeg *o = (const SalRecSeg *)d;
+      if (o->voice >= SYNTH_MAX_VOICES || !stp) break;
+      ++rStats[6];
+      DSPvoice *vp = &rVoices[o->voice];
+      vp->playInfo.pitch = o->pitch;
+      vp->pitch[0] = o->pitch;
+      s32 *studioMain = (o->buffers & 1) ? stp->main[salFrame] : NULL;
+      s32 *auxACur = (o->buffers & 2) ? stp->auxA[salAuxFrame] : NULL;
+      s32 *auxBCur = (o->buffers & 4) ? stp->auxB[salAuxFrame] : NULL;
+      renderOffset = segmentOffset[o->subframe];
+      renderVoiceSegment(vp, studioMain, studioMain ? studioMain + SAL_SAMPLES_PER_FRAME : NULL,
+                         studioMain ? studioMain + SAL_SAMPLES_PER_FRAME * 2 : NULL, auxACur,
+                         auxACur ? auxACur + SAL_SAMPLES_PER_FRAME : NULL, auxACur ? auxACur + SAL_SAMPLES_PER_FRAME * 2 : NULL,
+                         auxBCur, auxBCur ? auxBCur + SAL_SAMPLES_PER_FRAME : NULL, auxBCur ? auxBCur + SAL_SAMPLES_PER_FRAME * 2 : NULL,
+                         o->voice, (int)o->frameOffset, (int)o->frameSamples, (u16)o->adsrStart, (u16)o->adsrEnd);
+      renderOffset = segmentOffset[o->subframe + 1];
+      break;
+    }
+    case SALR_VEND:
+      if (w[0] < SYNTH_MAX_VOICES) {
+        voiceResampler[w[0]].itdDelay[0] = w[1]; voiceResampler[w[0]].itdDelay[1] = w[2];
+        DSPvoice *vp = &rVoices[w[0]];   /* the control side's end-of-cycle step: VCYCLE is sent only on change */
+        vp->lastVolL = vp->volL; vp->lastVolR = vp->volR; vp->lastVolS = vp->volS;
+        vp->lastVolLa = vp->volLa; vp->lastVolRa = vp->volRa; vp->lastVolSa = vp->volSa;
+        vp->lastVolLb = vp->volLb; vp->lastVolRb = vp->volRb; vp->lastVolSb = vp->volSb;
+        vp->lastVolRear[0] = vp->volRear[0]; vp->lastVolRear[1] = vp->volRear[1];
+      }
+      break;
+    case SALR_SEG2: {
+      const u8 *b = d;
+      const u32 v = b[0], sub = b[1], bufs = b[2];
+      if (v >= SYNTH_MAX_VOICES || !stp || sub >= SAL_SUBFRAMES) break;
+      if (b[3]) memcpy(&rPitch[v], b + 8, 4);
+      ++rStats[6];
+      DSPvoice *vp = &rVoices[v];
+      vp->playInfo.pitch = rPitch[v];
+      vp->pitch[0] = rPitch[v];
+      s32 *studioMain = (bufs & 1) ? stp->main[salFrame] : NULL;
+      s32 *auxACur = (bufs & 2) ? stp->auxA[salAuxFrame] : NULL;
+      s32 *auxBCur = (bufs & 4) ? stp->auxB[salAuxFrame] : NULL;
+      const int off = (int)segmentOffset[sub], cnt = (int)(segmentOffset[sub + 1] - segmentOffset[sub]);
+      renderOffset = segmentOffset[sub];
+      renderVoiceSegment(vp, studioMain, studioMain ? studioMain + SAL_SAMPLES_PER_FRAME : NULL,
+                         studioMain ? studioMain + SAL_SAMPLES_PER_FRAME * 2 : NULL, auxACur,
+                         auxACur ? auxACur + SAL_SAMPLES_PER_FRAME : NULL, auxACur ? auxACur + SAL_SAMPLES_PER_FRAME * 2 : NULL,
+                         auxBCur, auxBCur ? auxBCur + SAL_SAMPLES_PER_FRAME : NULL, auxBCur ? auxBCur + SAL_SAMPLES_PER_FRAME * 2 : NULL,
+                         v, off, cnt, ((const u16 *)b)[2], ((const u16 *)b)[3]);
+      renderOffset = segmentOffset[sub + 1];
+      break;
+    }
+    case SALR_STUDIO_END: {
+      const SalRecStudioEnd *o = (const SalRecStudioEnd *)d;
+      if (o->studio >= 8) break;
+      st = (u8)o->studio; stp = &dspStudio[st];
+      stp->isMaster = (u8)o->isMaster; stp->type = (SND_STUDIO_TYPE)o->type; stp->numInputs = (u8)o->numInputs;
+      for (u32 i = 0; i < o->numInputs && i < 7; ++i) {
+        stp->in[i].studio = (u8)o->in[i].studio; stp->in[i].vol = (u16)o->in[i].vol;
+        stp->in[i].volA = (u16)o->in[i].volA; stp->in[i].volB = (u16)o->in[i].volB;
+      }
+      auxBind(o->auxType[0], o->auxKey[0], &stp->auxAHandler, &stp->auxAUser);
+      auxBind(o->auxType[1], o->auxKey[1], &stp->auxBHandler, &stp->auxBUser);
+      studioFinish(st, stp);
+      stp = NULL;
+      break;
+    }
+    case SALR_CYCLE_END:
+      if (!inCycle) break;
+      depopCursor = (depopCursor + cycleFrames) & (DEPOP_RING - 1);
+      renderOffset = 0;
+      outCycle();
+      inCycle = 0;
+      break;
+    }
+  }
+  return rOutLen;
+}
+u32 *salPCRenderStats(void) { return rStats; }
+#endif /* SAL_PC_RENDER */
