+  case SAL_AUXT_REVHI: sndAuxCallbackUpdateSettingsReverbHI(&a->u.hi); break;
+  case SAL_AUXT_REVSTD: sndAuxCallbackUpdateSettingsReverbSTD(&a->u.std); break;
+  case SAL_AUXT_CHORUS: sndAuxCallbackUpdateSettingsChorus(&a->u.ch); break;
