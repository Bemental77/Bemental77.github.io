+static int sameAdpcm(u32 v, const SalRecAdpcm *a) {
+  const DSPADPCMplusInfo *d = rVoices[v].smp_info.extraData;
+  if (!a->has) return d == NULL;
+  return d && d->initialPS == a->initialPS && d->loopPS == a->loopPS && d->loopY0 == a->loopY0 && d->loopY1 == a->loopY1 &&
+         !memcmp(d->coefTab, a->coefTab, sizeof d->coefTab);
+}
+static int sameVoice(const SalSnapVoice *o) {
+  const DSPvoice *vp = &rVoices[o->voice];
+  const VoiceResamplerState *rs = &voiceResampler[o->voice];
+  if (vp->state != DSP_VOICE_STATE_PLAYING || o->state != DSP_VOICE_STATE_PLAYING || vp->studio != (u8)o->studio) return 0;
+  return sameSample(vp, &o->smp) && sameAdpcm(o->voice, &o->adpcm) && rs->reader.position == o->reader.position &&
+         rs->reader.predictorScale == o->reader.predictorScale && rs->reader.useInitialPS == (bool)o->reader.useInitialPS &&
+         rs->reader.ended == (bool)o->reader.ended && rs->phase == o->phase && rs->historyIndex == o->historyIndex &&
+         rs->tail == (u8)o->tail && rs->itdDelay[0] == o->itd0 && rs->itdDelay[1] == o->itd1;
+}
+static void setVoice(const SalSnapVoice *o) {
+  DSPvoice *vp = &rVoices[o->voice];
+  VoiceResamplerState *rs = &voiceResampler[o->voice];
+  memset(vp, 0, sizeof *vp);
+  memset(rs, 0, sizeof *rs);
+  memset(lastContribution[o->voice], 0, sizeof(lastContribution[o->voice]));
+#if MUSY_VERSION >= MUSY_VERSION_CHECK(2, 0, 1)
+  filterState[o->voice] = 0;
+#endif
+  vp->state = (u8)o->state; vp->studio = (u8)o->studio;
+  setSample(vp, &o->smp);
+  setAdpcm(o->voice, &o->adpcm);
+  setReader(&rs->reader, &o->reader);
+  rs->reader.yn1 = rs->reader.yn2 = 0;
+  rs->phase = o->phase; rs->historyIndex = o->historyIndex; rs->tail = (u8)o->tail;
+  rs->itdDelay[0] = o->itd0; rs->itdDelay[1] = o->itd1;
+}
+static void retireVoice(u32 v) {   /* this side's voice ends: its last output decays through depop, as a stop does */
+  DSPvoice *vp = &rVoices[v];
+  if (vp->state == DSP_VOICE_STATE_INACTIVE) return;
+  const u32 saved = renderOffset;
+  renderOffset = 0;
+  retireContribution(vp);
+  renderOffset = saved;
+  vp->state = DSP_VOICE_STATE_INACTIVE;
