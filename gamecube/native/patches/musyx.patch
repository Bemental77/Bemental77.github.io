diff --git a/src/musyx/runtime/hw_pc.c b/src/musyx/runtime/hw_pc.c
index 65abcc5..529938f 100644
--- a/src/musyx/runtime/hw_pc.c
+++ b/src/musyx/runtime/hw_pc.c
@@ -134,6 +134,29 @@ static s32 mixRampChannel(s32 *dest, const s32 *src, int nSamples, s16 startVol,
   if (!dest || (!startVol && !endVol))
     return 0;
   s32 contribution = 0;
+#ifdef __EMSCRIPTEN__
+  // web port: the same values without two integer divisions per sample. env = envStart + trunc(dE*i/n)
+  // and vol = startVol + trunc(dV*(frameOffset+i)/cycleFrames) are stepped as quotient + remainder
+  // (k >= 0, so trunc(d*k/n) = sign(d) * floor(|d|*k/n)); 3M random cases (all lengths, offsets, cycle
+  // sizes, full s16/u16 ranges and the edge pairs) give results identical to the division form
+  {
+    const s32 dE = (s32)envEnd - envStart, nE = nSamples;
+    const s32 dV = (s32)endVol - startVol, nV = (s32)cycleFrames;
+    const u32 aE = dE < 0 ? (u32)-dE : (u32)dE, aV = dV < 0 ? (u32)-dV : (u32)dV;
+    u32 qE = 0, rE = 0, qV = (u32)(((u64)aV * (u32)frameOffset) / (u32)nV), rV = (u32)(((u64)aV * (u32)frameOffset) % (u32)nV);
+    const u32 qsE = aE / (u32)nE, rsE = aE % (u32)nE, qsV = aV / (u32)nV, rsV = aV % (u32)nV;
+    for (int i = 0; i < nSamples; ++i) {
+      s32 env = envStart + (dE < 0 ? -(s32)qE : (s32)qE);
+      s32 vol = startVol + (dV < 0 ? -(s32)qV : (s32)qV);
+      s32 mixVol = (vol * env) >> 15;
+      contribution = (src[i] * mixVol) >> 15;
+      dest[i] += contribution;
+      qE += qsE; rE += rsE; if (rE >= (u32)nE) { rE -= (u32)nE; ++qE; }
+      qV += qsV; rV += rsV; if (rV >= (u32)nV) { rV -= (u32)nV; ++qV; }
+    }
+    return contribution;
+  }
+#endif
   for (int i = 0; i < nSamples; ++i) {
     s32 env = envStart + ((s32)envEnd - envStart) * i / nSamples;
     s32 vol = startVol + ((s32)endVol - startVol) * (frameOffset + i) / (s32)cycleFrames;
