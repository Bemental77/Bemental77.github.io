diff --git a/src/musyx/runtime/hw_pc_split.h b/src/musyx/runtime/hw_pc_split.h
new file mode 100644
index 0000000..976382e
--- /dev/null
+++ b/src/musyx/runtime/hw_pc_split.h
@@ -0,0 +1,137 @@
+/* hw_pc_split.h — the web port's split of the native DSP (hw_pc.c) into CONTROL and RENDER.
+ *
+ * CONTROL (the game's module, every console, every frame — re-simulation included): everything the
+ * game can observe. Voice state machines, ADSR, pitch and volume parameters, sample cursors (position,
+ * loop, end, tail), virtual-sample buffer switches, the messages to the synthesizer. It writes a log
+ * of what the sample-level work would do and never does it.
+ * RENDER (a separate wasm module, normally inside the AudioWorklet): ADPCM/PCM decoding, the resampler
+ * taps, filter, ITD, every mix ramp, studio inputs, AUX effects, depop tails, the output fold. It
+ * replays the log with the same code (hw_pc.c compiled with SAL_PC_RENDER) and produces the PCM.
+ *
+ * The log is a sequence of records: u16 type, u16 payload bytes, payload (padded to 4). Every field
+ * the render side reads comes from the control side's state at the moment the original single-module
+ * code read it, so the two-module result is the single-module result.
+ */
+#ifndef MUSYX_HW_PC_SPLIT_H
+#define MUSYX_HW_PC_SPLIT_H
+
+#include "musyx/musyx.h"
+
+/* the web port's game module is CONTROL only; SAL_PC_NOSPLIT builds the single-module renderer (the
+ * reference the split is compared against) */
+#if defined(__EMSCRIPTEN__) && !defined(SAL_PC_RENDER) && !defined(SAL_PC_NOSPLIT)
+#define SAL_PC_SPLIT 1
+#endif
+
+enum {
+  SALR_FRAME = 1,       /* u32 serial, u32 nVoices, voice snapshots..., u32 nStudios, studio snapshots..., u32 nAux, aux entries... */
+  SALR_CYCLE = 2,       /* SalRecCycle */
+  SALR_STUDIO_BEGIN = 3,/* u32 studio */
+  SALR_VSTART = 4,      /* SalRecVStart */
+  SALR_VCYCLE = 5,      /* SalRecVCycle */
+  SALR_SEG = 6,         /* SalRecSeg */
+  SALR_DATA = 7,        /* u32 addr, u32 len, bytes */
+  SALR_RETIRE = 8,      /* u32 voice, u32 studio, u32 renderOffset */
+  SALR_VEND = 9,        /* u32 voice, u32 itd0, u32 itd1 */
+  SALR_STUDIO_END = 10, /* SalRecStudioEnd */
+  SALR_CYCLE_END = 11,  /* (none) */
+  SALR_STUDIO_ACTIVATE = 12, /* u32 studio, u32 isMaster, u32 type */
+  SALR_AUX_PREPARE = 13,/* u32 type, u32 key, struct bytes */
+  SALR_AUX_UPDATE = 14, /* u32 type, u32 key, struct bytes */
+  SALR_AUX_SHUTDOWN = 15,/* u32 type, u32 key */
+  SALR_INIT = 16,       /* (none): salInitAi */
+  SALR_SEG2 = 18,       /* u8 voice, u8 subframe, u8 buffers, u8 hasPitch, u16 adsrStart, u16 adsrEnd, [u32 pitch]:
+                         * a segment at segmentOffset[subframe]; the pitch only when it changed (else the voice's last) */
+  SALR_ADPCM = 17,      /* u32 voice, SalRecAdpcm: the voice's ADPCM info changed since it was last sent */
+};
+
+enum { SAL_AUXT_NONE = 0, SAL_AUXT_REVHI = 1, SAL_AUXT_REVSTD = 2, SAL_AUXT_CHORUS = 3, SAL_AUXT_DELAY = 4, SAL_AUXT_UNKNOWN = 15 };
+
+typedef struct SalRecCycle {
+  u32 cycleFrames;
+  u32 segmentOffset[6];
+  u32 cycleTickLo, cycleTickHi;
+  u32 salFrame, salAuxFrame;
+  u32 rate, channels;
+} SalRecCycle;
+
+/* the cursor the control side keeps (it is also what a resync restores) */
+typedef struct SalRecReader {
+  u32 position;
+  s16 yn1, yn2;          /* the decoder history: control keeps it only from salPCInitReader (a start) */
+  u8 predictorScale, useInitialPS, ended, pad;
+} SalRecReader;
+
+typedef struct SalRecSample {
+  u32 addr, length, loop, loopLength, compType;
+  u32 vAddr, vLength, vInLoop;   /* vSampleInfo.loopBufferAddr/Length/inLoopBuffer */
+  u32 streamLoopPS;
+} SalRecSample;
+
+typedef struct SalRecAdpcm {
+  u32 has;               /* smp_info.extraData != NULL */
+  u8 initialPS, loopPS, pad0, pad1;
+  s16 loopY0, loopY1;
+  s16 coefTab[8][2];
+} SalRecAdpcm;
+
+typedef struct SalRecVStart {
+  u32 voice;
+  SalRecReader reader;
+  u32 itd0, itd1;
+  SalRecAdpcm adpcm;
+} SalRecVStart;
+
+typedef struct SalRecVCycle {
+  u32 voice, studio;
+  SalRecSample smp;
+  u16 vol[9], lastVol[9];       /* L R S La Ra Sa Lb Rb Sb */
+  u16 volRear[2], lastVolRear[2];
+  u32 srcTypeSelect, srcCoefSelect;
+  u32 filterOn;
+  s16 coefA, coefB;
+  u32 flags, itdShiftL, itdShiftR;
+} SalRecVCycle;
+
+typedef struct SalRecSeg {
+  u32 voice;
+  u32 subframe;       /* renderOffset = segmentOffset[subframe] */
+  u32 frameOffset, frameSamples;
+  u32 pitch;
+  u32 adsrStart, adsrEnd;
+  u32 buffers;        /* bit0 main, bit1 auxA, bit2 auxB present (the studio's current-frame buffers) */
+} SalRecSeg;
+
+typedef struct SalRecStudioEnd {
+  u32 studio;
+  u32 isMaster, type, numInputs;
+  struct { u32 studio; s32 vol, volA, volB; } in[7];
+  u32 auxType[2], auxKey[2];
+} SalRecStudioEnd;
+
+/* resync snapshots (SALR_FRAME) */
+typedef struct SalSnapVoice {
+  u32 voice, studio, state;
+  SalRecReader reader;
+  u32 phase, historyIndex, tail, itd0, itd1;
+  SalRecSample smp;
+  SalRecAdpcm adpcm;
+} SalSnapVoice;
+typedef struct SalSnapStudio { u32 studio, active, isMaster, type; } SalSnapStudio;
+
+#define SAL_AUX_STRUCT_MAX 512
+typedef struct SalSnapAux { u32 type, key, bytes; u8 data[SAL_AUX_STRUCT_MAX]; } SalSnapAux;
