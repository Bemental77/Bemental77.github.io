+/* the source bytes a segment read: contiguous position runs, each sent as the bytes that hold them */
+static struct { u32 addr, comp, first, last; int open; } readRun;
+static void flushRun(void) {
+  if (!readRun.open) return;
+  readRun.open = 0;
+  u32 b0, b1;
+  switch (readRun.comp) {
+  case SAMPLE_TYPE_ADPCM: case SAMPLE_TYPE_ADPCM_PLUS: case SAMPLE_TYPE_ADPCM_STREAM: case SAMPLE_TYPE_ADPCM_VIRTUAL:
+    b0 = (readRun.first / SND_STREAM_ADPCM_BLKSIZE) * SND_STREAM_ADPCM_BLKBYTES;
+    b1 = (readRun.last / SND_STREAM_ADPCM_BLKSIZE + 1) * SND_STREAM_ADPCM_BLKBYTES;
+    break;
+  case SAMPLE_TYPE_PCM16: b0 = readRun.first * 2; b1 = (readRun.last + 1) * 2; break;
+  case SAMPLE_TYPE_PCM8: b0 = readRun.first; b1 = readRun.last + 1; break;
+  default: return;
+  }
+  const u32 len = b1 - b0;
+  u32 *r = logPut(SALR_DATA, 8 + len);
+  if (!r) return;
+  r[0] = readRun.addr + b0; r[1] = len;
+  memcpy(r + 2, (const void *)(uintptr_t)(readRun.addr + b0), len);
+}
+static void noteRead(const SAMPLE_INFO *smp, u32 position) {
+  const u32 addr = (u32)(uintptr_t)smp->addr;
+  if (readRun.open && readRun.addr == addr && readRun.comp == smp->compType && position == readRun.last + 1) {
+    readRun.last = position;
+    if (readRun.last - readRun.first >= 4096) flushRun();   /* bound a record */
+    return;
+  }
+  flushRun();
+  readRun.addr = addr; readRun.comp = smp->compType; readRun.first = readRun.last = position; readRun.open = 1;
+}
+
+/* resampleVoice's cursor half: every phase step and source read, no sample values */
+static int controlResample(DSPvoice *voice, u32 voiceIdx, int numSamples, u32 pitch) {
+  VoiceResamplerState *state = &voiceResampler[voiceIdx];
+  const u32 mode = voice->srcTypeSelect;
+  if (mode == SAL_SRC_NONE)
+    pitch = 65536;
+  for (int i = 0; i < numSamples; ++i) {
+    state->phase += pitch;
+    while (state->phase >= 65536) {
+      SAMPLE_INFO *source = &voice->smp_info;
+      if (source->compType == SAMPLE_TYPE_ADPCM_VIRTUAL && !voice->vSampleInfo.inLoopBuffer &&
+          source->loopLength && state->reader.position >= source->loop + source->loopLength) {
+        source->addr = voice->vSampleInfo.loopBufferAddr;
+        source->length = source->loopLength = voice->vSampleInfo.loopBufferLength;
+        source->loop = 0;
+        voice->vSampleInfo.inLoopBuffer = 1;
+        state->reader.position = 0;
+        state->reader.predictorScale = voice->streamLoopPS;
+        state->reader.useInitialPS = true;
+      }
+      const u32 pos = salPCStepSample(&state->reader, &voice->smp_info, voice->streamLoopPS);
+      if (pos != UINT32_MAX) noteRead(&voice->smp_info, pos);
+      state->historyIndex++;
+      if (state->reader.ended && state->tail < POLYPHASE_TAPS)
+        ++state->tail;
+      state->phase -= 65536;
+    }
+  }
+  flushRun();
+  voice->playInfo.posHi = state->reader.position;
+  voice->playInfo.posLo = state->phase;
+  return numSamples;
+}
+
+/* DELTA: a voice's VCYCLE goes out on its first segment of each guest frame (so a render side that reconciled at
+ * the frame's start has it) and after that only when a field changed; SEG2 carries the pitch only when it changed.
+ * The render side keeps the values and applies the same end-of-cycle step (lastVol = vol) the control side does. */
+static SalRecVCycle sentVCycle[SYNTH_MAX_VOICES];
+static u8 sentVCycleThisFrame[SYNTH_MAX_VOICES];
+static u32 sentPitch[SYNTH_MAX_VOICES];
+static u8 sentPitchThisFrame[SYNTH_MAX_VOICES];
+static void fillVCycle(SalRecVCycle *r, DSPvoice *vp, u32 voiceIdx);
+static void logVCycle(DSPvoice *vp, u32 voiceIdx) {
+  SalRecVCycle now;
+  memset(&now, 0, sizeof now);
+  fillVCycle(&now, vp, voiceIdx);
+  if (sentVCycleThisFrame[voiceIdx] && !memcmp(&now, &sentVCycle[voiceIdx], sizeof now)) return;
+  SalRecVCycle *r = logPut(SALR_VCYCLE, sizeof(SalRecVCycle));
+  if (!r) return;
+  *r = now;
+  sentVCycle[voiceIdx] = now;
+  sentVCycleThisFrame[voiceIdx] = 1;
+}
+static void fillVCycle(SalRecVCycle *r, DSPvoice *vp, u32 voiceIdx) {
+  r->voice = voiceIdx; r->studio = vp->studio;
+  logSample(&r->smp, vp);
+  const u16 v[9] = {vp->volL, vp->volR, vp->volS, vp->volLa, vp->volRa, vp->volSa, vp->volLb, vp->volRb, vp->volSb};
+  const u16 l[9] = {vp->lastVolL, vp->lastVolR, vp->lastVolS, vp->lastVolLa, vp->lastVolRa, vp->lastVolSa, vp->lastVolLb, vp->lastVolRb, vp->lastVolSb};
+  memcpy(r->vol, v, sizeof v); memcpy(r->lastVol, l, sizeof l);
+  r->volRear[0] = vp->volRear[0]; r->volRear[1] = vp->volRear[1];
+  r->lastVolRear[0] = vp->lastVolRear[0]; r->lastVolRear[1] = vp->lastVolRear[1];
+  r->srcTypeSelect = vp->srcTypeSelect; r->srcCoefSelect = vp->srcCoefSelect;
+#if MUSY_VERSION >= MUSY_VERSION_CHECK(2, 0, 1)
+  r->filterOn = vp->filter.on; r->coefA = vp->filter.coefA; r->coefB = vp->filter.coefB;
+#else
+  r->filterOn = 0; r->coefA = r->coefB = 0;
+#endif
+  r->flags = vp->flags; r->itdShiftL = vp->itdShiftL; r->itdShiftR = vp->itdShiftR;
+}
+
+/* renderVoiceSegment's control half: the same early outs, the cursor, the "done" answer; and a SEG
+ * record so the render module mixes exactly this segment */
+static int controlVoiceSegment(DSPvoice *vp, u32 buffers, u32 voiceIdx, int frameOffset, int frameSamples,
+                               u32 subframe, u16 adsrStart, u16 adsrEnd, int *vcycleSent) {
+  if (vp->state == DSP_VOICE_STATE_INACTIVE)
+    return 0;
+  const SAMPLE_INFO *smp = &vp->smp_info;
+  if (smp->addr == NULL)
+    return 0;
+  u32 pitch = vp->playInfo.pitch;
+  if (pitch == 0)
+    pitch = vp->pitch[0];
+  if (pitch == 0 && vp->srcTypeSelect != SAL_SRC_NONE)
+    return 0;
+  if (!*vcycleSent) { logAdpcmIfChanged(vp, voiceIdx); logVCycle(vp, voiceIdx); *vcycleSent = 1; }
+  /* the bytes this segment reads (DATA) go first, so the render side has them when it runs the SEG */
+  VoiceResamplerState *state = &voiceResampler[voiceIdx];
+  controlResample(vp, voiceIdx, frameSamples, pitch);
+  (void)frameOffset;   /* the render side has segmentOffset (CYCLE) */
+  const int withPitch = !sentPitchThisFrame[voiceIdx] || sentPitch[voiceIdx] != pitch;
+  u8 *r = logPut(SALR_SEG2, withPitch ? 12 : 8);
+  if (r) {
+    r[0] = (u8)voiceIdx; r[1] = (u8)subframe; r[2] = (u8)buffers; r[3] = (u8)withPitch;
+    ((u16 *)r)[2] = adsrStart; ((u16 *)r)[3] = adsrEnd;
+    if (withPitch) { memcpy(r + 8, &pitch, 4); sentPitch[voiceIdx] = pitch; sentPitchThisFrame[voiceIdx] = 1; }
+  }
+  const u32 tail = vp->srcTypeSelect == SAL_SRC_NONE ? 1 : vp->srcTypeSelect == SAL_SRC_LINEAR ? 2 : POLYPHASE_TAPS;
+  return state->tail >= tail;
+}
+
+static void logAux(u32 rec, u32 type, const void *aux, u32 bytes);
+/* the AUX effects the game prepares are mirrored (their params, by struct address) for a resync */
+static SalSnapAux auxRegistry[8];
+static u32 auxType(SND_AUX_CALLBACK cb) {
+  if (cb == NULL) return SAL_AUXT_NONE;
+  if (cb == sndAuxCallbackReverbHI) return SAL_AUXT_REVHI;
+  if (cb == sndAuxCallbackReverbSTD) return SAL_AUXT_REVSTD;
+  if (cb == sndAuxCallbackChorus) return SAL_AUXT_CHORUS;
+  if (cb == sndAuxCallbackDelay) return SAL_AUXT_DELAY;
+  return SAL_AUXT_UNKNOWN;
+}
+static void registryPut(u32 type, const void *aux, u32 bytes) {
+  SalSnapAux *free = NULL;
+  for (u32 i = 0; i < 8; ++i) {
+    if (auxRegistry[i].key == (u32)(uintptr_t)aux) { free = &auxRegistry[i]; break; }
+    if (!free && auxRegistry[i].key == 0) free = &auxRegistry[i];
+  }
+  if (!free) return;
+  free->type = type; free->key = (u32)(uintptr_t)aux; free->bytes = bytes > SAL_AUX_STRUCT_MAX ? SAL_AUX_STRUCT_MAX : bytes;
+  memcpy(free->data, aux, free->bytes);
+}
+static void logAux(u32 rec, u32 type, const void *aux, u32 bytes) {
+  if (bytes > SAL_AUX_STRUCT_MAX) bytes = SAL_AUX_STRUCT_MAX;
+  u32 *r = logPut(rec, 8 + (rec == SALR_AUX_SHUTDOWN ? 0 : bytes));
+  if (!r) return;
+  r[0] = type; r[1] = (u32)(uintptr_t)aux;
+  if (rec != SALR_AUX_SHUTDOWN) memcpy(r + 2, aux, bytes);
+}
+void salPCLogAuxPrepare(u32 type, const void *aux, u32 bytes) { registryPut(type, aux, bytes); logAux(SALR_AUX_PREPARE, type, aux, bytes); }
+void salPCLogAuxUpdate(u32 type, const void *aux, u32 bytes) { registryPut(type, aux, bytes); logAux(SALR_AUX_UPDATE, type, aux, bytes); }
+void salPCLogAuxShutdown(u32 type, const void *aux) {
+  for (u32 i = 0; i < 8; ++i) if (auxRegistry[i].key == (u32)(uintptr_t)aux) memset(&auxRegistry[i], 0, sizeof(auxRegistry[i]));
+  logAux(SALR_AUX_SHUTDOWN, type, aux, 0);
+}
+
+/* the start of a guest frame: a header and everything a render module needs to pick up from here
+ * (it uses it only if it missed frames: a muted re-simulation, a hidden catch-up, an overflow) */
+void salPCLogFrame(u32 serial) {
+  salPCLogLen = 0;
+  salPCLogOverflow = 0;
+  memset(sentVCycleThisFrame, 0, sizeof(sentVCycleThisFrame));
+  memset(sentPitchThisFrame, 0, sizeof(sentPitchThisFrame));
+  u32 nv = 0;
+  for (u32 v = 0; v < salNumVoices; ++v) if (dspVoice && dspVoice[v].state != DSP_VOICE_STATE_INACTIVE) ++nv;
+  u32 na = 0;
+  for (u32 i = 0; i < 8; ++i) if (auxRegistry[i].key) ++na;
+  const u32 bytes = 8 + nv * sizeof(SalSnapVoice) + 4 + salMaxStudioNum * sizeof(SalSnapStudio) + 4 + na * sizeof(SalSnapAux);
+  u8 *p = logPut(SALR_FRAME, bytes);
+  if (!p) return;
+  ((u32 *)p)[0] = serial; ((u32 *)p)[1] = nv; p += 8;
+  for (u32 v = 0; v < salNumVoices; ++v) {
+    DSPvoice *vp = &dspVoice[v];
+    if (vp->state == DSP_VOICE_STATE_INACTIVE) continue;
+    SalSnapVoice *o = (SalSnapVoice *)p; p += sizeof *o;
+    const VoiceResamplerState *st = &voiceResampler[v];
+    o->voice = v; o->studio = vp->studio; o->state = vp->state;
+    logReader(&o->reader, &st->reader);
+    o->phase = st->phase; o->historyIndex = st->historyIndex; o->tail = st->tail;
+    o->itd0 = itdTarget(vp, 0); o->itd1 = itdTarget(vp, 1);
+    logSample(&o->smp, vp);
+    fillAdpcm(&o->adpcm, vp);
+  }
+  *(u32 *)p = salMaxStudioNum; p += 4;
+  for (u32 s2 = 0; s2 < salMaxStudioNum; ++s2) {
+    SalSnapStudio *o = (SalSnapStudio *)p; p += sizeof *o;
+    o->studio = s2; o->active = dspStudio[s2].state == DSP_STUDIO_STATE_ACTIVE; o->isMaster = dspStudio[s2].isMaster; o->type = dspStudio[s2].type;
+  }
+  *(u32 *)p = na; p += 4;
+  for (u32 i = 0; i < 8; ++i) if (auxRegistry[i].key) { memcpy(p, &auxRegistry[i], sizeof(SalSnapAux)); p += sizeof(SalSnapAux); }
+}
