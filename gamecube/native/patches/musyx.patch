+void salPCLogFrame(u32 serial);              /* the start of a guest frame: header + resync snapshot */
+void salPCLogAuxPrepare(u32 type, const void *aux, u32 bytes);
+void salPCLogAuxUpdate(u32 type, const void *aux, u32 bytes);
+void salPCLogAuxShutdown(u32 type, const void *aux);
