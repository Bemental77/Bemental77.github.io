+          vp->lastVolL = vp->volL;
+          vp->lastVolR = vp->volR;
+          vp->lastVolS = vp->volS;
+          vp->lastVolLa = vp->volLa;
+          vp->lastVolRa = vp->volRa;
+          vp->lastVolSa = vp->volSa;
+          vp->lastVolLb = vp->volLb;
+          vp->lastVolRb = vp->volRb;
+          vp->lastVolSb = vp->volSb;
+          vp->lastVolRear[0] = vp->volRear[0];
