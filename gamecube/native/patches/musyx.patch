+  // state, the pre-delay cursor and the coefficients live in locals for the 160 samples and are written
+  // back once. In the rollback build every store to the work struct is a write-barrier check; this
+  // loop did ~40 of them per sample (measured: reverb ~4% of the toaster renderer's busy time).
+  _SND_REVHI_DELAYLINE c0 = work->C[k * 3], c1 = work->C[k * 3 + 1], c2 = work->C[k * 3 + 2];
+  _SND_REVHI_DELAYLINE a0 = work->AP[k * 3], a1 = work->AP[k * 3 + 1], a2 = work->AP[k * 3 + 2];
+  _SND_REVHI_DELAYLINE *comb0 = &c0, *comb1 = &c1, *comb2 = &c2;
+  _SND_REVHI_DELAYLINE *allpass0 = &a0, *allpass1 = &a1, *allpass2 = &a2;
+  const f32 cc0 = work->combCoef[k * 3], cc1 = work->combCoef[k * 3 + 1], cc2 = work->combCoef[k * 3 + 2];
+  const f32 apc = work->allPassCoeff, damping = work->damping;
+  f32 lpLast = work->lpLastout[k];
+  const s32 preTime = work->preDelayTime;
+  f32 *prePtr = work->preDelayPtr[k];
+  f32 *const preLine = work->preDelayLine[k];
+  s32 i;
+
+  for (i = 0; i < 160; ++i) {
+    f32 sample = (f32)sptr[i];
+    f32 delayed = sample;
+    f32 comb0Last, comb1Last, comb2Last, allpass0Last, allpass1Last, allpass2Last;
+    f32 combSum, allpass0Input, allpass1Input, allpass2Input, lowPass, allPass;
+    if (preTime != 0) {
+      delayed = *prePtr;
+      *prePtr = sample;
+      ++prePtr;
+      if (prePtr >= preLine + preTime) {
+        prePtr = preLine;
+      }
+    }
+    DLwriteSample(comb0, cc0 * comb0->lastOutput + delayed);
+    DLwriteSample(comb1, cc1 * comb1->lastOutput + delayed);
+    DLwriteSample(comb2, cc2 * comb2->lastOutput + delayed);
+    comb0Last = DLreadSample(comb0);
+    comb1Last = DLreadSample(comb1);
+    comb2Last = DLreadSample(comb2);
+    combSum = comb0Last + comb1Last + comb2Last;
+    allpass0Last = allpass0->lastOutput;
+    allpass0Input = apc * allpass0Last + combSum;
+    DLwriteSample(allpass0, allpass0Input);
+    lowPass = allpass0Last - apc * allpass0Input;
+    DLreadSample(allpass0);
+    allpass1Last = allpass1->lastOutput;
+    allpass1Input = apc * allpass1Last + lowPass;
+    DLwriteSample(allpass1, allpass1Input);
+    lowPass = allpass1Last - apc * allpass1Input;
+    DLreadSample(allpass1);
+    lowPass *= 0.3f;
+    lpLast = damping * lpLast + lowPass;
+    allpass2Last = allpass2->lastOutput;
+    allpass2Input = apc * allpass2Last + lpLast;
+    DLwriteSample(allpass2, allpass2Input);
+    allPass = allpass2Last - apc * allpass2Input;
+    DLreadSample(allpass2);
+    sptr[i] = (s32)(dampDry * sample + dampWet * allPass);
+  }
+  work->C[k * 3] = c0; work->C[k * 3 + 1] = c1; work->C[k * 3 + 2] = c2;
+  work->AP[k * 3] = a0; work->AP[k * 3 + 1] = a1; work->AP[k * 3 + 2] = a2;
+  work->lpLastout[k] = lpLast;
+  if (preTime != 0) {
+    work->preDelayPtr[k] = prePtr;
+  }
+#else
   _SND_REVHI_DELAYLINE *comb0 = &work->C[k * 3];
   _SND_REVHI_DELAYLINE *comb1 = &work->C[k * 3 + 1];
   _SND_REVHI_DELAYLINE *comb2 = &work->C[k * 3 + 2];
@@ -702,6 +765,7 @@ static void HandleReverb(s32 *sptr, SND_AUX_REVERBHI *rv, s32 k) {
 
     sptr[i] = (s32)(dampDry * sample + dampWet * allPass);
   }
+#endif
 }
 #endif
 
