+/* ============================ RENDER (its own module: the AudioWorklet) ============================
+ * Replays the control side's log (hw_pc_split.h) with the functions above, so every sample is the
+ * single-module renderer's. The sample memory it decodes is a mirror of the bytes the control side
+ * consumed, kept at the game module's addresses. */
+DSPstudioinfo dspStudio[8];
