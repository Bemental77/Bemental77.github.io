+/* a resync: rebuild every voice cursor, studio and effect from the frame's snapshot. The decoder
+ * history (yn1/yn2, the resampler taps) starts from zero: the control side does not keep it. */
+/* A serial gap: frames the render side never saw (a rollback's re-simulation, an overflow, the page
+ * starting late). The first time it builds everything from the snapshot. After that it RECONCILES: a
+ * voice, studio or effect whose control state matches what this side already has keeps everything it
+ * has (decoder history, resampler taps, reverb tails, depop), so a rollback that did not change the
+ * audio continues seamlessly. Only what differs is rebuilt: a changed voice retires its tail and
+ * restarts its decoder from the snapshot cursor (history from zero), a changed effect is prepared
+ * again from its parameters. */
+static int sameSample(const DSPvoice *vp, const SalRecSample *o) {
+  return (u32)(uintptr_t)vp->smp_info.addr == o->addr && vp->smp_info.length == o->length && vp->smp_info.loop == o->loop &&
+         vp->smp_info.loopLength == o->loopLength && vp->smp_info.compType == (u8)o->compType &&
+         (u32)(uintptr_t)vp->vSampleInfo.loopBufferAddr == o->vAddr && vp->vSampleInfo.loopBufferLength == o->vLength &&
+         vp->vSampleInfo.inLoopBuffer == (u8)o->vInLoop && vp->streamLoopPS == (u8)o->streamLoopPS;
