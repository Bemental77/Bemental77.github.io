+void *salMalloc(size_t len) { return malloc(len); }
+void salFree(void *addr) { free(addr); }
+
+/* the mirror: 64 KiB pages over the game module's 4 GiB address space, each with a 16-byte tail that
+ * repeats the next page's head, so a read of up to 16 bytes never crosses a page */
+#define MIRROR_PAGE_BITS 16
+#define MIRROR_PAGE (1u << MIRROR_PAGE_BITS)
+#define MIRROR_GUARD 16
+static u8 *mirrorPages[1u << (32 - MIRROR_PAGE_BITS)];
+static u8 mirrorZero[MIRROR_PAGE + MIRROR_GUARD];
+static u8 *mirrorPage(u32 page) {
+  if (!mirrorPages[page]) {
+    mirrorPages[page] = calloc(1, MIRROR_PAGE + MIRROR_GUARD);
+    if (!mirrorPages[page]) return NULL;
+  }
+  return mirrorPages[page];
+}
+static void mirrorWrite(u32 addr, const u8 *src, u32 len) {
+  while (len) {
+    const u32 page = addr >> MIRROR_PAGE_BITS, off = addr & (MIRROR_PAGE - 1);
+    u32 n = MIRROR_PAGE - off;
+    if (n > len) n = len;
+    u8 *p = mirrorPage(page);
+    if (p) memcpy(p + off, src, n);
+    if (off < MIRROR_GUARD && page) {   /* the previous page's tail */
+      u8 *q = mirrorPage(page - 1);
+      const u32 g = (MIRROR_GUARD - off) < n ? (MIRROR_GUARD - off) : n;
+      if (q) memcpy(q + MIRROR_PAGE + off, src, g);
+    }
+    addr += n; src += n; len -= n;
+  }
+}
+const u8 *salPCMem(uintptr_t addr) {
+  const u32 a = (u32)addr;
+  const u8 *p = mirrorPages[a >> MIRROR_PAGE_BITS];
+  return (p ? p : mirrorZero) + (a & (MIRROR_PAGE - 1));
+}
