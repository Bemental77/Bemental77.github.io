+  case SAL_AUXT_REVSTD: a->live = sndAuxCallbackPrepareReverbSTD(&a->u.std); break;
+  case SAL_AUXT_CHORUS: a->live = sndAuxCallbackPrepareChorus(&a->u.ch); break;
