+// voices to stop must advance it itself: one 5 ms cycle per iteration, the same 500 ms budget.
+extern void mp4web_audio_pump_cycle(void);
+#define SNDGRP_WAIT(tickStart) \
+    for (s32 sndgrpWaitCycles = 0; (msmMusGetNumPlay(TRUE) != 0 || msmSeGetNumPlay(TRUE) != 0) && sndgrpWaitCycles < SNDGRP_TIMEOUT / 5; ++sndgrpWaitCycles) mp4web_audio_pump_cycle()
