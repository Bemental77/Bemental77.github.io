 namespace aurora::card {
 
+#ifdef __EMSCRIPTEN__
+// web: THE ROOM CARD LIVES IN GAME MEMORY. A card is game state (a save, the boxes the menus probe), so
+// in a room / determinism run (?nosave=1) the raw card image is an array in the game's rollback-covered
+// range (gamecube/native/src/card_arena.c), not a file: a rewind then puts the card back with everything
+// else. A FileIO whose path is MemCardPath reads and writes that image (the store barrier logs it).
+inline constexpr const char* MemCardPath = "/mp4web-memcard";   // short: std::string keeps it inline (no heap pointer in the image)
+struct MemCardImage {
+  uint8_t* data = nullptr;     // image bytes, `cap` long
+  size_t cap = 0;
+  uint32_t* len = nullptr;     // bytes written so far ("file size"); 0 = no card file yet. len[1]: data-area write count
+};
+extern MemCardImage g_memCard;
+bool isMemCard(const std::string& path);
+#endif
+// the card path's existence/size, for the in-memory card as for a file
+bool cardPathExists(const std::filesystem::path& path);
+size_t cardPathSize(const std::filesystem::path& path);
+
 class FileIO {
   std::string m_path;
   bool m_ready = false;
