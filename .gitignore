# GameCube — dolphin source tree. Source/, CMake/, Tools/, Installer/ are tracked
# (~30 MB of canonical libretro/dolphin@0cd3bb8 + our minimum-JIT-swap edits).
# Externals/ submodules + Data/Languages/ assets + build dirs are NOT tracked —
# regenerate via `git submodule update --init --recursive` inside gamecube/dolphin-src
# (after re-cloning the inner git history if needed for Externals).
gamecube/dolphin-src/Externals/
gamecube/dolphin-src/Data/
gamecube/dolphin-src/Languages/
gamecube/dolphin-src/docs/
gamecube/dolphin-src/build-wasm/
gamecube/dolphin-src/build-native-dbg/
gamecube/dolphin-src/build/
gamecube/dolphin-src/cmake-build-debug/
gamecube/dolphin-src/cmake-build-release/
gamecube/dolphin-src/Source/Core/Common/scmrev.h

# bementalCompiler local build artifacts (the JIT lib is statically linked
# into Dolphin via dolphin-src; only sources are deployed)
bementalCompiler/build/

# bementalJIT local build artifacts (host/test/emcc CMake out-of-tree builds)
bementalJIT/build-*/
# GameCube-owned bementalJIT copy (de-shared from root) — same build-dir pattern
gamecube/bementalJIT/build-*/

tools/bin/

# Dreamcast — local-only artifacts (mirror gamecube pattern)
# BIOS / Flash dumps (DC - BIOS.bin, DC - Flash.bin, etc.) — not redistributable
dreamcast/bios/
# Native oracle (redream binary + saves) — host-only, not deployed
dreamcast/oracle/
# Game images (.gdi/.cdi/.chd/.iso/.bin/.cue/.nrg)
dreamcast/roms/
# Flycast source tree (large internal build input — not deployed)
dreamcast/flycast-src/
# Flycast / sh4-worker local CMake build dirs (build-wasm/, build-host-test/, etc.)
dreamcast/**/build-*/

# Python bytecode
**/__pycache__/

# Old fork tree — preserved for MemArena port reference; remove after build Stage 0 passes (CC-1)
gamecube/dolphin-src.bak/
