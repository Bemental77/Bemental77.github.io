--- a/core/hw/aica/sgc_if.cpp
+++ b/core/hw/aica/sgc_if.cpp
@@ -715,8 +715,28 @@ struct ChannelEx
 
 	static void StepAll(SampleType& mixl, SampleType& mixr)
 	{
+		// [wasm port, 2026-08-29] Skip disabled channels BEFORE the per-channel
+		// mix tail. This is BIT-EXACT, not an accuracy trade:
+		//   Step(oLeft,oRight,oDsp) returns immediately for a disabled channel
+		//   (line ~647) with oLeft=oRight=oDsp=0 and mutates NO channel state,
+		//   so the tail in Step(mixl,mixr) degenerates to
+		//     *VolMix.DSPOut += 0;  oLeft=oRight=(0>>4);  mixl += 0;  mixr += 0;
+		//   i.e. every effect is the identity. Nothing the guest can read
+		//   changes -- including dsp::state.MIXS, which IS guest-visible
+		//   (aica_mem.cpp:63, DSP MIXS @ 0x4500); that is why this skips the
+		//   "+= 0" and does NOT touch the MIXS memset in AICA_Sample.
+		// Why it is worth a branch: this loop runs 64x per 44.1 kHz sample
+		// (AICA_TICK=4535 -> 44.1K AicaUpdate/s, aica.cpp:85) whether or not any
+		// voice is keyed on. In the wasm build AICA_Sample and ChannelEx::Step
+		// are both inlined into AicaUpdate (they are absent from
+		// flycast_worker_emcc.js.symbols; only the address-taken Step* member
+		// pointers survive), whose SELF time is 9.26% of the emu worker
+		// (/tmp/dcx-worker.cpuprofile, 2026-08-28, 25s heavy scene). Per
+		// channel the emitted loop body was ~63 wasm instructions plus the
+		// callee's early-out; this cuts the disabled case to a load + branch.
 		for (ChannelEx& channel : Chans)
-			channel.Step(mixl, mixr);
+			if (channel.enabled)
+				channel.Step(mixl, mixr);
 	}
 
 	void SetAegState(EGState newstate)
