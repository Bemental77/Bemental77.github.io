 // memory using a fallback (that is, regular mallocs and falling back to slow memory JIT).
 bool init(void **vmem_base_addr, void **sh4rcb_addr, size_t ramSize)
 {
+#if defined(__EMSCRIPTEN__)
+    // wasm has no PROT_NONE-mappable address space; mem_region_reserve below
+    // would fail with EINVAL anyway. Return false so Flycast uses its plain
+    // malloc fallback for SH4 RAM and we skip the virtmem fast path entirely.
+    return false;
+#endif
 	// Firt let's try to allocate the shm-backed memory
 	vmem_fd = allocate_shared_filemem(ramSize);
 	if (vmem_fd < 0)
@@ -248,6 +255,15 @@ void create_mappings(const Mapping *vmem_maps, unsigned nummaps) {
 // Prepares the code region for JIT operations, thus marking it as RWX
 bool prepare_jit_block(void *code_area, size_t size, void **code_area_rwx)
 {
+#if defined(__EMSCRIPTEN__)
+    // wasm has no executable host memory; rec_wasm.cpp emits WebAssembly.Module
+    // instances on the JS side. Flycast's bookkeeping still wants a non-null
+    // buffer here for TempCodeCache arithmetic, so just hand it a plain malloc.
+    void *p = std::malloc(size);
+    if (!p) return false;
+    *code_area_rwx = p;
+    return true;
+#endif
     // Try to map is as RWX, this fails apparently on OSX (and perhaps other systems?)
 	if (code_area != nullptr && region_set_exec(code_area, size))
     {
@@ -289,6 +305,15 @@ void release_jit_block(void *code_area, size_t size)
 // Use two addr spaces: need to remap something twice, therefore use allocate_shared_filemem()
 bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdiff_t *rx_offset)
 {
+#if defined(__EMSCRIPTEN__)
+    // wasm: see single-arg overload above. Hand back a plain malloc; rx_offset
+    // is meaningless when there's no separate RX mapping.
+    void *p = std::malloc(size);
+    if (!p) return false;
+    *code_area_rw = p;
+    *rx_offset = 0;
+    return true;
+#endif
 	int fd = allocate_shared_filemem(size);
 	if (fd < 0)
 		return false;
