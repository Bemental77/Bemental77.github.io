+// ── run state ────────────────────────────────────────────────────────────────
+static s32 sInited, sBest, sStarted, sReported, sRestartReq, sMsgTimer, sDay, sRespawnReq;
+static const char *sMsg;
+
+static s32 station_number(s32 part) {
+    s32 i, n = 0;
+    for (i = 0; i <= part; i++) if (sPart[i].station) n++;
+    return n - 1;
+}
+
+static s16 heading_from(s32 i) {
+    s32 j;
+    for (j = i + 1; j < sNumParts && !sPart[j].station; j++) ;
+    if (j >= sNumParts) return sPart[i].yaw;
+    return atan2s(sPart[j].z - sPart[i].z, sPart[j].x - sPart[i].x);
+}
+
+static void put_mario_on(s32 i) {
+    struct MarioState *m = gMarioState;
+    struct Part *p = &sPart[i];
+    mario_stop_riding_and_holding(m);
+    m->pos[0] = p->x; m->pos[1] = p->y + 80.0f; m->pos[2] = p->z;
+    m->vel[0] = m->vel[1] = m->vel[2] = 0.0f;
+    m->forwardVel = 0.0f;
+    m->faceAngle[0] = 0;
+    m->faceAngle[1] = heading_from(i);
+    m->health = 0x880;
+    m->peakHeight = m->pos[1];
+    m->quicksandDepth = 0.0f;
+    set_mario_action(m, ACT_FREEFALL, 0);
+    m->marioObj->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;   // a cannon hides him
+    vec3f_copy(m->marioObj->header.gfx.pos, m->pos);
+    m->marioObj->oPosX = m->pos[0]; m->marioObj->oPosY = m->pos[1]; m->marioObj->oPosZ = m->pos[2];
+    reset_camera(gCurrentArea->camera);
+}
+
+static void say(const char *msg, s32 frames) { sMsg = msg; sMsgTimer = frames; }
+
+static void strip_caps(void) {
+    struct MarioState *m = gMarioState;
+    if (m->flags & (MARIO_WING_CAP | MARIO_METAL_CAP | MARIO_VANISH_CAP)) {
+        m->flags &= ~(MARIO_WING_CAP | MARIO_METAL_CAP | MARIO_VANISH_CAP);
+        m->flags |= MARIO_CAP_ON_HEAD;
+        m->capTimer = 0;
+        stop_cap_music();
+    }
+}
+
+// Platforms that fall or crumble (tumbling bridges, falling pillars...) come back when Mario
+// respawns, so a fall after crossing one never strands him behind it.
+static void respawn_broken_pieces(void) {
+    s32 i;
+    for (i = 0; i < sNumParts; i++) {
+        struct Part *p = &sPart[i];
+        struct Object *o = p->obj;
+        if (p->type != PT_PIECE) continue;
+        if (o == NULL || o->activeFlags == ACTIVE_FLAG_DEACTIVATED || o->behavior != segmented_to_virtual(sPiece[p->piece].beh)
+            || absf(o->oPosY - p->y) > 1500.0f) {
+            if (o != NULL && o->activeFlags != ACTIVE_FLAG_DEACTIVATED && o->behavior == segmented_to_virtual(sPiece[p->piece].beh)) obj_mark_for_deletion(o);
+            spawn_part_obj(i);
+        }
+    }
+}
+
+static void begin_run(void) {
+    struct MarioState *m = gMarioState;
+    s32 i;
+    if (m->action == ACT_STAR_DANCE_EXIT) enable_background_sound();   // restarted mid-dance
+    sLastCheck = 0; sBest = 0; sStarted = FALSE; sFinished = FALSE; sReported = FALSE; sRecN = 0; sRespawnReq = FALSE;
+    sUnlocked = sMode == MODE_RACE;
+    level_control_timer(TIMER_CONTROL_SHOW);
+    strip_caps();
+    m->numCoins = 0; gHudDisplay.coins = 0;
+    if (sGoalStar) sGoalStar->oHiddenStarTriggerCounter = 0;
+    for (i = 0; i < sNumParts; i++)
+        if (sPart[i].type == PT_OBJ && sPart[i].kind == OK_CANNON && sPart[i].obj) sPart[i].obj->oAction = 0;   // a cannon left loaded
+    respawn_all_dyn();
+    respawn_broken_pieces();
+    put_mario_on(0);
+}
+
+void daily_restart(void) { sRestartReq = TRUE; }
+
+// Test hooks (exported): Mario's height and the station he stands on (-1 = none).
+s32 daily_debug_mario_y(void) { return (s32) gMarioState->pos[1]; }
+static s32 standing_on(void);
+s32 daily_debug_standing(void) { return standing_on(); }
+// Test hook: 1 if Mario stands on part i's object, 2 if he is in the air, 0 if he stands on something else.
+s32 daily_debug_on_part(s32 i) {
+    struct MarioState *m = gMarioState;
+    if (m->action & ACT_FLAG_AIR) return 2;
+    if (m->floor == NULL || m->floor->object == NULL) return 0;
+    if (m->floor->object == sPart[i].obj) return 1;
+    return m->floor->object->behavior == segmented_to_virtual(bhvDailyPlatform) && (m->floor->object->oBehParams & 0xFF) == (i & 0xFF);   // its checkpoint cap
+}
+// Test hooks: put Mario at (x, y, z) facing yaw, standing/falling; read his state; hand him a cap.
+void daily_debug_put(s32 x, s32 y, s32 z, s32 yaw) {
+    struct MarioState *m = gMarioState;
+    mario_stop_riding_and_holding(m);
+    m->pos[0] = x; m->pos[1] = y; m->pos[2] = z; vec3f_set(m->vel, 0, 0, 0); m->forwardVel = 0;
+    m->faceAngle[1] = (s16) yaw; m->peakHeight = m->pos[1];
+    set_mario_action(m, ACT_FREEFALL, 0);
+}
+s32 daily_debug_mario(s32 f) {
