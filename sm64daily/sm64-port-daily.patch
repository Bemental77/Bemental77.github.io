+    sLastCheck = 0; sBest = 0; sStarted = FALSE; sFinished = FALSE; sReported = FALSE; sRecN = 0; sRespawnReq = FALSE;
+    sUnlocked = sMode == MODE_RACE;
+    level_control_timer(TIMER_CONTROL_SHOW);
+    strip_caps();
+    m->numCoins = 0; gHudDisplay.coins = 0;
+    if (sGoalStar) sGoalStar->oHiddenStarTriggerCounter = 0;
+    for (i = 0; i < sNumParts; i++)
+        if (sPart[i].type == PT_OBJ && sPart[i].kind == OK_CANNON && sPart[i].obj) sPart[i].obj->oAction = 0;   // a cannon left loaded
