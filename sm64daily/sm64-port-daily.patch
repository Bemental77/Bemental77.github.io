+    SEQ_LEVEL_BOSS_KOOPA, SEQ_EVENT_MERRY_GO_ROUND, SEQ_EVENT_BOSS, SEQ_LEVEL_BOSS_KOOPA_FINAL,
+};
+#define NUM_TRACKS ((s32) (sizeof(sTracks) / sizeof(sTracks[0])))
+static s32 todays_track(void) { return ((sDay - 1) % NUM_TRACKS + NUM_TRACKS) % NUM_TRACKS; }
