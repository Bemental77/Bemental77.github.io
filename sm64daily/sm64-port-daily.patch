+// ── host level ──────────────────────────────────────────────────────────────
+// Each day the course is built over a different SM64 world. Ids into this
+// table are what the page shows (window.sm64DailyHost).
+static const s16 sHosts[] = {
+    LEVEL_CASTLE_GROUNDS, LEVEL_BOB, LEVEL_WF, LEVEL_JRB, LEVEL_CCM, LEVEL_SSL, LEVEL_LLL, LEVEL_SL,
+    LEVEL_TTM, LEVEL_THI, LEVEL_RR, LEVEL_BITDW, LEVEL_BITFS, LEVEL_BITS, LEVEL_DDD,
+    LEVEL_CASTLE_COURTYARD,
+    // Open-sky worlds added next (a course floats above them like the others).
+    LEVEL_WDW, LEVEL_BBH, LEVEL_PSS, LEVEL_TOTWC, LEVEL_VCUTM, LEVEL_WMOTR, LEVEL_BOWSER_1, LEVEL_BOWSER_2, LEVEL_BOWSER_3,
+};
+static s32 sHostIdx = 0;
+
+static u32 page_seed(void) {
+    u32 seed = 0;
+#ifdef TARGET_WEB
+    seed = (u32) EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailySeed) | 0; });
+#endif
+    return seed;
+}
+
+// Called by intro_regular (title_screen.c): which level today's course is built in.
+s32 daily_host_level(void) {
+    u32 h = page_seed() * 2654435761u;
+    s32 forced = -1;
+#ifdef TARGET_WEB
+    forced = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyHostOverride !== undefined) ? window.sm64DailyHostOverride | 0 : -1; });
+#endif
+    sHostIdx = forced >= 0 ? forced % (s32) (sizeof(sHosts) / sizeof(sHosts[0])) : (s32) ((h >> 8) % (sizeof(sHosts) / sizeof(sHosts[0])));
