+// The collision a behaviour script loads itself: LOAD_COLLISION_DATA is the word BC_B(0x2A) and a
+// pointer (data/behavior_data.c:261-263), before the script's loop starts (BEGIN_LOOP, 0x08).
+static const Collision *beh_collision(const BehaviorScript *beh) {
+    const uintptr_t *w = (const uintptr_t *) segmented_to_virtual((void *) beh);
+    s32 i;
+    for (i = 0; i < 48; i++) {
+        if (w[i] == ((uintptr_t) 0x2A << 24)) return (const Collision *) segmented_to_virtual((void *) w[i + 1]);
+        if (w[i] == ((uintptr_t) 0x08 << 24)) break;
+    }
+    return NULL;
+}
