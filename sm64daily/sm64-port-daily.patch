+// Mini worlds: a whole SM64 level area (daily_isles.inc.h), shrunk to an island. Measured from its own
+// collision: bounding box and its highest point (the summit, where the next platform goes).
+struct IsleInfo { f32 x0, x1, z0, z1, y0, y1, sx, sy, sz; s32 ok; };
+static struct IsleInfo sIsleInfo[64];
+static void measure_isle(s32 i) {
+    const Collision *c = segmented_to_virtual((void *) sIsles[i].col);
+    struct IsleInfo *f = &sIsleInfo[i];
+    s32 n, k;
+    if (f->ok) return;
+    f->x0 = f->z0 = f->y0 = 1e9f; f->x1 = f->z1 = f->y1 = -1e9f;
+    if (*c++ != TERRAIN_LOAD_VERTICES) return;
+    n = *c++;
+    for (k = 0; k < n; k++, c += 3) {
+        f32 x = c[0], y = c[1], z = c[2];
+        if (x < f->x0) f->x0 = x; if (x > f->x1) f->x1 = x;
+        if (z < f->z0) f->z0 = z; if (z > f->z1) f->z1 = z;
+        if (y < f->y0) f->y0 = y;
+        if (y > f->y1) { f->y1 = y; f->sx = x; f->sy = y; f->sz = z; }
+    }
+    f->ok = 1;
+}
+// The highest floor of island i at its own (unscaled) x, z: walks its collision's triangle lists
+// (vertices, then type + count + triangles, 4 shorts for the types that carry a force).
+static f32 isle_floor(s32 i, f32 x, f32 z) {
+    const s16 *c = segmented_to_virtual((void *) sIsles[i].col), *v;
+    s32 nv, k;
+    f32 best = -1e9f;
+    if (*c++ != TERRAIN_LOAD_VERTICES) return best;
+    nv = *c++; v = c; c += nv * 3;
+    while (*c != TERRAIN_LOAD_CONTINUE && *c != TERRAIN_LOAD_END && *c != TERRAIN_LOAD_OBJECTS && *c != TERRAIN_LOAD_ENVIRONMENT) {
+        s16 type = *c++, cnt = *c++;
+        s32 force = (type == SURFACE_0004 || type == SURFACE_FLOWING_WATER || type == SURFACE_DEEP_MOVING_QUICKSAND || type == SURFACE_SHALLOW_MOVING_QUICKSAND
+                     || type == SURFACE_MOVING_QUICKSAND || type == SURFACE_HORIZONTAL_WIND || type == SURFACE_INSTANT_MOVING_QUICKSAND);
+        for (k = 0; k < cnt; k++, c += force ? 4 : 3) {
+            const s16 *a = &v[c[0] * 3], *b = &v[c[1] * 3], *d = &v[c[2] * 3];
+            f32 ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2], wx = d[0] - a[0], wy = d[1] - a[1], wz = d[2] - a[2];
+            f32 nx = uy * wz - uz * wy, ny = uz * wx - ux * wz, nz = ux * wy - uy * wx, e1, e2, e3, y;
+            if (ny < 0.0001f * sqrtf(nx * nx + ny * ny + nz * nz)) continue;   // floors face up
+            e1 = (b[2] - a[2]) * (x - a[0]) - (b[0] - a[0]) * (z - a[2]);
+            e2 = (d[2] - b[2]) * (x - b[0]) - (d[0] - b[0]) * (z - b[2]);
+            e3 = (a[2] - d[2]) * (x - d[0]) - (a[0] - d[0]) * (z - d[2]);
+            if (!((e1 >= 0 && e2 >= 0 && e3 >= 0) || (e1 <= 0 && e2 <= 0 && e3 <= 0))) continue;
+            y = a[1] - (nx * (x - a[0]) + nz * (z - a[2])) / ny;
+            if (y > best && type != SURFACE_DEATH_PLANE) best = y;
+        }
+    }
+    return best;
+}
