+        }
+
+        case MD_GAS: {
+            // A poison-gas chamber (like Hazy Maze Cave's): hurry through, it drains health (mario.c:1460-1463).
+            s16 ha = axis(h);
+            f32 x0, z0, x1, z1;
+            b = station(c, ha, rnd_f(150, 220), rnd_f(-60, 60), 260.0f, rnd_f(800, 1000));
+            if (!b || sNumEnv >= 6) break;
+            b->yaw = ha;
+            box_at(BK_WALL, b, 0, 0, b->y + 520.0f, b->hx + 40.0f, b->hz, 40.0f, ha);   // a roof, so it reads as a chamber
+            local_pt(b, -b->hz, -b->hx, &x0, &z0); local_pt(b, b->hz, b->hx, &x1, &z1);
+            {
+                struct Env *e = &sEnv[sNumEnv++];
+                e->id = 80; e->x0 = (s16) DMIN(x0, x1); e->x1 = (s16) DMAX(x0, x1);
+                e->z0 = (s16) DMIN(z0, z1); e->z1 = (s16) DMAX(z0, z1); e->y = (s16) (b->y + 420.0f);
+            }
+            decor_at(BK_GASVIS, b->x, b->z, b->y + 420.0f, b->hx, b->hz, 420.0f, ha);
