+// ── ghost (someone else's run) and recording (this run) ────────────────────
+#define REC_MAX (15 * 60 * 6)            // 15 Hz, 6 minutes
+static s16 sRec[REC_MAX][4];             // x, y, z, yaw — read by the page via daily_rec_ptr()
+static s32 sRecN;
+static s16 *sGhost; static s32 sGhostN;
+
+void daily_set_ghost(s16 *data, s32 n) { sGhost = data; sGhostN = n; }
+s16 *daily_rec_ptr(void) { return &sRec[0][0]; }
+s32 daily_rec_count(void) { return sRecN; }
+
+void bhv_daily_ghost_loop(void) {
+    struct Object *o = gCurrentObject;
+    s32 f = gHudDisplay.timer, i = f / 2;
+    if (sGhost == NULL || sGhostN <= 0 || gHudDisplay.timer == 0) {
+        o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+        return;
+    }
+    if (i >= sGhostN - 1) i = sGhostN - 1;
+    {
+        s16 *a = &sGhost[i * 4], *b = &sGhost[(i + 1 < sGhostN ? i + 1 : i) * 4];
+        f32 k = (f & 1) ? 0.5f : 0.0f;
+        o->oPosX = a[0] + (b[0] - a[0]) * k; o->oPosY = a[1] + (b[1] - a[1]) * k + 160.0f; o->oPosZ = a[2] + (b[2] - a[2]) * k;
+        o->oFaceAngleYaw = a[3];
+    }
+    o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+}
