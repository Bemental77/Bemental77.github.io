+// ── objects ─────────────────────────────────────────────────────────────────
+static struct Object *sGhostObj;
+static struct Object *sGoalCap, *sGoalStar;
+
+// The host level's own objects go: its stars would end the run early, its enemies wander into
+// nothing, and its model slots are free for ours. Its terrain, water and skybox stay.
+static void clear_host_objects(void) {
+    s32 i;
+    for (i = 0; i < NUM_OBJ_LISTS; i++) {
+        struct ObjectNode *head = &gObjectLists[i], *nd;
+        for (nd = head->next; nd != head; nd = nd->next) {
+            struct Object *o = (struct Object *) nd;
+            if (o != gMarioObject) obj_mark_for_deletion(o);
+        }
+    }
+}
+
+static s32 box_kind_of(struct Part *p) {
+    if (p->type == PT_BOX || p->type == PT_DECOR) return p->box;
+    if (p->fk) return p->fk;
+    return sStyle == STYLE_BOX ? BK_STATION : -1;   // -1: checkerboard
+}
+
+static void spawn_part_obj(s32 i) {
+    struct Part *p = &sPart[i];
+    struct Object *o = NULL;
+    s32 k = box_kind_of(p);
+    switch (p->type) {
+        case PT_CHECKER: case PT_BOX:
+            if (k < 0) {
+                // The checkerboard collision spans y -25..26 and x +-256, z +-153.5 (checkerboard_platform/collision.inc.c).
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CHECKER, bhvDailyPlatform,
+                                              (s16) p->x, (s16) (p->y - 26.0f * (p->h / 51.0f)), (s16) p->z, 0, p->yaw, 0);
+                obj_scale_xyz(o, p->hx / 256.0f, p->h / 51.0f, p->hz / 153.5f);
+            } else {
+                o = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + k, bhvDailyPlatform,
+                                              (s16) p->x, (s16) p->y, (s16) p->z, p->pitch, p->yaw, 0);
+                obj_scale_xyz(o, p->hx / 50.0f, p->h / 100.0f, p->hz / 50.0f);
+            }
+            o->oBehParams = i;
+            break;
+        case PT_DECOR:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + p->box, bhvDailyMarker,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+            obj_scale_xyz(o, p->hx / 50.0f, p->h / 100.0f, p->hz / 50.0f);
+            o->oBehParams = i | 0x400;   // 0x400: static decoration
+            break;
+        case PT_PIECE: {
+            struct Piece *pc = &sPiece[p->piece];
+            o = spawn_object_abs_with_rot(gMarioObject, 0, pc->model, pc->beh,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+            o->oBehParams = pc->bp;
+            o->oBehParams2ndByte = (pc->bp >> 16) & 0xFF;
+            o->oDrawingDistance = 30000.0f;
+            break;
+        }
+        case PT_ISLE:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, p->model, bhvDailyPlatform, (s16) p->x, (s16) p->y, (s16) p->z, 0, 0, 0);
+            obj_scale(o, p->sc);
+            o->oBehParams = i;
+            break;
+        case PT_POLE:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_GIANT_POLE, bhvGiantPole,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, 0, 0);
+            break;
+        case PT_FIREBAR:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_FIREBAR_BLOCK, bhvLllRotatingBlockWithFireBars,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, 0, 0);
+            break;
+        case PT_OBJ:
+            if (p->kind == OK_CANNON) {
+                // bhvCannon drops itself 340 into the ground (behavior_data.c:633); on a platform it sits on top.
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CANNON_BASE, bhvCannon,
+                                              (s16) p->x, (s16) (p->y + 340.0f), (s16) p->z, 0, p->yaw, 0);
+                o->oBehParams2ndByte = ((u16) p->yaw >> 8) & 0xFF;   // its resting yaw (cannon.inc.c:12)
+                o->oBehParams = (u32) o->oBehParams2ndByte << 16;
+            } else if (p->kind == OK_SWITCH) {
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_PURPLE_SWITCH, bhvFloorSwitchHiddenObjects,
+                                              (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+                o->oBehParams2ndByte = 2;
+            }
+            break;
+    }
+    if (o != NULL && p->type != PT_CHECKER && p->type != PT_BOX && p->type != PT_DECOR) o->parentObj = o;   // see spawn_dyn
+    p->obj = o;
+}
+
+static void spawn_course(void) {
+    s32 i;
+    for (i = 0; i < sNumParts; i++) spawn_part_obj(i);
+    // Checkpoints: a green cap on the platform and a see-through star over it (gone once reached).
+    for (i = 0; i < sNumParts; i++) {
+        struct Part *p = &sPart[i];
+        struct Object *c;
+        if (!p->check) continue;
+        c = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_CHECKCAP, bhvDailyPlatform,
+                                      (s16) p->x, (s16) (p->y + 6.0f), (s16) p->z, 0, p->yaw, 0);
+        obj_scale_xyz(c, p->hx / 50.0f * 0.98f, 0.06f, p->hz / 50.0f * 0.98f);
+        c->oBehParams = i | 0x100;
+        c = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CHECK_STAR, bhvDailyMarker,
+                                      (s16) p->x, (s16) (p->y + 260.0f), (s16) p->z, 0, 0, 0);
+        c->oBehParams = i;
+    }
+    // The goal: a gold cap, and a Power Star spinning over it at grabbing height.
+    sGoalStar = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_GOAL_STAR, bhvDailyMarker,
+                                          (s16) sPart[sGoal].x, (s16) (sPart[sGoal].y + 150.0f), (s16) sPart[sGoal].z, 0, 0, 0);
+    sGoalStar->oBehParams = sGoal | 0x200;
+    obj_scale(sGoalStar, 1.3f);
+    sGoalCap = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_GOALCAP, bhvDailyPlatform,
+                                         (s16) sPart[sGoal].x, (s16) (sPart[sGoal].y + 6.0f), (s16) sPart[sGoal].z, 0, sPart[sGoal].yaw, 0);
+    obj_scale_xyz(sGoalCap, sPart[sGoal].hx / 50.0f * 0.98f, 0.06f, sPart[sGoal].hz / 50.0f * 0.98f);
+    sGoalCap->oBehParams = sGoal | 0x100;   // 0x100: decoration with its own (box) collision
+    sGhostObj = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_GHOST, bhvDailyGhost,
+                                          (s16) sPart[0].x, (s16) sPart[0].y, (s16) sPart[0].z, 0, 0, 0);
+    obj_scale_xyz(sGhostObj, 1.1f, 1.6f, 1.1f);
+    sGhostObj->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+    // Our water and gas, in front of the level's own regions.
+    {
+        s16 *w = sEnvBuf, *hp = sHostEnv;
+        s32 n = 0, hn = hp ? *hp++ : 0;
+        w++;
+        for (i = 0; i < sNumEnv; i++, n++) { *w++ = sEnv[i].id; *w++ = sEnv[i].x0; *w++ = sEnv[i].z0; *w++ = sEnv[i].x1; *w++ = sEnv[i].z1; *w++ = sEnv[i].y; }
+        for (i = 0; i < hn && n < 24; i++, n++, hp += 6) { s32 j; for (j = 0; j < 6; j++) *w++ = hp[j]; }
+        sEnvBuf[0] = (s16) n;
+        gEnvironmentRegions = sEnvBuf;
+    }
+}
+
+static s32 dyn_alive(struct Dyn *d) {
+    return d->obj != NULL && d->obj->activeFlags != ACTIVE_FLAG_DEACTIVATED && d->obj->behavior == segmented_to_virtual(dyn_beh_of(d));
+}
+static void spawn_dyn(struct Dyn *d) {
+    struct Object *o = spawn_object_abs_with_rot(gMarioObject, 0, dyn_model_of(d), dyn_beh_of(d),
+                                                 (s16) d->x, (s16) d->y, (s16) d->z, 0, d->yaw, 0);
+    o->oBehParams = d->bp;
+    o->oBehParams2ndByte = (d->bp >> 16) & 0xFF;
+    o->oDrawingDistance = 30000.0f;
+    // Level-placed objects are their own parent (spawn_object.c:277); spawned ones get Mario
+    // (object_helpers.c:532). Some behaviors act on their parent — a Goomba deletes itself when its
+    // parent's oAction is 0 (goomba.inc.c:274-279) — so ours are their own parent, like the level's.
+    o->parentObj = o;
+    d->obj = o; d->gone = 0; d->spawned = 1;
+}
+static void respawn_all_dyn(void) {
+    s32 i;
+    for (i = 0; i < sNumDyn; i++) {
+        if (dyn_alive(&sDyn[i])) obj_mark_for_deletion(sDyn[i].obj);
+        sDyn[i].obj = NULL; sDyn[i].spawned = 0;
+        if (!lazy(sDyn[i].kind)) spawn_dyn(&sDyn[i]);
+    }
+}
+
+void bhv_daily_platform_loop(void) {
+    struct Object *o = gCurrentObject;
+    struct Part *p = &sPart[o->oBehParams & 0xFF];
+    s32 k;
+    // Collision must match the drawn model: checkerboard collision for checkerboard platforms
+    // (same +-256 x +-153.5 extents as its model), unit-box collision (of the right surface) for boxes.
+    if (p->type == PT_ISLE && !(o->oBehParams & 0x100)) {
+        // A mini world: the level area's own collision, scaled with the object (surface_load.c applies its scale).
+        o->collisionData = segmented_to_virtual((void *) sIsles[p->piece].col);
+        obj_build_transform_from_pos_and_angle(o, O_POS_INDEX, O_FACE_ANGLE_INDEX);
+        o->oCollisionDistance = 40000.0f;
+        o->oDrawingDistance = 40000.0f;
+        return;
+    }
+    if (o->oBehParams & 0x100) o->collisionData = (void *) make_box_col(SURFACE_NOT_SLIPPERY, 0);
+    else if ((k = box_kind_of(p)) < 0) o->collisionData = segmented_to_virtual(checkerboard_platform_seg8_collision_0800D710);
+    else o->collisionData = (void *) make_box_col(box_surface(k), p->force);
+    obj_build_transform_from_pos_and_angle(o, O_POS_INDEX, O_FACE_ANGLE_INDEX);
+    o->oCollisionDistance = DMAX(p->hx, p->hz) + p->h + LAZY_RADIUS + 400.0f;   // loaded wherever an enemy on it is active
+    o->oDrawingDistance = 30000.0f;
+}
+
+static s32 sLastCheck, sFinished, sUnlocked;
+
+void bhv_daily_marker_loop(void) {
+    struct Object *o = gCurrentObject;
+    o->oDrawingDistance = 30000.0f;
+    if (o->oBehParams & 0x400) return;   // static decoration (water, gas)
+    o->oFaceAngleYaw += (o->oBehParams & 0x200) ? 0x500 : 0x300;
+    // The goal star: see-through until the challenge is done, then gone into Mario's hands.
+    if (o->oBehParams & 0x200) {
+        if (sFinished || sMode == MODE_BOSS) { o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE; return; }
+        o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+        o->header.gfx.sharedChild = gLoadedGraphNodes[sUnlocked ? MODEL_GOAL_STAR : MODEL_CHECK_STAR];
+        return;
+    }
+    // A checkpoint's star goes once that checkpoint (or a later one) has been reached.
+    if ((o->oBehParams & 0xFF) <= sLastCheck) o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+    else o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+}
+
+// ── ghost (someone else's run) and recording (this run) ────────────────────
+#define REC_MAX (15 * 60 * 6)            // 15 Hz, 6 minutes
+static s16 sRec[REC_MAX][4];             // x, y, z, yaw — read by the page via daily_rec_ptr()
+static s32 sRecN;
+static s16 *sGhost; static s32 sGhostN;
+
+void daily_set_ghost(s16 *data, s32 n) { sGhost = data; sGhostN = n; }
+s16 *daily_rec_ptr(void) { return &sRec[0][0]; }
+s32 daily_rec_count(void) { return sRecN; }
+
+void bhv_daily_ghost_loop(void) {
+    struct Object *o = gCurrentObject;
+    s32 f = gHudDisplay.timer, i = f / 2;
+    if (sGhost == NULL || sGhostN <= 0 || gHudDisplay.timer == 0) {
+        o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+        return;
+    }
+    if (i >= sGhostN - 1) i = sGhostN - 1;
+    {
+        s16 *a = &sGhost[i * 4], *b = &sGhost[(i + 1 < sGhostN ? i + 1 : i) * 4];
+        f32 k = (f & 1) ? 0.5f : 0.0f;
+        o->oPosX = a[0] + (b[0] - a[0]) * k; o->oPosY = a[1] + (b[1] - a[1]) * k + 160.0f; o->oPosZ = a[2] + (b[2] - a[2]) * k;
+        o->oFaceAngleYaw = a[3];
+    }
+    o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+}
