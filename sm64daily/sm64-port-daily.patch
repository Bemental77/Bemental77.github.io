diff --git a/src/pc/controller/controller_page.c b/src/pc/controller/controller_page.c
new file mode 100644
index 0000000..21927ef
--- /dev/null
+++ b/src/pc/controller/controller_page.c
@@ -0,0 +1,30 @@
+#ifdef TARGET_WEB
+// SM64 DAILY PARKOUR: the page owns input. It reads the keyboard, any controller (Gamepad API)
+// and the touch controls through the player's own remappable bindings, and hands the game one
+// N64 pad state per frame through daily_set_pad(). This replaces the SDL controller and the
+// fixed keyboard map on the web build, so a remap on the page is the whole story.
+#include <ultra64.h>
+#include "controller_api.h"
+
+static u16 sButtons;
+static s8 sStickX, sStickY;
+
+void daily_set_pad(int buttons, int stickX, int stickY) {
+    sButtons = (u16) buttons;
+    sStickX = (s8) (stickX > 80 ? 80 : stickX < -80 ? -80 : stickX);
+    sStickY = (s8) (stickY > 80 ? 80 : stickY < -80 ? -80 : stickY);
+}
+
+static void controller_page_init(void) {
+}
+
+static void controller_page_read(OSContPad *pad) {
+    pad->button |= sButtons;
+    if (sStickX != 0 || sStickY != 0) {
+        pad->stick_x = sStickX;
+        pad->stick_y = sStickY;
+    }
+}
+
+struct ControllerAPI controller_page = { controller_page_init, controller_page_read };
+#endif
