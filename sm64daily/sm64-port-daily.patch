+static struct Part *add_part(u8 type) {
+    struct Part *p;
+    if (sNumParts >= MAX_PARTS) return NULL;
+    p = &sPart[sNumParts++];
+    bzero(p, sizeof(*p));
+    p->type = type; p->h = 51.0f;
+    return p;
+}
+
+// Extent of a station along world heading h.
+static f32 extent_along(struct Part *p, s16 h) {
+    s16 d = h - p->yaw;
+    if (p->type == PT_PIECE) return p->r;
+    return p->hx * absf(sins(d)) + p->hz * absf(coss(d));
+}
+
+static void put_ahead(struct Part *n, struct Part *from, s16 h, f32 gap, f32 dy, f32 nExtent) {
+    f32 d = extent_along(from, h) + gap + nExtent;
+    n->x = from->x + sins(h) * d; n->z = from->z + coss(h) * d; n->y = from->y + dy;
+}
+
+static struct Part *station(struct Part *from, s16 h, f32 gap, f32 dy, f32 hx, f32 hz) {
+    struct Part *n = add_part(PT_CHECKER);
+    if (!n) return NULL;
+    n->hx = hx; n->hz = hz; n->yaw = h; n->station = 1;
+    put_ahead(n, from, h, gap, dy, hz);
+    return n;
+}
+
+// A box (top-centre at x,y,z) in a station's local frame: `fw` along its heading, `sd` to its side.
+static struct Part *box_at(u8 kind, struct Part *a, f32 fw, f32 sd, f32 top, f32 hx, f32 hz, f32 h, s16 yaw) {
+    struct Part *b = add_part(PT_BOX);
+    s16 hl = a->yaw + 0x4000;
+    if (!b) return NULL;
+    b->box = kind; b->hx = hx; b->hz = hz; b->h = h; b->yaw = yaw;
+    b->x = a->x + sins(a->yaw) * fw + sins(hl) * sd; b->z = a->z + coss(a->yaw) * fw + coss(hl) * sd; b->y = top;
+    return b;
+}
+static struct Part *decor_at(u8 kind, f32 x, f32 z, f32 top, f32 hx, f32 hz, f32 h, s16 yaw) {
+    struct Part *b = add_part(PT_DECOR);
+    if (!b) return NULL;
+    b->box = kind; b->x = x; b->z = z; b->y = top; b->hx = hx; b->hz = hz; b->h = h; b->yaw = yaw; b->r = 1;
+    return b;
+}
+// A point in station a's frame.
+static void local_pt(struct Part *a, f32 fw, f32 sd, f32 *x, f32 *z) {
+    s16 hl = a->yaw + 0x4000;
+    *x = a->x + sins(a->yaw) * fw + sins(hl) * sd; *z = a->z + coss(a->yaw) * fw + coss(hl) * sd;
+}
+
+static f32 top_of(struct Part *p);
+
+// Place SM64 piece `pi` in the gap after `from`. Long pieces are laid along the travel direction.
+static struct Part *piece_after(struct Part *from, s32 pi, s16 h, f32 gap, f32 dy) {
+    struct Piece *pc = &sPiece[pi];
+    struct Part *n = add_part(PT_PIECE);
+    f32 along;
+    if (!n) return NULL;
+    n->piece = pi;
+    if (pc->role == R_LONGSTEP) {
+        // Lay the long axis along the path (local x -> heading needs yaw = h - 0x4000).
+        n->yaw = pc->rx > pc->rz ? h - 0x4000 : h;
+        along = DMAX(pc->rx, pc->rz);
+        n->r = along;
+    } else {
+        n->yaw = h; along = pc->r; n->r = pc->r;
+    }
+    put_ahead(n, from, h, gap, 0, along);
+    n->y = top_of(from) + dy - pc->maxY;     // its walkable top sits dy above the previous top
+    n->h = pc->maxY - pc->minY;
+    n->r = along;
+    return n;
+}
+
+static f32 top_of(struct Part *p) {
+    return p->type == PT_PIECE ? p->y + sPiece[p->piece].maxY : p->y;
+}
