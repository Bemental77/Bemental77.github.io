+            }
+            break;
+        }
+
+        case MD_BOSS: {
+            // The arena: big and flat (the bosses pound, sweep and throw). The Big Bully only dies on
+            // lava or a death floor (obj_behaviors.c:708-723), so his arena has a lava moat below it:
+            // knock him off into it. Mario can bounce back out of the lava.
+            struct Dyn *d;
+            n = station(c, h, rnd_f(160, 220), rnd_f(-40, 40), 950.0f, 950.0f);
+            if (!n) break;
+            n->r = 1400.0f;
+            if (sBoss == BOSS_BIG_BULLY) {
+                b = box_at(BK_LAVA, n, 0, 0, n->y - 170.0f, n->hx + 650.0f, n->hz + 650.0f, 60.0f, n->yaw);
+                if (b) b->r = 1;
+            }
+            d = add_dyn(DK_BOSS, n->x, n->y + 60.0f, n->z, (s32) (n - sPart));
+            if (d) { d->bp = sBosses[sBoss].bp; d->yaw = h + 0x8000; d->objective = 1; }
