+static void build_boxes(void) {
+    static const s16 face[6][4][3] = {
+        { { -50, 0, -50 }, { -50, 0, 50 }, { 50, 0, 50 }, { 50, 0, -50 } },
+        { { -50, -100, -50 }, { 50, -100, -50 }, { 50, -100, 50 }, { -50, -100, 50 } },
+        { { -50, 0, 50 }, { -50, -100, 50 }, { 50, -100, 50 }, { 50, 0, 50 } },
+        { { 50, 0, -50 }, { 50, -100, -50 }, { -50, -100, -50 }, { -50, 0, -50 } },
+        { { 50, 0, 50 }, { 50, -100, 50 }, { 50, -100, -50 }, { 50, 0, -50 } },
+        { { -50, 0, -50 }, { -50, -100, -50 }, { -50, -100, 50 }, { -50, 0, 50 } },
+    };
+    static const f32 shade[6] = { 1.0f, 0.35f, 0.7f, 0.6f, 0.8f, 0.5f };
+    s32 k, f, i;
+    for (k = 0; k < BK_COUNT; k++) {
+        for (f = 0; f < 6; f++) {
+            for (i = 0; i < 4; i++) {
+                Vtx *v = &sBoxVtx[k][f * 4 + i];
+                f32 s = shade[f] * ((f == 0 && face[f][i][2] > 0) ? 0.82f : 1.0f);
+                v->v.ob[0] = face[f][i][0]; v->v.ob[1] = face[f][i][1]; v->v.ob[2] = face[f][i][2];
+                v->v.flag = 0; v->v.tc[0] = 0; v->v.tc[1] = 0;
+                v->v.cn[0] = (u8) (sBoxColor[k][0] * s); v->v.cn[1] = (u8) (sBoxColor[k][1] * s);
+                v->v.cn[2] = (u8) (sBoxColor[k][2] * s); v->v.cn[3] = sBoxColor[k][3];
+            }
+        }
+        load_model(BOX_MODEL_BASE + k, sBoxGeo[k]);
+    }
