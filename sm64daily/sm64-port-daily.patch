+static s32 pick_step_piece(void) {
+    s32 tries;
+    for (tries = 0; tries < 80; tries++) {
+        s32 i = rnd_i(NUM_PIECES);
+        if ((sPiece[i].role == R_STEP || sPiece[i].role == R_LONGSTEP) && (sPieceOn[i] || tries > 60)) return i;
+    }
+    return 0;
+}
+
+// Would a cannon shot at `pitch` from (sx, sy, sz) along yaw land on station b? Simulates SM64's own
+// ACT_SHOT_FROM_CANNON: 100 at the aim, gravity 1/frame to -75, forward speed -0.05/frame (above).
+static s32 cannon_lands(f32 sx, f32 sy, f32 sz, s16 yaw, s16 pitch, struct Part *b) {
+    f32 x = sx + 120.0f * coss(pitch) * sins(yaw), y = sy + 120.0f * sins(pitch), z = sz + 120.0f * coss(pitch) * coss(yaw);
+    f32 vy = 100.0f * sins(pitch), f = 100.0f * coss(pitch);
+    s32 t;
+    for (t = 0; t < 900; t++) {
+        f32 nx = x + f * sins(yaw), nz = z + f * coss(yaw), ny = y + vy, dx, dz, lx, lz;
+        dx = nx - b->x; dz = nz - b->z;
+        lx = dx * coss(b->yaw) - dz * sins(b->yaw); lz = dx * sins(b->yaw) + dz * coss(b->yaw);
+        if (absf(lx) < b->hx && absf(lz) < b->hz && ny <= b->y && y >= b->y - 5.0f)   // crosses the top inside the footprint
+            return absf(lx) < b->hx - 100.0f && absf(lz) < b->hz - 100.0f;
+        if (absf(lx) < b->hx && absf(lz) < b->hz && ny < b->y) return FALSE;              // hit its side
+        x = nx; y = ny; z = nz;
+        vy -= 1.0f; if (vy < -75.0f) vy = -75.0f;
+        f -= 0.05f; if (f < 10.0f) f = 10.0f;
+        if (y < b->y - 3000.0f) return FALSE;
+    }
+    return FALSE;
+}
+// The middle of the widest run of pitches that land. A shot covers ~10000*sin(2*pitch) on the level,
+// so the window is narrow; it must be at least ~1 degree (3 x 0x40) wide — the stick aims in steps
+// of stickY*10 (act_in_cannon), and the reticle shows the aim.
+static s16 cannon_aim(f32 sx, f32 sy, f32 sz, s16 yaw, struct Part *b) {
+    s32 p, run = 0, bestRun = 0, bestMid = -1;
+    for (p = 0x0080; p <= 0x2400; p += 0x40) {   // flat shots only: a high lob is too touchy
+        if (cannon_lands(sx, sy, sz, yaw, (s16) p, b)) {
+            run++;
+            if (run > bestRun) { bestRun = run; bestMid = p - (run - 1) * 0x20; }
+        } else run = 0;
+    }
+    return bestRun >= 3 ? (s16) bestMid : -1;
+}
+
+static s16 axis(s16 h) { return (s16) (((h + 0x2000) & 0xC000)); }   // nearest of the four axis headings
+
+static void add_capbox(struct Part *a, f32 fw, f32 sd, s32 content) {
+    f32 x, z;
+    struct Dyn *d;
+    local_pt(a, fw, sd, &x, &z);
+    d = add_dyn(DK_CAPBOX, x, a->y + 210.0f, z, (s32) (a - sPart));
+    if (d) d->bp = (1u << 24) | ((u32) content << 16);   // top byte set: always solid, no cap switch needed (exclamation_box.inc.c:41-45)
+}
+static void add_enemy(u8 kind, struct Part *a, f32 fw, f32 sd) {
+    f32 x, z;
+    struct Dyn *d;
+    local_pt(a, fw, sd, &x, &z);
+    d = add_dyn(kind, x, a->y + (kind == DK_FLYGUY ? 260.0f : 40.0f), z, (s32) (a - sPart));
+    if (d) { d->objective = 1; if (kind == DK_GOOMBA_BIG) d->bp = 1u << 16; }
+}
+
+// Build one module after station `cur`. Returns the index of its landing station, or -1 (rolled back).
+static s32 build_module(s32 m, s32 cur, s16 h, f32 hard) {
+    struct Part *c = &sPart[cur], *n = NULL, *a, *b;
+    s32 start = sNumParts, startDyn = sNumDyn, startEnv = sNumEnv, i;
+    f32 g = 150.0f + 70.0f * hard;     // edge-to-edge hop gap scale (a running single jump covers ~600)
+
+    switch (m) {
+        case MD_HOP:
+            n = station(c, h, rnd_f(150, 240 + 80 * hard), rnd_f(-150, 150), rnd_f(200, 300), rnd_f(200, 300));
+            if (n && rnd_i(100) < 25) n->fk = rnd_i(2) ? BK_MUD : BK_ICE;
+            break;
+
+        case MD_STEPPING: case MD_DOUBLE_STEPPING:
+            // One or two real SM64 moving/rotating/sinking pieces as the only footing across a gap.
+            a = c;
+            for (i = 0; i < (m == MD_DOUBLE_STEPPING ? 2 : 1); i++) {
+                a = piece_after(a, pick_step_piece(), h, rnd_f(g * 0.6f, g), rnd_f(-60, 60));
+                if (!a) break;
+            }
+            if (a) n = station(a, h, rnd_f(g * 0.6f, g), rnd_f(-80, 80), rnd_f(220, 300), rnd_f(220, 300));
+            break;
+
+        case MD_THWOMP: case MD_PENDULUM: case MD_FIREBAR:
+            // A long connector you must cross while something tries to stop you.
+            n = station(c, h, rnd_f(150, 240), rnd_f(-80, 80), m == MD_FIREBAR ? 520.0f : 280.0f, m == MD_FIREBAR ? 520.0f : rnd_f(650, 800));
+            if (!n) break;
+            b = add_part(m == MD_FIREBAR ? PT_FIREBAR : PT_PIECE);
+            if (!b) { n = NULL; break; }
+            b->x = n->x; b->z = n->z; b->yaw = h;
+            if (m == MD_THWOMP) { b->piece = 12; b->y = n->y; b->r = 1; }
+            if (m == MD_PENDULUM) { b->piece = 13; b->yaw = h + 0x4000; b->y = n->y + 60.0f - sPiece[13].minY; b->r = 1; }   // bob bottom swings just above the floor
+            if (m == MD_FIREBAR) { b->y = n->y; b->r = 1; }
+            b->h = 0;
+            break;
+
+        case MD_LONG:
+            // Runway long enough to reach full speed, then a gap no running jump clears (~600) but a
+            // 48-speed half-gravity long jump does.
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 220.0f, rnd_f(450, 550));
+            if (a) n = station(a, h, rnd_f(700, 780 + 60 * hard), rnd_f(-140, -40), rnd_f(240, 300), rnd_f(240, 300));
+            break;
+
+        case MD_POWER_STEP:
+            // A wall taller than a single jump (~310) but inside a double jump / backflip / sideflip.
+            a = station(c, h, rnd_f(150, 240), rnd_f(-60, 60), rnd_f(260, 320), rnd_f(260, 320));
+            if (a) {
+                f32 dy = rnd_f(370, 410 + 20 * hard);
+                n = station(a, h, 0.0f, dy, rnd_f(220, 280), rnd_f(220, 260));
+                if (n) n->h = dy + 200.0f;
+            }
+            break;
+
