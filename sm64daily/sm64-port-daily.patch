+        respawn_broken_pieces();
+        put_mario_on(sLastCheck);
+    }
+
+    // HUD: progress or the challenge (the timer is SM64's own), and short flashes.
+    if (sMode == MODE_BOSS) {
+        print_text(20, 36, "BOSS");
+        print_text(20, 16, sBosses[sBoss].name);
+    } else if (sMode == MODE_RACE) {
+        print_text(20, 36, "PLAT");
+        print_text_fmt_int(90, 36, "%d", sBest);
+        print_text(20, 16, "OF");
+        print_text_fmt_int(60, 16, "%d", sNumStations - 1);
+    } else if (!sUnlocked) {
+        print_text(20, 36, sMode == MODE_RED ? "RED COINS" : sMode == MODE_CLEAR ? "ENEMIES" : "COINS");
+        if (sMode == MODE_RED) print_text_fmt_int(20, 16, "%d LEFT", left);
+        else if (sMode == MODE_CLEAR) print_text_fmt_int(20, 16, "%d LEFT", left);
+        else print_text_fmt_int(20, 16, "%d TO GO", left);
+    } else {
+        print_text(20, 26, "TO THE STAR");
+    }
