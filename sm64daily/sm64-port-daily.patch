+            b = add_part(PT_BOX);
+            if (!b) break;
+            b->box = BK_LAVA; b->hx = 230.0f; b->hz = rnd_f(650, 900); b->h = 60.0f; b->yaw = h;
+            put_ahead(b, a, h, 0, 0, b->hz);
+            n = station(b, h, 0, 0, rnd_f(260, 320), rnd_f(260, 320));
+            if (!n) break;
+            add_capbox(a, -80.0f, 0, 3);
+            break;
+        }
+
+        case MD_VANISH: case MD_METAL: {
+            // Vanish cap: blue mesh walls block a bridge; with the cap Mario walks through them.
+            // Metal cap: fire bars sweep a bridge; metal Mario is fireproof (interaction.c:1160).
+            s32 k, cnt = 2;
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 280.0f, 280.0f);
+            if (!a) break;
+            n = station(a, h, rnd_f(150, 200), rnd_f(-40, 40), m == MD_METAL ? 300.0f : 210.0f, rnd_f(800, 950));
+            if (!n) break;
+            add_capbox(a, 0, 0, m == MD_METAL ? 1 : 2);
+            for (k = 0; k < cnt; k++) {
+                f32 fw = -n->hz + (k + 1) * (2 * n->hz) / (cnt + 1);
+                if (m == MD_VANISH) box_at(BK_VANISH, n, fw, 0, n->y + 1300.0f, n->hx + 120.0f, 30.0f, 1300.0f, n->yaw);
+                else {
+                    struct Part *f = add_part(PT_FIREBAR);
+                    if (f) { local_pt(n, fw, 0, &f->x, &f->z); f->y = n->y; f->r = 1; f->h = 0; }
+                }
+            }
+            break;
+        }
+
+        case MD_WING: {
+            // A runway with a wing cap: triple jump into the air and fly to an island beyond any long jump
+            // (2300+ out, at most 500 lower — a long jump from 500 up reaches ~1900).
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 260.0f, rnd_f(800, 950));
+            if (!a) break;
+            n = station(a, h, rnd_f(2300, 2700), rnd_f(-500, -200), rnd_f(480, 580), rnd_f(480, 580));
+            if (!n) break;
+            add_capbox(a, -a->hz + 200.0f, 0, 0);
+            break;
+        }
+
+        case MD_BARS: {
+            // Monkey bars (SURFACE_HANGABLE) over a gap too wide for a long jump to a ledge 120 up.
+            f32 G = rnd_f(1300, 1500);
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 280.0f, 280.0f);
+            if (!a) break;
+            n = station(a, h, G, 120.0f, rnd_f(260, 320), rnd_f(260, 320));
+            if (!n) break;
+            box_at(BK_BARS, a, a->hz + G / 2.0f, 0, a->y + 330.0f, 200.0f, G / 2.0f + 120.0f, 40.0f, h);   // 400 wide: room to drift while hanging
+            break;
+        }
+
+        case MD_SAND:
+            // Quicksand: keep moving (and jumping) or sink.
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 260.0f, 260.0f);
+            if (!a) break;
+            b = station(a, h, 0, -20.0f, 260.0f, rnd_f(650, 850));
+            if (!b) break;
+            b->fk = BK_SAND; b->station = 0;
+            n = station(b, h, 0, 20.0f, rnd_f(260, 320), rnd_f(260, 320));
+            break;
+
+        case MD_ICE: {
+            // Ice floes: a chain of slick, small platforms.
+            s32 k;
+            a = c;
+            for (k = 0; k < 3 && a; k++) {
+                a = station(a, h + (s16) rnd_f(-0x1400, 0x1400), rnd_f(140, 220 + 40 * hard), rnd_f(-80, 80), rnd_f(150, 200), rnd_f(150, 200));
+                if (a) a->fk = BK_ICE;
+            }
+            n = a;
+            break;
+        }
+
+        case MD_WIND: {
+            // A narrow bridge with a crosswind pushing Mario off its side (SURFACE_HORIZONTAL_WIND, mario_step.c:190-213).
+            s16 dir = (s16) (h + (rnd_i(2) ? 0x4000 : -0x4000));
+            b = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 230.0f, rnd_f(700, 900));
+            if (!b) break;
+            b->fk = BK_WINDY; b->force = (s16) ((u16) dir >> 8);
