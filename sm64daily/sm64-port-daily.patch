+// Walking enemies need their platform's collision under them, and SM64 only loads an object's
+// collision while Mario is within its oCollisionDistance (surface_load.c:834). So they are spawned
+// once Mario comes near their platform, not at the start.
+static s32 lazy(u8 k) { return k == DK_GOOMBA || k == DK_GOOMBA_BIG || k == DK_BOBOMB || k == DK_CHUCKYA || k == DK_BOSS || k == DK_LIB || k == DK_METALBOX || k == DK_CHOMP; }
+#define LAZY_RADIUS 2200.0f
