+// A Part is anything placed. Stations are what Mario lands on between obstacles; they carry
+// progress, checkpoints and the goal.
+enum { PT_CHECKER, PT_BOX, PT_PIECE, PT_POLE, PT_FIREBAR, PT_OBJ, PT_DECOR, PT_ISLE };
+enum { OK_CANNON, OK_SWITCH };
+struct Part {
+    f32 x, y, z;        // stations/boxes: top-centre; pieces: object origin
+    f32 hx, hz, h;      // stations/boxes: half width (local x), half length (local z), height
+    f32 r;              // footprint radius (for spacing)
+    s16 yaw, pitch, force, param;
+    f32 sc;             // isles: scale
+    u8 type, box, fk, piece, station, check, goal, kind, gnd, model;
+    struct Object *obj;
+};
+static struct Part sPart[MAX_PARTS];
