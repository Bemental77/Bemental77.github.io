+
+static s32 in_our_env(f32 x, f32 z) {
+    s32 i;
+    for (i = 0; i < sNumEnv; i++) if (sEnv[i].x0 < x && x < sEnv[i].x1 && sEnv[i].z0 < z && z < sEnv[i].z1) return TRUE;
+    return FALSE;
+}
+
+void daily_update(void) {
+    struct MarioState *m = gMarioState;
+    s32 i, on, lowest, left;
+    f32 reach;
+
+    if (gCurrLevelNum != sHosts[sHostIdx] || gMarioObject == NULL || gCurrentArea == NULL) {
+        sInited = FALSE;
+        return;
+    }
+    // No pause menu: its "Exit Course" would leave the course for the castle. Start does nothing here.
+    gPlayer1Controller->buttonPressed &= ~START_BUTTON;
+    if (!sInited) {
+        u32 seed = 0;
+        s32 dow = 1;
+#ifdef TARGET_WEB
+        seed = (u32) EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailySeed) | 0; });
+        dow = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyDow !== undefined) ? window.sm64DailyDow | 0 : 1; });
+        sDay = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyNumber) | 0; });
+#endif
+        sHostEnv = gEnvironmentRegions;
+#ifdef TARGET_WEB
+        sNoRemap = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyNoRemap) ? 1 : 0; });
+#endif
+        clear_host_objects();
+        generate(seed, dow);
+        load_all_models();
+        load_lib_models();
+        for (i = 0; i < 2; i++) if (sIsleOn[i] >= 0 && sModOn[MD_ISLAND] > 0) load_model(sIsleSlot[i], sIsles[sIsleOn[i]].geo);   // mini worlds
+        if (sBoss >= 0) {
+            load_model(sBosses[sBoss].model, sBosses[sBoss].geo);
+            if (sBosses[sBoss].geo2) load_model(sBosses[sBoss].model2, sBosses[sBoss].geo2);
+        }
+        {
+            const u8 *st = sThemes[sTheme][0], *ac = sThemes[sTheme][1];
+            for (i = 0; i < 3; i++) { sBoxColor[BK_STATION][i] = st[i]; sBoxColor[BK_WALL][i] = ac[i]; }
+        }
+        build_boxes();
+        spawn_course();
+        sInited = TRUE;
+        begin_run();
+        set_background_music(0, SEQUENCE_ARGS(4, sTracks[todays_track()]), 0);
+#ifdef TARGET_WEB
+        // Today's module list (ids into the page's MODULES table), for the intro card and share line.
+        EM_ASM({ if (typeof window !== 'undefined') { window.sm64DailyModules = []; window.sm64DailyHost = $0; window.sm64DailyMode = $1; window.sm64DailyTheme = $2; window.sm64DailyStyle = $3; } },
+               sHostIdx, sMode, sTheme, sStyle);
+        for (i = 0; i < sNumMods; i++) EM_ASM({ window.sm64DailyModules.push($0); }, sMods[i]);
+        EM_ASM({ if (typeof window !== 'undefined' && window.sm64DailyReady) window.sm64DailyReady($0, $1); }, sNumStations, sNumParts);
+#endif
+        return;
+    }
+    // SM64 pieces load their collision only while Mario is within oCollisionDistance of their
+    // origin (surface_load.c:838) — 1000 by default (spawn_object.c:309), 400 for a TTC elevator.
+    // In their home levels that is enough; on a course a long piece's far end, or a moving one that
+    // has carried its surface away from its origin, would be a floor Mario falls through.
+    for (i = 0; i < sNumParts; i++) {
+        struct Part *p = &sPart[i];
+        f32 need;
+        if (p->type != PT_PIECE || p->obj == NULL || p->obj->activeFlags == ACTIVE_FLAG_DEACTIVATED
+            || p->obj->behavior != segmented_to_virtual((void *) sPiece[p->piece].beh)) continue;
+        need = sPiece[p->piece].r + (sPiece[p->piece].maxY - sPiece[p->piece].minY) + 1500.0f;
+        if (p->obj->oCollisionDistance < need) p->obj->oCollisionDistance = need;
+    }
+    if (sRestartReq) { sRestartReq = FALSE; begin_run(); return; }
+
+    // Red coins count toward our goal star (bhv_red_coin_loop bumps its parent's counter and shows
+    // the orange numbers), not toward any star the level once had.
+    for (i = 0; i < sNumDyn; i++) {
+        struct Dyn *d = &sDyn[i];
+        if (!d->spawned) {
+            struct Part *p = &sPart[d->part];
+            f32 dx = m->pos[0] - p->x, dz = m->pos[2] - p->z;
+            if (dx * dx + dz * dz < LAZY_RADIUS * LAZY_RADIUS && absf(m->pos[1] - p->y) < 2500.0f) spawn_dyn(d);
+            continue;
+        }
+        if (!dyn_alive(d)) {
+            // Item boxes come back (a shell box deletes itself once broken: exclamation_box.inc.c:127-130),
+            // unless Mario is still riding that shell.
+            if (d->kind == DK_CAPBOX && ++d->gone > 300 && !(m->action & ACT_FLAG_RIDING_SHELL)) spawn_dyn(d);
+            continue;
+        }
+        if (d->kind == DK_REDCOIN) d->obj->parentObj = sGoalStar;
+        // A boss thrown off into the sky comes back to its arena.
+        if (d->kind == DK_BOSS && d->obj->oPosY < sPart[d->part].y - 1500.0f) { obj_mark_for_deletion(d->obj); spawn_dyn(d); continue; }
+        // An enemy knocked off the course counts as beaten.
+        if (is_enemy(d->kind) && d->kind != DK_FLYGUY && !(d->kind == DK_LIB && !sLib[d->lib].ground) && d->obj->oPosY < sPart[d->part].y - 700.0f) obj_mark_for_deletion(d->obj);
+        // A metal box that went over an edge goes home.
+        if (d->kind == DK_METALBOX && d->obj->oPosY < sPart[d->part].y - 300.0f) { obj_mark_for_deletion(d->obj); spawn_dyn(d); }
+    }
+    // The springboard: landing on its top launches Mario (SM64 never finished it: beta_trampoline.inc.c
+    // stubs the bounce out). Its top is a platform object, so Mario stands on it like any floor.
+    if (m->floor != NULL && m->floor->object != NULL && m->floor->object->behavior == segmented_to_virtual(bhvBetaTrampolineTop)
+        && !(m->action & ACT_FLAG_AIR) && m->pos[1] - m->floorHeight < 10.0f) {
+        set_mario_action(m, ACT_TRIPLE_JUMP, 0);
+        m->vel[1] = 92.0f;
+        play_sound(SOUND_GENERAL_BOING1, gGlobalSoundSource);
+    }
+    left = objective_left();
+    if (!sUnlocked && left == 0 && sMode != MODE_BOSS) {
+        sUnlocked = TRUE;
+        play_sound(SOUND_GENERAL2_RIGHT_ANSWER, gGlobalSoundSource);
+        say(sMode == MODE_RED ? "STAR UNLOCKED" : sMode == MODE_CLEAR ? "ALL CLEAR" : "STAR UNLOCKED", 60);
+    }
+
+    on = standing_on();
+    if (!sStarted && !sFinished && on != 0
+        && (absf(m->pos[0] - sPart[0].x) > sPart[0].hx + 30.0f || absf(m->pos[2] - sPart[0].z) > sPart[0].hz + 30.0f
+            || m->pos[1] > sPart[0].y + 400.0f)) {
+        sStarted = TRUE;
+        level_control_timer(TIMER_CONTROL_START);
+    }
+    if (sStarted && !sFinished && (gHudDisplay.timer & 1) == 0 && sRecN < REC_MAX) {
+        sRec[sRecN][0] = (s16) m->pos[0]; sRec[sRecN][1] = (s16) m->pos[1]; sRec[sRecN][2] = (s16) m->pos[2];
+        sRec[sRecN][3] = m->faceAngle[1];
+        sRecN++;
+    }
+    if (on > 0 && !sFinished) {
+        s32 sn = station_number(on);
+        if (sn > sBest) sBest = sn;
+        if (sPart[on].check && on > sLastCheck) {
+            sLastCheck = on;
+            play_sound(SOUND_GENERAL_COIN, gGlobalSoundSource);
+            say("CHECKPOINT", 45);
+        }
+        if (on == sGoal) {
+            if (sUnlocked && sMode != MODE_BOSS) finish_run(sGoalStar);
+            else if (sMsgTimer <= 0 && sMode != MODE_BOSS) say(sMode == MODE_RED ? "FIND ALL 8 RED COINS" : sMode == MODE_CLEAR ? "BEAT EVERY ENEMY" : "COLLECT MORE COINS", 60);
+        }
+    }
+    // The dance would warp out of the level on its 80th frame (general_star_dance_handler);
+    // step it to its closing animation just before that, so Mario stays on the course.
+    if (sFinished && m->action == ACT_STAR_DANCE_EXIT && m->actionState == 0 && m->actionTimer >= 79) m->actionState = 2;
+    if (sFinished && !sReported && ((m->action != ACT_STAR_DANCE_EXIT && m->action != ACT_FALL_AFTER_STAR_GRAB) || m->actionState == 2)) {
+        sReported = TRUE;
+        report();
+    }
+
+    // Fell: below every station by a margin, down on the level's own ground far below where he can
+    // climb back from (the level's ground is part of the world, not a death — courses pass over and
+    // across it), into a death plane or the level's water, or died. Respawn on the last checkpoint.
+    for (lowest = 0, i = 1; i < sNumParts; i++) if (sPart[i].station && sPart[i].y < sPart[lowest].y) lowest = i;
+    {
+        s32 best = 0, k = 0;
+        for (i = 0; i < sNumParts; i++) if (sPart[i].station && k++ == sBest) best = i;
+        reach = DMIN(sPart[sLastCheck].y, sPart[best].y);
+    }
+    if (!sFinished && (sRespawnReq || m->pos[1] < sPart[lowest].y - 1500.0f
+                       || (m->floor != NULL && m->floor->object == NULL && !(m->action & ACT_FLAG_AIR)
+                           && m->floorHeight < reach - 600.0f && m->pos[1] - m->floorHeight < 100.0f)
+                       || (m->floor != NULL && m->floor->object == NULL && (m->floor->type == SURFACE_DEATH_PLANE || m->floor->type == SURFACE_VERTICAL_WIND)
+                           && m->pos[1] < m->floorHeight + 2048.0f + 400.0f)
+                       || m->pos[1] < host_water(m->pos[0], m->pos[2]) + 150.0f
+                       || ((m->action & ACT_FLAG_SWIMMING) && !in_our_env(m->pos[0], m->pos[2])) || m->health < 0x100)) {
