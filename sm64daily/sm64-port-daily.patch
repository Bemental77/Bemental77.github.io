+// Footprint and walkable top of a piece, from its collision vertices (TERRAIN_LOAD_VERTICES list).
+static void measure(struct Piece *p) {
+    const Collision *c = segmented_to_virtual(p->col);
+    s32 n, i;
+    f32 mx = 0, mz = 0, mr = 0;
+    p->minY = 1e9f; p->maxY = -1e9f;
+    if (*c++ != TERRAIN_LOAD_VERTICES) return;
+    n = *c++;
+    for (i = 0; i < n; i++, c += 3) {
+        f32 x = c[0], y = c[1], z = c[2];
+        if (y < p->minY) p->minY = y;
+        if (y > p->maxY) p->maxY = y;
+        if (absf(x) > mx) mx = absf(x);
+        if (absf(z) > mz) mz = absf(z);
+        if (sqrtf(x * x + z * z) > mr) mr = sqrtf(x * x + z * z);
+    }
+    p->rx = mx; p->rz = mz; p->r = mr;
+}
