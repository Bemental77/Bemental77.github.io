+    if (!sInited || gCurrLevelNum != sHosts[sHostIdx]) return FALSE;
+    sRespawnReq = TRUE;
+    return TRUE;
+}
+s32 daily_active(void) { return sInited && gCurrLevelNum == sHosts[sHostIdx]; }
+// Called by spawn_star (spawn_star.inc.c): a boss's star flies to the arena, not to its home level's spot.
+void daily_star_target(f32 *x, f32 *y, f32 *z) {
