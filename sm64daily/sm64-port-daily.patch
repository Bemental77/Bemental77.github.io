@@ -361,6 +364,16 @@ typedef void (*NativeBhvFunc)(void);
 static s32 bhv_cmd_call_native(void) {
     NativeBhvFunc behaviorFunc = BHV_CMD_GET_VPTR(1);
 
+#ifdef TARGET_WEB
+    // SM64 DAILY PARKOUR: a wasm function pointer is an index into the function table; anything past
+    // it would trap the whole game. Report the object and drop it instead.
+    if ((uintptr_t) behaviorFunc == 0 || (uintptr_t) behaviorFunc >= (uintptr_t) EM_ASM_INT({ return wasmTable.length; })) {
+        EM_ASM({ console.error('[daily] bad native call', $0 >>> 0, 'beh', $1, 'pos', $2, $3, $4); }, (int) (uintptr_t) behaviorFunc,
+               (int) (uintptr_t) gCurrentObject->behavior, (int) gCurrentObject->oPosX, (int) gCurrentObject->oPosY, (int) gCurrentObject->oPosZ);
+        gCurrentObject->activeFlags = ACTIVE_FLAG_DEACTIVATED;
+        return BHV_PROC_BREAK;
+    }
+#endif
     behaviorFunc();
 
     gCurBhvCommand += 2;
@@ -903,6 +916,7 @@ static BhvCommandProc BehaviorCmdTable[] = {
 };
 
 // Execute the behavior script of the current object, process the object flags, and other miscellaneous code for updating objects.
+const void *gDailyLastBeh, *gDailyLastCmd;   // SM64 DAILY PARKOUR: what was running, for a crash report
 void cur_obj_update(void) {
     UNUSED u32 unused;
 
@@ -933,7 +947,20 @@ void cur_obj_update(void) {
     // Execute the behavior script.
     gCurBhvCommand = gCurrentObject->curBhvCommand;
 
+    gDailyLastBeh = gCurrentObject->behavior;
     do {
+        gDailyLastCmd = gCurBhvCommand;
+        // SM64 DAILY PARKOUR: an object whose script pointer isn't a script would call outside the
+        // command table and kill the game. Report it once and remove the object instead.
+        if ((*gCurBhvCommand >> 24) >= sizeof(BehaviorCmdTable) / sizeof(BehaviorCmdTable[0])) {
+#ifdef TARGET_WEB
+            EM_ASM({ console.error('[daily] bad behavior script: obj model', $0, 'cmd', $1 >>> 0, 'beh', $2, 'pos', $3, $4, $5); },
+                   gCurrentObject->header.gfx.sharedChild ? 1 : 0, *gCurBhvCommand, (int) (uintptr_t) gCurrentObject->behavior,
+                   (int) gCurrentObject->oPosX, (int) gCurrentObject->oPosY, (int) gCurrentObject->oPosZ);
+#endif
+            gCurrentObject->activeFlags = ACTIVE_FLAG_DEACTIVATED;
+            return;
+        }
         bhvCmdProc = BehaviorCmdTable[*gCurBhvCommand >> 24];
         bhvProcResult = bhvCmdProc();
     } while (bhvProcResult == BHV_PROC_CONTINUE);
