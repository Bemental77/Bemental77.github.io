+        case MD_POOL: {
+            // A swimming pool in the sky: jump in, dive under a wall that reaches below the surface,
+            // climb out on a submerged step. The water is one of our own environment regions.
+            s16 ha = axis(h);
+            f32 L = rnd_f(1100, 1300), W = 320.0f, S, F, fw0, x0, z0, x1, z1;
+            struct Part *floor;
+            a = station(c, ha, rnd_f(150, 220), rnd_f(-60, 60), 300.0f, 260.0f);
+            if (!a || sNumEnv >= 6) break;
+            a->yaw = ha;
+            S = a->y - 60.0f; F = S - 520.0f;
+            floor = box_at(BK_STATION, a, a->hz + L / 2.0f, 0, F, W + 60.0f, L / 2.0f + 60.0f, 80.0f, ha);
+            if (!floor) break;
+            floor->r = sqrtf((W + 60) * (W + 60) + (L / 2 + 60) * (L / 2 + 60));
+            box_at(BK_WALL, a, a->hz + L / 2.0f, W + 30.0f, a->y, 30.0f, L / 2.0f + 60.0f, a->y - F, ha);
+            box_at(BK_WALL, a, a->hz + L / 2.0f, -(W + 30.0f), a->y, 30.0f, L / 2.0f + 60.0f, a->y - F, ha);
+            box_at(BK_WALL, a, a->hz + L + 30.0f, 0, S + 100.0f, W + 60.0f, 30.0f, S + 100.0f - F, ha);
