+static s32 sCoinTarget;
+
+static f32 generate_once(u32 seed, s32 dow) {
+    // Monday (1) easiest .. Sunday (0) hardest.
+    f32 hard = ((dow + 6) % 7) / 6.0f, secs = 0;
+    s32 used[MD_COUNT], cur, i, m, tries, sinceCheck = 0, last = -1, enemyMods = 0;
+    struct Part *s;
+
+    sRng = seed ? seed : 0x5EED1234;
+    for (i = 0; i < 8; i++) rnd_u32();
+    bzero(used, sizeof(used));
+    sNumParts = 0; sNumMods = 0; sNumDyn = 0; sNumEnv = 0; sKickboards = 0;
+
+    s = add_part(PT_CHECKER);
+    s->hx = 300.0f; s->hz = 300.0f; s->station = 1;
+    s->yaw = (s16) (rnd_u32() & 0xFFFF);
+    // Survey: start above a random in-bounds spot, high enough to clear everything near it.
+    for (tries = 0; tries < 600; tries++) {
+        f32 x = rnd_f(-5500, 5500), z = rnd_f(-5500, 5500), hi = -20000.0f, t;
+        s32 k, ok = TRUE;
+        for (k = 0; k < 9 && ok; k++) {
+            t = terrain_at(x + (k % 3 - 1) * 900.0f, z + (k / 3 - 1) * 900.0f);
+            if (t < -19000.0f) ok = FALSE;
+            if (t > hi) hi = t;
+        }
+        if (!ok) continue;
+        s->x = x; s->z = z; s->y = hi + SKY_CLEAR + 500.0f;
+        if (!blocked(s, 0)) break;
+    }
+    cur = 0;
+
+    while (secs < (sMode == MODE_BOSS ? TARGET_SECONDS * 0.6f : TARGET_SECONDS) && sNumParts < MAX_PARTS - 16) {
+        s32 got = -1, partsBefore = sNumParts, dynBefore = sNumDyn;
+        for (tries = 0; tries < 250 && got < 0; tries++) {
+            f32 w[MD_COUNT], sum = 0, r;
+            for (m = 0; m < MD_COUNT; m++) {
+                // Every course should mix the move set: unused modules are strongly preferred,
+                // and the same module never twice in a row. The challenge and the day's flavour tilt it.
+                w[m] = sModWeight[m] * sModOn[m] * (used[m] ? 0.6f : 1.6f);
+                if (sMode == MODE_CLEAR && (m == MD_ENEMIES)) w[m] *= enemyMods < 4 ? 6.0f : 1.0f;
+                if (sIslands && (m == MD_CANNON || m == MD_WING)) w[m] *= 3.0f;
+                if (m == last) w[m] = 0;
+                sum += w[m];
+            }
+            r = rnd_f(0, sum);
+            for (m = 0; m < MD_COUNT - 1 && r > w[m]; m++) r -= w[m];
+            {
+                s16 h = sPart[cur].yaw + (s16) rnd_f(-0x2400, 0x2400);
+                f32 cx = (AREA_X0 + AREA_X1) / 2, cz = (AREA_Z0 + AREA_Z1) / 2;
+                if (absf(sPart[cur].x - cx) > 6000.0f || absf(sPart[cur].z - cz) > 6000.0f || tries > 120)
+                    h = atan2s(cz - sPart[cur].z, cx - sPart[cur].x) + (s16) rnd_f(-0x4000, 0x4000);
+                if (tries > 200) h = (s16) (rnd_u32() & 0xFFFF);
+                got = build_module(m, cur, h, hard);
+            }
+        }
+        if (got < 0) {
+            // Out of room on this level (small worlds like the Courtyard): climb. A giant pole on
+            // the current platform leads to a new layer ~2100+ up, which may overlap the layers
+            // below (blocked() ignores parts that far apart vertically).
+            got = build_lift(cur);
+            m = MD_POLE;
+        }
+        if (got < 0) break;
+        used[m]++; last = m;
+        if (m == MD_ENEMIES) enemyMods++;
+        if (sNumMods < 64) { sModFirst[sNumMods] = cur; sModLand[sNumMods] = got; sModStart[sNumMods] = partsBefore; sModDynStart[sNumMods] = dynBefore; sMods[sNumMods++] = m; sModStart[sNumMods] = sNumParts; sModDynStart[sNumMods] = sNumDyn; }
+        secs += sModSeconds[m];
+        cur = got;
+        if (++sinceCheck >= 3) { sPart[cur].check = 1; sinceCheck = 0; }
+    }
+    if (sMode == MODE_BOSS) {
+        // The finale: the boss arena. Its star ends the run.
+        s32 got = -1, partsBefore = sNumParts, dynBefore = sNumDyn;
+        sArena = -1;
+        for (tries = 0; tries < 300 && got < 0; tries++) {
+            s16 h = tries < 100 ? sPart[cur].yaw + (s16) rnd_f(-0x3000, 0x3000) : (s16) (rnd_u32() & 0xFFFF);
+            got = build_module(MD_BOSS, cur, h, hard);
+        }
+        if (got < 0) return 0;
+        sPart[cur].check = 1;   // respawn right before the arena
+        if (sNumMods < 64) { sModFirst[sNumMods] = cur; sModLand[sNumMods] = got; sModStart[sNumMods] = partsBefore; sModDynStart[sNumMods] = dynBefore;
+                             sMods[sNumMods++] = MD_BOSS; sModStart[sNumMods] = sNumParts; sModDynStart[sNumMods] = sNumDyn; }
+        secs += sModSeconds[MD_BOSS];
+        cur = got;
+    }
+    sGoal = cur;
+    sPart[cur].goal = 1; sPart[cur].check = 0; sPart[cur].fk = 0;
+    sPart[cur].hx = DMAX(sPart[cur].hx, 280.0f); sPart[cur].hz = DMAX(sPart[cur].hz, 280.0f);
+    for (sNumStations = 0, i = 0; i < sNumParts; i++) if (sPart[i].station) sNumStations++;
+    {
+        // Extras draw from their own stream; the rest of the course carries on from where the old
+        // placement (any extras anywhere on a station) left the seed's stream, so the coins and
+        // enemies of every course already played are where they were.
+        u32 after = old_extras_draws(), own = sRng ^ 0x9E3779B9u;
+        sRng = own ? own : 1;
+        place_extras();
+        sRng = after;
+    }
+    place_collectibles();
+    if (sMode == MODE_COINS) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].kind == DK_COIN) t++;
+        sCoinTarget = (t * 7) / 10;
+        if (t < 20) secs = 0;      // too few coins to make a challenge of it: try another layout
+    }
+    if (sMode == MODE_RED) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].kind == DK_REDCOIN) t++;
+        if (t < 8) secs = 0;
+    }
+    if (sMode == MODE_CLEAR) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].objective) t++;
+        if (t < 6) secs = 0;
+    }
+    return secs;
+}
+
+// Everything about the course is rolled from the seed. If the seed leaves the world too little
+// room for ~2:00 (or the challenge), derive another layout seed from it, deterministically.
+static f32 sGenSecs;
+static void generate(u32 seed, s32 dow) {
+    u32 k, h = (seed ^ 0x27D4EB2Fu) * 0x165667B1u;
+    sMode = mode_for_seed(seed);
+    sBoss = sMode == MODE_BOSS ? (s32) ((h >> 13) % BOSS_COUNT) : -1;
+    sTheme = (s32) ((h >> 11) % NUM_THEMES);
+    sStyle = ((h >> 5) & 3) == 0 ? STYLE_CHECKER : STYLE_BOX;
+    sIslands = ((h >> 17) % 5) == 0;
+    gTTCSpeedSetting = (s16) ((h >> 21) % 3);   // slow, fast or random: TTC's own pieces follow it
+    {
+        // This seed's palette: a handful of modules (and moving platforms, and two enemy groups) of its own,
+        // each with its own weight — so courses differ in kind, not just in layout.
+        u32 r = h ^ 0xA5A5F00Du, j, want;
+        s32 m, i;
+        #define PRNG() (r ^= r << 13, r ^= r >> 17, r ^= r << 5, r)
+        for (m = 0; m < MD_COUNT; m++) sModOn[m] = 0;
+        sModOn[MD_HOP] = 0.6f; sModOn[MD_STEPPING] = 1.0f;
+        want = 6 + PRNG() % 6;
+        for (j = 0; j < want; j++) {
+            m = 1 + (s32) (PRNG() % (MD_COUNT - 1));
+            if (m == MD_BOSS || sModOn[m] > 0) { j--; if (PRNG() % 50 == 0) break; continue; }
+            sModOn[m] = 0.5f + (PRNG() % 100) / 66.0f;
+        }
+        if (sMode == MODE_CLEAR) sModOn[MD_ENEMIES] = DMAX(sModOn[MD_ENEMIES], 1.5f);
+        if (sIslands) { sModOn[MD_CANNON] = DMAX(sModOn[MD_CANNON], 1.5f); sModOn[MD_WING] = DMAX(sModOn[MD_WING], 1.2f); }
+        // Moving platforms and hazards: the built-in ones, plus a draw from the whole inventory (sAuto).
+        sNumPieces = NUM_BUILTIN_PIECES;
+        for (i = 0; i < NUM_BUILTIN_PIECES; i++) {
+            if (sPiece[i].col == NULL) sPiece[i].col = beh_collision(sPiece[i].beh);
+            measure(&sPiece[i]); sPieceOn[i] = (PRNG() % 100) < 35;
+        }
+        {
+            u8 *claimed = sClaimed;
+            s32 a, tries;
+            bzero(claimed, sizeof(claimed));
+            for (a = 0x00; a <= 0x15; a++) claimed[a] = 1;            // Mario, our boxes
+            for (a = 0xE2; a <= 0xFF; a++) claimed[a] = 1;            // our pieces, markers
+            for (a = 0x74; a <= 0xE1; a++) claimed[a] = 1;            // the global/common set our objects use
+            for (a = 0; a < NUM_LIB; a++) if (lib_ok(a)) { claimed[sLib[a].model] = 1; claimed[sLib[a].model2] = 1; claimed[sLib[a].model3] = 1; }
+            if (sBoss >= 0) { claimed[sBosses[sBoss].model] = 1; claimed[sBosses[sBoss].model2] = 1; }
+            if (sModOn[MD_KICKBOARD] > 0) claimed[MODEL_WF_KICKABLE_BOARD] = claimed[MODEL_WF_KICKABLE_BOARD_FELLED] = 1;
+            // Two mini worlds for this seed (used if MD_ISLAND is in its palette), in free slots.
+            {
+                s32 t;
+                for (t = 0; t < 2; t++) {
+                    s32 sl;
+                    sIsleOn[t] = (s32) (PRNG() % NUM_ISLES);
+                    measure_isle(sIsleOn[t]);
+                    for (sl = 0x53; sl >= 0x16 && claimed[sl]; sl--) ;
+                    sIsleSlot[t] = (u8) sl; claimed[sl] = 1;
+                }
+            }
+            claimed[MODEL_TRAMPOLINE] = claimed[MODEL_TRAMPOLINE_CENTER] = claimed[MODEL_TRAMPOLINE_BASE] = 1;
+            if (sGroupB == 15) claimed[MODEL_CHAIN_CHOMP] = claimed[MODEL_METALLIC_BALL] = claimed[MODEL_WOODEN_POST] = 1;
+            s32 bare = 0;
+#ifdef TARGET_WEB
+            bare = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyBare) ? 1 : 0; });   // test hook: no inventory objects
+#endif
+            for (tries = 0; tries < (bare ? 0 : 600) && sNumPieces < MAX_PIECES && sNumPieces < NUM_BUILTIN_PIECES + 30; tries++) {
+                const struct AutoPiece *ap = &sAuto[PRNG() % NUM_AUTO];
+                struct Piece *pc = &sPiece[sNumPieces];
+                const Collision *col = beh_collision(ap->beh);
+                s32 slot = ap->model, dup = 0, q;
+                for (q = NUM_BUILTIN_PIECES; q < sNumPieces; q++) if (sPiece[q].beh == ap->beh) dup = 1;
+                if (dup) continue;
+                if (!ap->glob && claimed[slot]) {
+                    // Its home slot is taken: any free level-geometry slot will do for a model it doesn't switch.
+                    for (slot = 0x16; slot <= 0x53 && claimed[slot]; slot++) ;
+                    if (slot > 0x53) continue;
+                }
+                bzero(pc, sizeof(*pc));
+                pc->name = ap->name; pc->beh = ap->beh; pc->geo = ap->glob ? NULL : ap->geo; pc->bp = ap->bp; pc->model = (u8) slot;
+                if (col != NULL) { pc->col = col; measure(pc); }
+                if (ap->role == 3) {
+                    // Life on the course: NPCs, signs, 1-ups, hearts, crazy boxes, butterflies, Moneybags...
+                    pc->role = R_EXTRA;
+                    if (col == NULL) { pc->minY = 0; pc->maxY = 100; pc->rx = pc->rz = pc->r = 100; }
+                    if (pc->r > 700.0f) continue;
+                } else if (ap->role == 1) {
+                    pc->role = R_HAZ_ANY;
+                    if (col == NULL) { pc->minY = 0; pc->maxY = 200; pc->rx = pc->rz = pc->r = 200; }
+                    if (pc->r > 1200.0f) continue;
+                } else {
+                    // A platform needs a top to land on, and must fit in a gap.
+                    if (col == NULL || pc->rx < 110.0f || pc->rz < 110.0f || pc->r > 1600.0f || pc->maxY - pc->minY > 2400.0f) continue;
+                    pc->role = (pc->rx > pc->rz * 2.0f || pc->rz > pc->rx * 2.0f) ? R_LONGSTEP : R_STEP;
+                }
+                if (!ap->glob) claimed[slot] = 1;
+                sPieceOn[sNumPieces] = 1;
+                sNumPieces++;
+            }
+            sNumAutoDrawn = sNumPieces - NUM_BUILTIN_PIECES;
+        }
+        sGroupA = sGroupsA[PRNG() % sizeof(sGroupsA)];
+        sGroupB = sGroupsB[PRNG() % sizeof(sGroupsB)];
+        // A boss's model lives in its group's slots: that group is the course's group.
+        if (sBoss == BOSS_KING_BOBOMB) sGroupA = 4;
+        if (sBoss == BOSS_BIG_BULLY) sGroupA = 3;
+        if (sBoss == BOSS_WIGGLER) sGroupA = 12;
+        if (sBoss == BOSS_BIG_BOO) sGroupA = 10;
+        if (sBoss == BOSS_KING_WHOMP) sGroupB = 15;
+        if (sBoss == BOSS_CHESTS) sGroupB = 14;
+        settle_slots();
+        #undef PRNG
+    }
+    for (k = 0; k < 8; k++) {
+        if ((sGenSecs = generate_once(seed + k * 0x9E3779B9u, dow)) >= TARGET_SECONDS * 0.85f) return;
+    }
+    sGenSecs = generate_once(seed, dow);
+}
+
+// Test hook (exported): build (but don't spawn) the course a seed gives over the current world;
+// returns a hash of every part's placement. daily_debug_gen_info() = stations*10000 + seconds.
+u32 daily_debug_gen(u32 seed, s32 dow) {
+    u32 h = 2166136261u;
+    s32 i;
+    generate(seed, dow);
+    for (i = 0; i < sNumParts; i++) {
+        s32 v[5] = { (s32) sPart[i].x, (s32) sPart[i].y, (s32) sPart[i].z, sPart[i].type, sPart[i].piece };
+        s32 j;
+        for (j = 0; j < 5; j++) { h ^= (u32) v[j]; h *= 16777619u; }
+    }
+    return h;
+}
+s32 daily_debug_gen_info(void) { return sNumStations * 10000 + (s32) sGenSecs; }
+s32 daily_debug_mode(void) { return sMode; }
+s32 daily_debug_auto(void) { return sNumAutoDrawn; }
+// Test hook: which of our spawn tables the object running last belongs to (a crash report):
+// 1000+k sAuto[k], 2000+k sLib[k], 3000+k sPiece[k], 4000+k dyn kind k, 5000 platform, 6000 boss, -1 unknown.
+extern const void *gDailyLastBeh, *gDailyLastCmd;
+s32 daily_debug_last_beh(s32 f) {
+    const void *b = gDailyLastBeh;
+    s32 k;
+    if (f == 1) return (s32) (uintptr_t) gDailyLastCmd - (s32) (uintptr_t) b;
+    for (k = 0; k < NUM_AUTO; k++) if (segmented_to_virtual((void *) sAuto[k].beh) == b) return 1000 + k;
+    for (k = 0; k < NUM_LIB; k++) if (segmented_to_virtual((void *) sLib[k].beh) == b) return 2000 + k;
+    for (k = 0; k < NUM_PIECES; k++) if (segmented_to_virtual((void *) sPiece[k].beh) == b) return 3000 + k;
+    for (k = 0; k < DK_COUNT; k++) if (k != DK_BOSS && k != DK_LIB && segmented_to_virtual((void *) dyn_beh((u8) k)) == b) return 4000 + k;
+    if (segmented_to_virtual((void *) bhvDailyPlatform) == b) return 5000;
+    if (sBoss >= 0 && segmented_to_virtual((void *) sBosses[sBoss].beh) == b) return 6000;
+    return -1;
+}
+// Test hook: spawn inventory object k (sAuto[k]) 300 in front of Mario, the way the course would.
+s32 daily_debug_spawn_auto(s32 k) {
+    const struct AutoPiece *ap = &sAuto[k];
+    struct MarioState *m = gMarioState;
+    struct Object *o;
+    if (!ap->glob) load_model(0x52, ap->geo);
+    o = spawn_object_abs_with_rot(gMarioObject, 0, ap->glob ? ap->model : 0x52, ap->beh,
+                                  (s16) (m->pos[0] + sins(m->faceAngle[1]) * 300.0f), (s16) m->pos[1], (s16) (m->pos[2] + coss(m->faceAngle[1]) * 300.0f), 0, 0, 0);
+    o->oBehParams = ap->bp; o->oBehParams2ndByte = (ap->bp >> 16) & 0xFF; o->parentObj = o;
+    return 1;
+}
+// Test hook: how many parts of the current course use inventory object k (sAuto[k]); k = -1 -> NUM_AUTO.
+s32 daily_debug_used_auto(s32 k) {
+    s32 i, n = 0;
+    if (k < 0) return NUM_AUTO;
+    for (i = 0; i < sNumParts; i++) if (sPart[i].type == PT_PIECE && sPiece[sPart[i].piece].beh == sAuto[k].beh) n++;
+    return n;
+}
+s32 daily_debug_modules(s32 i) { return i < sNumMods ? sMods[i] : -1; }
+// Test hook: module k's [0] id, [1] the station it starts from, [2] the station it lands on.
+// [3] its first part, [4] one past its last part, [5] its first dyn, [6] one past its last dyn.
+s32 daily_debug_mod_info(s32 k, s32 f) {
+    if (k >= sNumMods) return -1;
+    switch (f) { case 0: return sMods[k]; case 1: return sModFirst[k]; case 2: return sModLand[k]; case 3: return sModStart[k];
+                 case 4: return sModStart[k + 1]; case 5: return sModDynStart[k]; default: return sModDynStart[k + 1]; }
+}
+s32 daily_debug_num_parts(void) { return sNumParts; }
+// Test hook: the name of the SM64 piece a part is (0 if it is none).
+s32 daily_debug_piece_name(s32 i) { return sPart[i].type == PT_PIECE ? (s32) (uintptr_t) sPiece[sPart[i].piece].name : 0; }
+// Test hook: part i's [0..2] x y z, [3] type, [4] box kind, [5] hx, [6] hz, [7] yaw, [8] param, [9] kind.
+// Test hook: pairs of parts from different modules (or extras) that occupy the same space.
+// k = -1: the count; k >= 0: pair k as i * 1000 + j.
+s32 daily_debug_overlap(s32 k) {
+    s32 i, j, n = 0;
+    struct Shape a, b;
+    for (i = 0; i < sNumParts; i++) {
+        if (!part_shape(&sPart[i], &a)) continue;
+        for (j = i + 1; j < sNumParts; j++) {
+            s32 mi = module_of(i), mj = module_of(j);
+            if (mi == mj && mi >= 0) continue;
+            if (!part_shape(&sPart[j], &b)) continue;
+            if (!shapes_meet(&a, &b, 20.0f, 20.0f)) continue;
+            if (k == n) return i * 1000 + j;
+            n++;
+        }
+    }
+    return k < 0 ? n : -1;
+}
+// Test hook: live objects wearing a model their behavior never uses (sModelGeo); k = -1 the count,
+// k >= 0 the k-th one's behavior address.
+s32 daily_debug_bad_models(s32 k) {
+    s32 i, n = 0;
+    for (i = 0; i < NUM_OBJ_LISTS; i++) {
+      struct ObjectNode *head = &gObjectLists[i], *nd;
+      for (nd = head->next; nd != head; nd = nd->next) {
+        struct Object *ob = (struct Object *) nd;
+        s32 t, known = 0, ok = 0;
+        if (ob->activeFlags == ACTIVE_FLAG_DEACTIVATED || ob->header.gfx.sharedChild == NULL) continue;
+        for (t = 0; t < NUM_MODEL_GEO && !ok; t++) {
+            s32 sl;
+            if (segmented_to_virtual((void *) sModelGeo[t].beh) != ob->behavior) continue;
+            known = 1;
+            for (sl = 1; sl < 256 && !ok; sl++) if (gLoadedGraphNodes[sl] == ob->header.gfx.sharedChild && sSlotGeo[sl] == sModelGeo[t].geo) ok = 1;
+        }
+        for (t = 0; t < NUM_PIECES && known && !ok; t++) {   // or the geo we load that piece with
+            s32 sl;
+            if (sPiece[t].geo == NULL || segmented_to_virtual((void *) sPiece[t].beh) != ob->behavior) continue;
+            for (sl = 1; sl < 256 && !ok; sl++) if (gLoadedGraphNodes[sl] == ob->header.gfx.sharedChild && sSlotGeo[sl] == sPiece[t].geo) ok = 1;
+        }
+        if (!known || ok) continue;
+        if (k == n) {   // its behavior's name
+            for (t = 0; t < NUM_MODEL_GEO; t++) if (segmented_to_virtual((void *) sModelGeo[t].beh) == ob->behavior) return (s32) (uintptr_t) sModelGeo[t].name;
+            return 1;
+        }
+        n++;
+      }
+    }
+    return k < 0 ? n : 0;
+}
+// Test hook: enemies within `d` of a cannon (horizontally, and within 600 vertically).
+s32 daily_debug_near_cannon(s32 d) {
+    s32 i, j, n = 0;
+    for (i = 0; i < sNumParts; i++) {
+        if (sPart[i].type != PT_OBJ || sPart[i].kind != OK_CANNON) continue;
+        for (j = 0; j < sNumDyn; j++) {
+            f32 dx = sDyn[j].x - sPart[i].x, dz = sDyn[j].z - sPart[i].z;
+            if (!is_enemy(sDyn[j].kind)) continue;
+            if (dx * dx + dz * dz < (f32) d * d && absf(sDyn[j].y - sPart[i].y) < 600.0f) n++;
+        }
+    }
+    return n;
+}
+s32 daily_debug_part(s32 i, s32 f) {
+    struct Part *p = &sPart[i];
+    switch (f) { case 0: return (s32) p->x; case 1: return (s32) p->y; case 2: return (s32) p->z; case 3: return p->type; case 4: return p->box;
+                 case 5: return (s32) p->hx; case 6: return (s32) p->hz; case 7: return p->yaw; case 8: return p->param;
+                 case 10: return (s32) top_of(p); case 11: return p->type == PT_PIECE ? sPiece[p->piece].role : -1;
+                 case 12: return p->type == PT_PIECE ? (s32) sPiece[p->piece].rx : (s32) p->hx;
+                 case 13: return p->type == PT_PIECE ? (s32) sPiece[p->piece].rz : (s32) p->hz;
+                 case 14: return p->obj != NULL ? (s32) p->obj->oCollisionDistance : -1;
+                 case 15: return p->pitch;
+                 default: return p->kind; }
+}
