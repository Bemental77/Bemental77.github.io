+
+static s32 station_number(s32 part) {
+    s32 i, n = 0;
+    for (i = 0; i <= part; i++) if (sPart[i].station) n++;
+    return n - 1;
+}
+
+static s16 heading_from(s32 i) {
+    s32 j;
+    for (j = i + 1; j < sNumParts && !sPart[j].station; j++) ;
+    if (j >= sNumParts) return sPart[i].yaw;
+    return atan2s(sPart[j].z - sPart[i].z, sPart[j].x - sPart[i].x);
+}
+
+static void put_mario_on(s32 i) {
+    struct MarioState *m = gMarioState;
+    struct Part *p = &sPart[i];
+    mario_stop_riding_and_holding(m);
+    m->pos[0] = p->x; m->pos[1] = p->y + 80.0f; m->pos[2] = p->z;
+    m->vel[0] = m->vel[1] = m->vel[2] = 0.0f;
+    m->forwardVel = 0.0f;
+    m->faceAngle[0] = 0;
