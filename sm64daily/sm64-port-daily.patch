+            n = station(b, ha, rnd_f(150, 220), rnd_f(-60, 60), rnd_f(260, 320), rnd_f(260, 320));
+            break;
+        }
+    }
+    if (n == NULL) { sNumParts = start; sNumDyn = startDyn; sNumEnv = startEnv; return -1; }
+    for (i = start; i < sNumParts; i++) {
+        if (sPart[i].type == PT_POLE || sPart[i].type == PT_FIREBAR || sPart[i].type == PT_OBJ || sPart[i].type == PT_DECOR
+            || (sPart[i].type == PT_PIECE && sPart[i].h == 0)) continue;
+        if (blocked(&sPart[i], cur)) { sNumParts = start; sNumDyn = startDyn; sNumEnv = startEnv; return -1; }
+    }
+    // Enemies on a non-clear day are obstacles, not targets.
+    if (sMode != MODE_CLEAR) for (i = startDyn; i < sNumDyn; i++) sDyn[i].objective = 0;
+    return (s32) (n - sPart);
+}
