+// The day's enemy groups (and its boss) are rolled after the inventory pieces took their model
+// slots, so a piece can hold a slot one of the day's enemies loads its model into — the enemy then
+// wears the piece's model or the piece the enemy's. Such pieces move to a free slot.
+static u8 sPieceOn[128];
+static void settle_slots(void) {
+    u8 need[256];
+    s32 i, s;
+    bzero(need, sizeof(need));
+    for (i = 0; i < NUM_LIB; i++) if (lib_ok(i) && sLib[i].group != 1) need[sLib[i].model] = need[sLib[i].model2] = need[sLib[i].model3] = 1;
+    if (sBoss >= 0) need[sBosses[sBoss].model] = need[sBosses[sBoss].model2] = 1;
+    if (sGroupB == 15) need[MODEL_CHAIN_CHOMP] = need[MODEL_METALLIC_BALL] = need[MODEL_WOODEN_POST] = 1;
+    need[MODEL_NONE] = 0;
+    for (i = 0; i < 256; i++) if (need[i]) sClaimed[i] = 1;
+    for (i = NUM_BUILTIN_PIECES; i < sNumPieces; i++) {
+        if (sPiece[i].geo == NULL || !need[sPiece[i].model]) continue;
+        for (s = FREE_SLOT_LO; s <= FREE_SLOT_HI && sClaimed[s]; s++) ;
+        if (s > FREE_SLOT_HI) { sPieceOn[i] = 0; continue; }
+        sPiece[i].model = (u8) s; sClaimed[s] = 1;
+    }
+    for (i = 0; i < 2; i++) {
+        if (!need[sIsleSlot[i]]) continue;
+        for (s = FREE_SLOT_LO; s <= FREE_SLOT_HI && sClaimed[s]; s++) ;
+        if (s <= FREE_SLOT_HI) { sIsleSlot[i] = (u8) s; sClaimed[s] = 1; }
+    }
+}
+
+// Children and model switches: a hidden Moneybag spawns MODEL_MONEYBAG (0x66), a slot that holds
+// the Chain Chomp or Mr. I's iris in other enemy groups (model_ids.h:433,445,450). Every
+// (behavior, model id) pair SM64 uses has its geo in sModelGeo (gen_models.py); when the slot holds
+// something else, the geo is loaded into a free slot (once) and that slot is used instead.
+static s32 sNoRemap;   // test hook (window.sm64DailyNoRemap): measure the course without it
+u32 daily_model_for(u32 model, const void *beh) {
+    const GeoLayout *want = NULL;
+    s32 i, s;
+    if (model == 0 || model >= 256 || beh == NULL || sNoRemap || !daily_active()) return model;
+    for (i = 0; i < NUM_MODEL_GEO; i++) {
+        if (sModelGeo[i].model != model || segmented_to_virtual((void *) sModelGeo[i].beh) != beh) continue;
+        if (sSlotGeo[model] == sModelGeo[i].geo) return model;   // any of the pair's geos will do
+        if (want == NULL) want = sModelGeo[i].geo;
+    }
+    if (want == NULL) return model;
+    for (s = 1; s < 256; s++) if (sSlotGeo[s] == want && gLoadedGraphNodes[s] != NULL) return (u32) s;
+    for (s = FREE_SLOT_LO; s <= FREE_SLOT_HI && sClaimed[s]; s++) ;
+    if (s > FREE_SLOT_HI) return model;
+    sClaimed[s] = 1;
+    load_model((u8) s, want);
+    return (u32) s;
+}
+
+static s32 sNumAutoDrawn;   // this seed's set of moving platforms (generate)
+static s32 pick_step_piece(void) {
+    s32 tries;
+    for (tries = 0; tries < 80; tries++) {
+        s32 i = rnd_i(NUM_PIECES);
+        if ((sPiece[i].role == R_STEP || sPiece[i].role == R_LONGSTEP) && (sPieceOn[i] || tries > 60)) return i;
+    }
+    return 0;
+}
+
+// Would a cannon shot at `pitch` from (sx, sy, sz) along yaw land on station b? Simulates SM64's own
+// ACT_SHOT_FROM_CANNON: 100 at the aim, gravity 1/frame to -75, forward speed -0.05/frame (above).
+static s32 cannon_lands(f32 sx, f32 sy, f32 sz, s16 yaw, s16 pitch, struct Part *b) {
+    f32 x = sx + 120.0f * coss(pitch) * sins(yaw), y = sy + 120.0f * sins(pitch), z = sz + 120.0f * coss(pitch) * coss(yaw);
+    f32 vy = 100.0f * sins(pitch), f = 100.0f * coss(pitch);
+    s32 t;
+    for (t = 0; t < 900; t++) {
+        f32 nx = x + f * sins(yaw), nz = z + f * coss(yaw), ny = y + vy, dx, dz, lx, lz;
+        dx = nx - b->x; dz = nz - b->z;
+        lx = dx * coss(b->yaw) - dz * sins(b->yaw); lz = dx * sins(b->yaw) + dz * coss(b->yaw);
+        if (absf(lx) < b->hx && absf(lz) < b->hz && ny <= b->y && y >= b->y - 5.0f)   // crosses the top inside the footprint
+            return absf(lx) < b->hx - 100.0f && absf(lz) < b->hz - 100.0f;
+        if (absf(lx) < b->hx && absf(lz) < b->hz && ny < b->y) return FALSE;              // hit its side
+        x = nx; y = ny; z = nz;
+        vy -= 1.0f; if (vy < -75.0f) vy = -75.0f;
+        f -= 0.05f; if (f < 10.0f) f = 10.0f;
+        if (y < b->y - 3000.0f) return FALSE;
+    }
+    return FALSE;
+}
+// The middle of the widest run of pitches that land. A shot covers ~10000*sin(2*pitch) on the level,
+// so the window is narrow; it must be at least ~1 degree (3 x 0x40) wide — the stick aims in steps
+// of stickY*10 (act_in_cannon), and the reticle shows the aim.
+static s16 cannon_aim_upto(f32 sx, f32 sy, f32 sz, s16 yaw, struct Part *b, s32 maxPitch, s32 minRun) {
+    s32 p, run = 0, bestRun = 0, bestMid = -1;
+    for (p = 0x0080; p <= maxPitch; p += 0x40) {
+        if (cannon_lands(sx, sy, sz, yaw, (s16) p, b)) {
+            run++;
+            if (run > bestRun) { bestRun = run; bestMid = p - (run - 1) * 0x20; }
+        } else run = 0;
+    }
+    return bestRun >= minRun ? (s16) bestMid : -1;
+}
+// Cannon modules: flat shots only — a high lob is too touchy to make the only way across.
+static s16 cannon_aim(f32 sx, f32 sy, f32 sz, s16 yaw, struct Part *b) { return cannon_aim_upto(sx, sy, sz, yaw, b, 0x2400, 3); }
+
+static s16 axis(s16 h) { return (s16) (((h + 0x2000) & 0xC000)); }   // nearest of the four axis headings
+
+static void add_capbox(struct Part *a, f32 fw, f32 sd, s32 content) {
+    f32 x, z;
+    struct Dyn *d;
+    local_pt(a, fw, sd, &x, &z);
+    d = add_dyn(DK_CAPBOX, x, a->y + 210.0f, z, (s32) (a - sPart));
+    if (d) d->bp = (1u << 24) | ((u32) content << 16);   // top byte set: always solid, no cap switch needed (exclamation_box.inc.c:41-45)
+}
+static void add_enemy(u8 kind, struct Part *a, f32 fw, f32 sd) {
+    f32 x, z;
+    struct Dyn *d;
+    local_pt(a, fw, sd, &x, &z);
+    d = add_dyn(kind, x, a->y + (kind == DK_FLYGUY ? 260.0f : 40.0f), z, (s32) (a - sPart));
+    if (d) { d->objective = 1; if (kind == DK_GOOMBA_BIG) d->bp = 1u << 16; }
+}
+
+// Build one module after station `cur`. Returns the index of its landing station, or -1 (rolled back).
+// Level ground Mario can run across: dry, and none of the floors that hurt, sink, warp or blow.
+static s32 ground_ok(struct Surface *fl, f32 x, f32 z, f32 y) {
+    s16 t = fl->type;
+    if (host_water(x, z) > y - 50.0f) return FALSE;
+    if (t == SURFACE_BURNING || t == SURFACE_DEATH_PLANE || t == SURFACE_VERTICAL_WIND || t == SURFACE_HORIZONTAL_WIND
+        || (t >= SURFACE_SHALLOW_QUICKSAND && t <= SURFACE_MOVING_QUICKSAND) || t == SURFACE_INSTANT_QUICKSAND
+        || t == SURFACE_DEEP_MOVING_QUICKSAND || t == SURFACE_SHALLOW_MOVING_QUICKSAND || t == SURFACE_INSTANT_MOVING_QUICKSAND
+        || (t >= SURFACE_INSTANT_WARP_1B && t <= SURFACE_INSTANT_WARP_1E) || t == SURFACE_WARP || t == SURFACE_LOOK_UP_WARP
+        || t == SURFACE_TIMER_START || t == SURFACE_TIMER_END) return FALSE;
+    return TRUE;
+}
+
+// A pad resting on the level's ground at (x, z): every corner of its footprint must have walkable
+// ground within 70 of the others; its top sits 20 above the highest. Returns the top, or -1e9.
+static f32 ground_pad_top(f32 x, f32 z, f32 half, f32 yHint) {
+    struct Surface *fl;
+    f32 lo = 1e9f, hi = -1e9f;
+    s32 k;
+    for (k = 0; k < 5; k++) {
+        f32 px = x + (k == 1 ? half : k == 2 ? -half : 0), pz = z + (k == 3 ? half : k == 4 ? -half : 0);
+        f32 t = find_floor(px, yHint + 400.0f, pz, &fl);
+        if (fl == NULL || fl->object != NULL || !ground_ok(fl, px, pz, t)) return -1e9f;
+        if (t < lo) lo = t;
+        if (t > hi) hi = t;
+    }
+    return hi - lo > 70.0f ? -1e9f : hi + 20.0f;
+}
+
+static s32 build_module(s32 m, s32 cur, s16 h, f32 hard) {
+    struct Part *c = &sPart[cur], *n = NULL, *a, *b;
+    s32 start = sNumParts, startDyn = sNumDyn, startEnv = sNumEnv, i;
+    f32 g = 150.0f + 70.0f * hard;     // edge-to-edge hop gap scale (a running single jump covers ~600)
+
+    switch (m) {
+        case MD_HOP:
+            n = station(c, h, rnd_f(150, 240 + 80 * hard), rnd_f(-150, 150), rnd_f(200, 300), rnd_f(200, 300));
+            if (n && rnd_i(100) < 25) n->fk = rnd_i(2) ? BK_MUD : BK_ICE;
+            break;
+
+        case MD_STEPPING: case MD_DOUBLE_STEPPING:
+            // One or two real SM64 moving/rotating/sinking pieces as the only footing across a gap.
+            a = c;
+            for (i = 0; i < (m == MD_DOUBLE_STEPPING ? 2 : 1); i++) {
+                a = piece_after(a, pick_step_piece(), h, rnd_f(g * 0.6f, g), rnd_f(-60, 60));
+                if (!a) break;
+            }
+            if (a) n = station(a, h, rnd_f(g * 0.6f, g), rnd_f(-80, 80), rnd_f(220, 300), rnd_f(220, 300));
+            break;
+
+        case MD_THWOMP: case MD_PENDULUM: case MD_FIREBAR:
+            // A long connector you must cross while something tries to stop you.
+            n = station(c, h, rnd_f(150, 240), rnd_f(-80, 80), m == MD_FIREBAR ? 520.0f : 280.0f, m == MD_FIREBAR ? 520.0f : rnd_f(650, 800));
+            if (!n) break;
+            b = add_part(m == MD_FIREBAR ? PT_FIREBAR : PT_PIECE);
+            if (!b) { n = NULL; break; }
+            b->x = n->x; b->z = n->z; b->yaw = h;
+            if (m == MD_THWOMP) { b->piece = 12; b->y = n->y; b->r = 1; }
+            if (m == MD_PENDULUM) { b->piece = 13; b->yaw = h + 0x4000; b->y = n->y + 60.0f - sPiece[13].minY; b->r = 1; }   // bob bottom swings just above the floor
+            if (m == MD_FIREBAR) { b->y = n->y; b->r = 1; }
+            b->h = 0;
+            break;
+
+        case MD_LONG:
+            // Runway long enough to reach full speed, then a gap no running jump clears (~600) but a
+            // 48-speed half-gravity long jump does.
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 220.0f, rnd_f(450, 550));
+            if (a) n = station(a, h, rnd_f(700, 780 + 60 * hard), rnd_f(-140, -40), rnd_f(240, 300), rnd_f(240, 300));
+            break;
+
+        case MD_POWER_STEP:
+            // A wall taller than a single jump (~310) but inside a double jump / backflip / sideflip.
+            a = station(c, h, rnd_f(150, 240), rnd_f(-60, 60), rnd_f(260, 320), rnd_f(260, 320));
+            if (a) {
+                f32 dy = rnd_f(370, 410 + 20 * hard);
+                n = station(a, h, 0.0f, dy, rnd_f(220, 280), rnd_f(220, 260));
+                if (n) n->h = dy + 200.0f;
+            }
+            break;
+
+        case MD_TRIPLE:
+            // A long runway, then a ledge above double-jump height (~450) but inside triple (~595).
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 260.0f, rnd_f(950, 1050));
+            if (a) {
+                f32 dy = rnd_f(490, 530 + 20 * hard);
+                n = station(a, h, rnd_f(60, 110), dy, rnd_f(260, 320), rnd_f(260, 320));
+                if (n) n->h = dy + 300.0f;
+            }
+            break;
+
+        case MD_WALLKICK: {
+            // A chimney: a floor between two walls; the way out is on top of the right wall,
+            // higher than any jump from the floor (triple ~595), so it takes wall kicks (~480 each).
+            // Variants: which wall has the way out on top, how tall (2-3 kicks), how wide.
+            f32 H = rnd_f(750, 950 + 300 * hard), inner = rnd_f(380, 520), side;   // playtest: 230-290 was too tight to kick between
+            s32 flip = rnd_i(2);
+            s16 hl = h + 0x4000;
+            struct Part *l, *r;
+            a = station(c, h, rnd_f(120, 200), rnd_f(-200, -80), inner / 2.0f, rnd_f(260, 320));
+            if (!a) break;
+            side = inner / 2.0f + 40.0f;
+            l = add_part(PT_BOX); r = add_part(PT_BOX);
+            if (!l || !r) break;
+            l->box = BK_WALL; l->hx = 40.0f; l->hz = a->hz; l->h = H + 140.0f; l->yaw = h;
+            if (flip) { hl = h - 0x4000; }
+            l->x = a->x + sins(hl) * side; l->z = a->z + coss(hl) * side; l->y = a->y + H;
+            *r = *l;
+            r->x = a->x - sins(hl) * side; r->z = a->z - coss(hl) * side; r->y = a->y + H - 40.0f;
+            n = add_part(PT_CHECKER);
+            if (!n) break;
+            n->station = 1; n->yaw = h; n->hx = rnd_f(200, 260); n->hz = rnd_f(220, 280);
+            {
+                f32 out = side + 40.0f + n->hx - 80.0f;
+                n->x = a->x - sins(hl) * out; n->z = a->z - coss(hl) * out; n->y = r->y;
+            }
+            break;
+        }
+
+        case MD_POLE: {
+            // Whomp's Fortress's giant pole: climb it, jump from the top (pole top ~2000 + ~480).
+            struct Part *pole;
+            a = station(c, h, rnd_f(150, 240), rnd_f(-80, 60), rnd_f(280, 340), rnd_f(280, 340));
+            if (!a) break;
+            pole = add_part(PT_POLE);
+            if (!pole) break;
+            pole->x = a->x + sins(h) * (a->hz - 140.0f); pole->z = a->z + coss(h) * (a->hz - 140.0f); pole->y = a->y;
+            pole->r = 1; pole->h = 0;
+            n = add_part(PT_CHECKER);
+            if (!n) break;
+            n->station = 1; n->yaw = h; n->hx = rnd_f(240, 300); n->hz = rnd_f(240, 300);
+            {
+                f32 d = (a->hz - 140.0f) + rnd_f(180, 260) + n->hz;
+                n->x = a->x + sins(h) * d; n->z = a->z + coss(h) * d; n->y = a->y + rnd_f(2050, 2250 + 100 * hard);
+            }
+            n->h = 160.0f;
+            break;
+        }
+
+        case MD_SLIDE: {
+            // A steep very-slippery ramp down to the next platform.
+            f32 L = rnd_f(1100, 1400), ang = rnd_f(25, 32) * 182.04f, drop, run, d;
+            a = add_part(PT_BOX);
+            if (!a) break;
+            a->box = BK_SLIDE; a->hx = rnd_f(220, 280); a->hz = L / 2.0f; a->h = 60.0f;
+            drop = L * sins((s16) ang); run = L * coss((s16) ang);
+            d = extent_along(c, h) + 20.0f + run / 2.0f;
+            a->yaw = h; a->pitch = (s16) ang;
+            a->x = c->x + sins(h) * d; a->z = c->z + coss(h) * d; a->y = c->y - 10.0f - drop / 2.0f;
+            n = add_part(PT_CHECKER);
+            if (!n) break;
+            n->station = 1; n->yaw = h; n->hx = rnd_f(280, 340); n->hz = rnd_f(280, 340);
+            d += run / 2.0f + 60.0f + n->hz;
+            n->x = c->x + sins(h) * d; n->z = c->z + coss(h) * d; n->y = c->y - drop - 40.0f;
+            break;
+        }
+
+        case MD_ENEMIES: {
+            // An arena with this course's cast: the global enemies plus its two groups (sLib). Bullies only
+            // die in lava, so an arena with one gets a lava moat below its rim.
