+static s8 sStickX, sStickY;
+
+void daily_set_pad(int buttons, int stickX, int stickY) {
+    sButtons = (u16) buttons;
+    sStickX = (s8) (stickX > 80 ? 80 : stickX < -80 ? -80 : stickX);
+    sStickY = (s8) (stickY > 80 ? 80 : stickY < -80 ? -80 : stickY);
+}
+
+static void controller_page_init(void) {
+}
+
+static void controller_page_read(OSContPad *pad) {
+    pad->button |= sButtons;
+    if (sStickX != 0 || sStickY != 0) {
+        pad->stick_x = sStickX;
+        pad->stick_y = sStickY;
+    }
+}
+
+struct ControllerAPI controller_page = { controller_page_init, controller_page_read };
+#endif
