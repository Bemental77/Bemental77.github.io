+        }
+
+        case MD_UPDRAFT: {
+            // A wind column (SURFACE_VERTICAL_WIND; on a course it holds Mario ~1210 above its pad —
+            // apply_vertical_wind) lifts him to a ledge far above any jump.
+            a = station(c, h, rnd_f(150, 220), rnd_f(-60, 60), 280.0f, 280.0f);
+            if (!a) break;
+            b = add_part(PT_BOX);
+            if (!b) break;
+            b->box = BK_WINDPAD; b->hx = 220.0f; b->hz = 220.0f; b->h = 60.0f; b->yaw = h;
+            put_ahead(b, a, h, rnd_f(200, 260), -250.0f, b->hz);
+            n = station(b, h, 80.0f, 900.0f, rnd_f(260, 320), rnd_f(260, 320));
