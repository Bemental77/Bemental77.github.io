+            n->yaw = ha;
+            local_pt(a, a->hz + L + 60.0f + n->hz, 0, &n->x, &n->z); n->y = S + 120.0f;   // ~140 above the step: an easy hop out
+            fw0 = a->hz; local_pt(a, fw0, -W, &x0, &z0); local_pt(a, fw0 + L, W, &x1, &z1);
+            {
+                struct Env *e = &sEnv[sNumEnv++];
+                e->id = 40 + sNumEnv; e->x0 = (s16) DMIN(x0, x1); e->x1 = (s16) DMAX(x0, x1);
+                e->z0 = (s16) DMIN(z0, z1); e->z1 = (s16) DMAX(z0, z1); e->y = (s16) S;
+            }
+            {
+                f32 cx, cz;
+                local_pt(a, a->hz + L / 2.0f, 0, &cx, &cz);
+                decor_at(BK_WATERVIS, cx, cz, S, W, L / 2.0f, S - F, ha);
+            }
+            {   // coins along the dive line (they also heal)
+                s32 k;
+                for (k = 0; k < 3; k++) {
+                    f32 x, z;
+                    local_pt(a, a->hz + L * (0.3f + 0.15f * k), 0, &x, &z);
+                    add_dyn(DK_COIN, x, F + 120.0f, z, (s32) (a - sPart));
