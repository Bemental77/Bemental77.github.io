+static void load_lib_models(void) {
+    s32 i;
+    for (i = 0; i < NUM_LIB; i++) {
+        if (sLib[i].group == 1 || !lib_ok(i)) continue;
+        if (sLib[i].geo) load_model(sLib[i].model, sLib[i].geo);
+        if (sLib[i].geo2) load_model(sLib[i].model2, sLib[i].geo2);
+        if (sLib[i].geo3) load_model(sLib[i].model3, sLib[i].geo3);
+    }
+    load_model(MODEL_TRAMPOLINE, springboard_top_geo);           // unused by every level (model_ids.h:521-523)
+    load_model(MODEL_TRAMPOLINE_CENTER, springboard_spring_geo);
+    load_model(MODEL_TRAMPOLINE_BASE, springboard_bottom_geo);
+    if (sGroupB == 15) {   // the Chain Chomp's group
+        load_model(MODEL_CHAIN_CHOMP, chain_chomp_geo);
+        load_model(MODEL_METALLIC_BALL, metallic_ball_geo);
+        load_model(MODEL_WOODEN_POST, wooden_post_geo);
+    }
+    if (sKickboards) {
+        load_model(MODEL_WF_KICKABLE_BOARD, wf_geo_000BA8);
+        load_model(MODEL_WF_KICKABLE_BOARD_FELLED, wf_geo_000BC8);   // it swaps to this when kicked down
+    }
+}
