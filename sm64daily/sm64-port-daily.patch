+// SM64's own star grab: the collect-star fanfare, Mario holding the star up, "Here we go!".
+static void finish_run(struct Object *star) {
+    struct MarioState *m = gMarioState;
+    sFinished = TRUE;
+    level_control_timer(TIMER_CONTROL_STOP);
