+// Platforms that fall or crumble (tumbling bridges, falling pillars...) come back when Mario
+// respawns, so a fall after crossing one never strands him behind it.
+static void respawn_broken_pieces(void) {
+    s32 i;
+    for (i = 0; i < sNumParts; i++) {
+        struct Part *p = &sPart[i];
+        struct Object *o = p->obj;
+        if (p->type != PT_PIECE) continue;
+        if (o == NULL || o->activeFlags == ACTIVE_FLAG_DEACTIVATED || o->behavior != segmented_to_virtual(sPiece[p->piece].beh)
+            || absf(o->oPosY - p->y) > 1500.0f) {
+            if (o != NULL && o->activeFlags != ACTIVE_FLAG_DEACTIVATED && o->behavior == segmented_to_virtual(sPiece[p->piece].beh)) obj_mark_for_deletion(o);
+            spawn_part_obj(i);
+        }
+    }
