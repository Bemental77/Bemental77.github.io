+// ── the day's challenge ─────────────────────────────────────────────────────
+enum { MODE_RACE, MODE_RED, MODE_CLEAR, MODE_COINS, MODE_BOSS, MODE_COUNT };
+static s32 sMode, sIslands;
+// Same formula as the page (index.html daily_mode), so the card can name the challenge before boot.
+static s32 mode_for_seed(u32 seed) {
+    u32 h = (seed ^ 0x5BD1E995u) * 0x85EBCA6Bu, r = (h >> 9) % 100;
+    return r < 28 ? MODE_RACE : r < 46 ? MODE_RED : r < 62 ? MODE_CLEAR : r < 76 ? MODE_COINS : MODE_BOSS;
+}
