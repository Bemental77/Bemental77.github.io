diff --git a/src/game/daily.c b/src/game/daily.c
new file mode 100644
index 0000000..965bcc6
--- /dev/null
+++ b/src/game/daily.c
@@ -0,0 +1,2329 @@
+// SM64 DAILY PARKOUR
+//
+// The page hands this module a seed (window.sm64DailySeed: the date, or a
+// five-letter word the player typed) and a difficulty day (window.sm64DailyDow).
+// From the seed alone it rolls everything about the course: the world it floats
+// over, the CHALLENGE (reach the star, collect 8 red coins, clear the enemies,
+// collect the coins), the LOOK (checkerboard or a colour theme), the clock speed
+// of Tick Tock Clock's machinery, and the order of MODULES — each one a piece of
+// SM64 gameplay rebuilt in the sky out of the game's own objects and surfaces:
+// moving platforms from every course, Thwomps, pendulums, fire bars, long jumps,
+// wall kicks, poles, slides, enemy arenas (Goombas, Bob-ombs, Chuckyas, Fly Guys),
+// Amp bridges, cannons, purple-switch box bridges, Koopa-shell lava crossings,
+// vanish-cap walls, metal-cap fire walks, wing-cap flights, monkey bars,
+// quicksand, ice, crosswinds, updrafts, swimming pools and poison-gas chambers.
+// The PC port links every level's models, textures and collision into one binary,
+// so any of them can be loaded here (load_model) and spawned outside its home level.
+//
+// Moves are sized from the game's own constants:
+//
+//   move                 launch vy           gravity   apex      source
+//   single jump          42 + fwd/4          4/frame   ~310      mario.c:821-825
+//   double jump          52 + fwd/4          4         ~340-450  mario.c:785-787
+//   triple jump          69                  4         ~595      mario.c:796-798
+//   backflip / sideflip  62                  4         ~480      mario.c:790-793, 837-839
+//   wall kick            62, fwd >= 24       4         ~480/kick mario.c:828-832
+//   top-of-pole jump     62, fwd >= 24       4         pole top + ~480 (pole top = hitbox - 100,
+//                                                      mario_actions_automatic.c:68; giant pole hitbox 2100)
+//   long jump            30, fwd*1.5 <= 48   2         long      mario.c:863-871, mario_step.c:543-545
+//   cannon shot          100 at the aim      1         very far  mario_actions_automatic.c:733-735, mario_step.c:538-542
+//   hanging (bars)       4/frame max                             mario_actions_automatic.c:347-352
+//
+// The run: SM64's own HUD timer starts when Mario leaves the start platform;
+// about 2:00 is the target length, not a cutoff. Falling (or dying) respawns at
+// the last checkpoint (the clock keeps running). Any star Mario touches — ours,
+// or one a boss drops — ends the run with SM64's own star dance, without leaving
+// the level. Mario's path is recorded at 15 Hz so the page can share it as a ghost.
+#include <ultra64.h>
+
+#include "sm64.h"
+#include "types.h"
+#include "daily.h"
+#include "level_update.h"
+#include "object_helpers.h"
+#include "object_list_processor.h"
+#include "mario.h"
+#include "interaction.h"
+#include "sound_init.h"
+#include "seq_ids.h"
+#include "game_init.h"
+#include "camera.h"
+#include "print.h"
+#include "area.h"
+#include "engine/math_util.h"
+#include "engine/graph_node.h"
+#include "engine/surface_load.h"
+#include "audio/external.h"
+#include "behavior_data.h"
+#include "object_constants.h"
+#include "surface_terrains.h"
+#include "level_table.h"
+#include "memory.h"
+#include "model_ids.h"
+#include "engine/surface_collision.h"
+#include "actors/common0.h"
+#include "actors/common1.h"
+#include "geo_commands.h"
+#include "actors/group1.h"
+#include "levels/lll/header.h"
+#include "levels/ttc/header.h"
+#include "levels/rr/header.h"
+#include "levels/bitfs/header.h"
+#include "levels/bitdw/header.h"
+#include "levels/bits/header.h"
+#include "levels/wf/header.h"
+#include "actors/group1.h"
+#include "actors/group2.h"
+#include "actors/group5.h"
+#include "actors/group7.h"
+#include "actors/group13.h"
+#include "actors/group17.h"
+#include "levels/bbh/header.h"
+#include "levels/hmc/header.h"
+#include "levels/ttm/header.h"
+#include "actors/group8.h"
+#include "actors/group14.h"
+#include "actors/group3.h"
+#include "actors/group9.h"
+#include "actors/group11.h"
+#include "actors/group14.h"
+
+#ifdef TARGET_WEB
+#include <emscripten.h>
+#endif
+
+#define absf(x) ((x) < 0 ? -(x) : (x))
+#define DMAX(a, b) ((a) > (b) ? (a) : (b))
+#define DMIN(a, b) ((a) < (b) ? (a) : (b))
+
+#define MAX_PARTS 240
+#define TARGET_SECONDS 115.0f          // ~2:00 course for a decent player
+
+// ── our own simple boxes ────────────────────────────────────────────────────
+// The host level's own objects are cleared when the course is built (clear_host_objects),
+// so the level-geometry model slots 0x03.. are free for our boxes.
+#define BOX_MODEL_BASE 0x03
+enum { BK_WALL, BK_SLIDE, BK_GOALCAP, BK_GHOST, BK_CHECKCAP, BK_STATION, BK_LAVA, BK_VANISH, BK_ICE, BK_SAND,
+       BK_BARS, BK_WATERVIS, BK_GASVIS, BK_WINDPAD, BK_WINDY, BK_MUD, BK_COUNT };
+static u8 sBoxColor[BK_COUNT][4] = {
+    { 0x9B, 0x5C, 0xE6, 0xFF },   // walls (theme accent)
+    { 0x8F, 0xEE, 0xF5, 0xFF },   // slide: ice
+    { 0xFF, 0xC8, 0x1E, 0xFF },   // goal: gold
+    { 0xFF, 0xFF, 0xFF, 0x70 },   // ghost
+    { 0x3C, 0xD0, 0x5A, 0xFF },   // checkpoint: green
+    { 0x8A, 0x8A, 0x8A, 0xFF },   // station (theme)
+    { 0xFF, 0x4A, 0x10, 0xFF },   // lava
+    { 0x40, 0x70, 0xFF, 0x80 },   // vanish-cap wall
+    { 0xC8, 0xF0, 0xFF, 0xFF },   // ice
+    { 0xD8, 0xB0, 0x6A, 0xFF },   // quicksand
+    { 0x70, 0x70, 0x78, 0xFF },   // monkey bars
+    { 0x30, 0x80, 0xFF, 0x70 },   // water (look only)
+    { 0xD8, 0xE0, 0x30, 0x60 },   // poison gas (look only)
+    { 0xA0, 0xF0, 0xFF, 0x90 },   // updraft pad
+    { 0xE0, 0xF0, 0xE8, 0xFF },   // windy bridge
+    { 0x6A, 0x4A, 0x2A, 0xFF },   // mud (slow)
+};
+static u8 box_layer(s32 k) { return (k == BK_GHOST || k == BK_VANISH || k == BK_WATERVIS || k == BK_GASVIS || k == BK_WINDPAD) ? LAYER_TRANSPARENT : LAYER_OPAQUE; }
+
+// Unit box: x,z in [-50,50], y in [-100,0] — the object's position is the TOP surface.
+// Triangle list copied from checkerboard_platform's box collision (same vertex order).
+// Built at runtime so each box kind can carry any SM64 surface type (and a force direction
+// for the surfaces that push: wind, moving quicksand — surface_load.c:416-431).
+#define COL_WORDS 80
+static s16 sColBuf[48][COL_WORDS];
+static s16 sColKey[48];
+static s32 sNumCol;
+static const Collision *make_box_col(s16 type, s16 force) {
+    static const s16 v[8][3] = { { 50, -100, -50 }, { 50, 0, -50 }, { 50, 0, 50 }, { -50, 0, -50 },
+                                 { -50, 0, 50 }, { -50, -100, -50 }, { -50, -100, 50 }, { 50, -100, 50 } };
+    static const s16 t[12][3] = { { 0, 1, 2 }, { 1, 3, 4 }, { 1, 4, 2 }, { 5, 3, 1 }, { 5, 1, 0 }, { 6, 4, 3 },
+                                  { 6, 3, 5 }, { 7, 4, 6 }, { 7, 2, 4 }, { 0, 2, 7 }, { 7, 6, 5 }, { 7, 5, 0 } };
+    s16 key = (s16) ((type << 8) ^ (force & 0xFF)), *c;
+    s32 i, j, n = 0, special;
+    for (i = 0; i < sNumCol; i++) if (sColKey[i] == key) return (const Collision *) sColBuf[i];
+    if (sNumCol >= 48) return (const Collision *) sColBuf[0];
+    c = sColBuf[sNumCol];
+    special = (type == SURFACE_HORIZONTAL_WIND || type == SURFACE_DEEP_MOVING_QUICKSAND || type == SURFACE_SHALLOW_MOVING_QUICKSAND
+               || type == SURFACE_MOVING_QUICKSAND || type == SURFACE_INSTANT_MOVING_QUICKSAND || type == SURFACE_FLOWING_WATER);
+    c[n++] = TERRAIN_LOAD_VERTICES; c[n++] = 8;
+    for (i = 0; i < 8; i++) for (j = 0; j < 3; j++) c[n++] = v[i][j];
+    c[n++] = type; c[n++] = 12;
+    for (i = 0; i < 12; i++) { c[n++] = t[i][0]; c[n++] = t[i][1]; c[n++] = t[i][2]; if (special) c[n++] = force; }
+    c[n++] = TERRAIN_LOAD_CONTINUE; c[n++] = TERRAIN_LOAD_END;
+    sColKey[sNumCol] = key;
+    return (const Collision *) sColBuf[sNumCol++];
+}
+static s16 box_surface(s32 k) {
+    switch (k) {
+        case BK_SLIDE:   return SURFACE_VERY_SLIPPERY;
+        case BK_LAVA:    return SURFACE_BURNING;
