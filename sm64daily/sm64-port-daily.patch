+// SM64 culls an object by its geo layout's culling radius, NOT scaled by the object
+// (rendering_graph_node.c:777-784; checkerboard_platform_geo is 400). Stretched platforms
+// vanished whenever their centre left the screen, so every model we scale gets a big radius.
+#define BIG_GEO(name, layer, dl) static const GeoLayout name[] = { \
+    GEO_CULLING_RADIUS(6000), GEO_OPEN_NODE(), GEO_DISPLAY_LIST(layer, dl), GEO_CLOSE_NODE(), GEO_END() }
