+// Red coins on 8 stations spread along the course (two hovering a jump above their platform);
+// yellow coin lines on coin days and as a scattering otherwise.
+static void place_collectibles(void) {
+    s32 st[MAX_PARTS], ns = 0, i, k;
+    for (i = 1; i < sNumParts; i++) if (sPart[i].station && i != sGoal) st[ns++] = i;
+    if (sMode == MODE_RED && ns >= 8) {
+        for (k = 0; k < 8; k++) {
+            struct Part *p = &sPart[st[(k * ns) / 8 + rnd_i(DMAX(1, ns / 8))]];
+            f32 x, z;
+            struct Dyn *d;
+            local_pt(p, rnd_f(-(p->hz - 90), p->hz - 90), rnd_f(-(p->hx - 90), p->hx - 90), &x, &z);
+            d = add_dyn(DK_REDCOIN, x, p->y + (k % 4 == 3 ? 260.0f : 40.0f), z, (s32) (p - sPart));
+            if (d) d->objective = 1;
+        }
+    }
+    for (k = 0; k < ns; k++) {
+        struct Part *p = &sPart[st[k]];
+        s32 line = sMode == MODE_COINS ? (p->hz >= 200.0f) : (rnd_i(100) < 25 && p->hz >= 220.0f), j;
+        if (!line) continue;
+        for (j = 0; j < 5; j++) {
+            f32 x, z;
+            struct Dyn *d;
+            local_pt(p, -p->hz + 80.0f + j * (2 * p->hz - 160.0f) / 4.0f, 0, &x, &z);
+            d = add_dyn(DK_COIN, x, p->y + 40.0f, z, (s32) (p - sPart));
+            if (d && sMode == MODE_COINS) d->objective = 1;
+        }
+    }
+}
+
+// This seed's extras, each on one or two platforms, toward a corner, standing on the top.
+// ── what occupies space ────────────────────────────────────────────────────
+// A part's solid volume as an upright oriented box: centre, half extents along its local axes,
+// heading, bottom and top. Pieces use the extents of their collision; extras that far, too.
+struct Shape { f32 x, z, hx, hz, lo, hi; s16 yaw; };
+static s32 part_shape(struct Part *p, struct Shape *sh) {
+    sh->x = p->x; sh->z = p->z; sh->yaw = p->yaw;
+    switch (p->type) {
+        case PT_CHECKER: case PT_BOX: case PT_DECOR:
+            sh->hx = p->hx; sh->hz = p->hz; sh->hi = p->y; sh->lo = p->y - p->h;
+            if (p->type == PT_DECOR) { sh->lo = p->y - p->h; }
+            return TRUE;
+        case PT_PIECE: {
+            struct Piece *pc = &sPiece[p->piece];
+            if (pc->col == NULL && pc->role != R_EXTRA && pc->role != R_HAZ_ANY) return FALSE;
+            sh->hx = DMAX(pc->rx, 60.0f); sh->hz = DMAX(pc->rz, 60.0f);
+            sh->lo = p->y + pc->minY; sh->hi = p->y + pc->maxY;
+            return TRUE;
+        }
+        case PT_ISLE: {
+            struct IsleInfo *f = &sIsleInfo[p->piece];
+            sh->x = p->x + p->sc * (f->x0 + f->x1) / 2.0f; sh->z = p->z + p->sc * (f->z0 + f->z1) / 2.0f; sh->yaw = 0;
+            sh->hx = p->sc * (f->x1 - f->x0) / 2.0f; sh->hz = p->sc * (f->z1 - f->z0) / 2.0f;
+            sh->lo = p->y + p->sc * f->y0; sh->hi = p->y + p->sc * f->y1;
+            return TRUE;
+        }
+        case PT_OBJ:   // a cannon (and the room to stand at it) or a floor switch
+            sh->hx = sh->hz = p->kind == OK_CANNON ? 160.0f : 110.0f; sh->lo = p->y; sh->hi = p->y + 250.0f;
+            return TRUE;
+        case PT_POLE:
+            sh->hx = sh->hz = 40.0f; sh->lo = p->y; sh->hi = p->y + 2000.0f;
+            return TRUE;
+    }
+    return FALSE;
+}
+// Separating axis test for two upright boxes, shrunk by `slack` (touching is fine).
+static s32 shapes_meet(struct Shape *a, struct Shape *b, f32 slack, f32 vslack) {
+    s16 ax[4] = { a->yaw, a->yaw + 0x4000, b->yaw, b->yaw + 0x4000 };
+    s32 k;
+    if (a->hi - vslack <= b->lo || b->hi - vslack <= a->lo) return FALSE;
+    for (k = 0; k < 4; k++) {
+        f32 ux = sins(ax[k]), uz = coss(ax[k]);
+        f32 d = absf((b->x - a->x) * ux + (b->z - a->z) * uz);
+        f32 ra = a->hz * absf(coss(ax[k] - a->yaw)) + a->hx * absf(sins(ax[k] - a->yaw));
+        f32 rb = b->hz * absf(coss(ax[k] - b->yaw)) + b->hx * absf(sins(ax[k] - b->yaw));
+        if (d >= ra + rb - slack) return FALSE;
+    }
+    return TRUE;
+}
+static s32 module_of(s32 i) {
+    s32 k;
+    for (k = 0; k < sNumMods; k++) if (i >= sModStart[k] && i < sModStart[k + 1]) return k;
+    return -1;
+}
+// Extras (NPCs, signs, 1-ups, crazy boxes...) stand on stations, each clear of everything else
+// there: the station's other parts, cannons and switches (with room to walk up to them), enemies,
+// a checkpoint's star, and each other. One that doesn't fit anywhere is left out.
+static s32 extra_fits(struct Part *e, f32 R, struct Part *st) {
+    struct Shape a, b;
+    s32 j;
+    a.x = e->x; a.z = e->z; a.yaw = 0; a.hx = a.hz = R; a.lo = e->y + sPiece[e->piece].minY; a.hi = e->y + DMAX(sPiece[e->piece].maxY, 160.0f);
+    for (j = 0; j < sNumParts; j++) {
+        struct Part *q = &sPart[j];
+        if (q == e || q == st || !part_shape(q, &b)) continue;
+        if (q->type == PT_OBJ) { f32 room = q->kind == OK_CANNON ? 600.0f : 250.0f; b.hx += room; b.hz += room; }   // room to reach a cannon or a switch, unbothered
+        if (q->type == PT_PIECE && sPiece[q->piece].role == R_EXTRA) { b.hx = b.hz = DMAX(sPiece[q->piece].r, 60.0f); }
+        if (shapes_meet(&a, &b, -60.0f, -20.0f)) return FALSE;
+    }
+    for (j = 0; j < sNumDyn; j++) {
+        f32 dx = sDyn[j].x - e->x, dz = sDyn[j].z - e->z;
+        if (dx * dx + dz * dz < (R + 200.0f) * (R + 200.0f) && absf(sDyn[j].y - e->y) < 400.0f) return FALSE;
+    }
+    if ((st->check || st == &sPart[sGoal])) {
+        f32 dx = st->x - e->x, dz = st->z - e->z;
+        if (dx * dx + dz * dz < (R + 160.0f) * (R + 160.0f)) return FALSE;
+    }
+    return TRUE;
+}
+// The stream position the original placement left behind: per extra piece, 1 + rnd_i(2) copies
+// (re-drawn each loop test), each a station, a yaw and a spot (two rnd_f).
+static u32 old_extras_draws(void) {
+    u32 save = sRng, after;
+    s32 ns = 0, i, k, np = sNumParts;
+    for (i = 1; i < sNumParts; i++) if (sPart[i].station && i != sGoal && sPart[i].hx >= 200.0f && sPart[i].hz >= 200.0f) ns++;
+    if (ns > 0) {
+        for (i = NUM_BUILTIN_PIECES; i < NUM_PIECES; i++) {
+            if (sPiece[i].role != R_EXTRA) continue;
+            for (k = 0; k < 1 + rnd_i(2) && np < MAX_PARTS - 4; k++) {
+                rnd_i(ns);
+                if (np >= MAX_PARTS) goto done;
+                np++;
+                rnd_u32(); rnd_f(0, 1); rnd_f(0, 1);
+            }
+        }
+    }
+done:
+    after = sRng; sRng = save;
+    return after;
+}
+static void place_extras(void) {
+    s32 st[MAX_PARTS], ns = 0, i, k, t;
+    for (i = 1; i < sNumParts; i++) if (sPart[i].station && i != sGoal && sPart[i].hx >= 200.0f && sPart[i].hz >= 200.0f) st[ns++] = i;
+    if (ns == 0) return;
+    for (i = NUM_BUILTIN_PIECES; i < NUM_PIECES; i++) {
+        f32 R;
+        if (sPiece[i].role != R_EXTRA) continue;
+        // bhvStaticObject is a level's scenery (LLL's, here: lll_geo_000AC0) with no collision: on a
+        // station it reads as a floor over the floor, and Mario runs through it.
+        if (sPiece[i].beh == bhvStaticObject) continue;
+        R = DMAX(sPiece[i].r, 60.0f);
+        for (k = 0; k < 1 + rnd_i(2) && sNumParts < MAX_PARTS - 4; k++) {
+            struct Part *e = add_part(PT_PIECE);
+            if (!e) return;
+            e->piece = i; e->r = 1; e->h = 0;
+            for (t = 0; t < 24; t++) {
+                struct Part *s = &sPart[st[rnd_i(ns)]];
+                f32 mx = s->hx - R - 40.0f, mz = s->hz - R - 40.0f;
+                e->yaw = (s16) (rnd_u32() & 0xFFFF);
+                if (mx < 0 || mz < 0) continue;
+                local_pt(s, rnd_f(-mz, mz), rnd_f(-mx, mx), &e->x, &e->z);
+                e->y = s->y - DMIN(sPiece[i].minY, 0.0f) + 2.0f;
+                if (extra_fits(e, R, s)) break;
+            }
+            if (t == 24) { sNumParts--; break; }
+        }
+    }
+}
