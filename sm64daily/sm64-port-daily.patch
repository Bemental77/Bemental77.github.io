+// ── host level ──────────────────────────────────────────────────────────────
+// Each day the course is built over a different SM64 world. Ids into this
+// table are what the page shows (window.sm64DailyHost).
+static const s16 sHosts[] = {
+    LEVEL_CASTLE_GROUNDS, LEVEL_BOB, LEVEL_WF, LEVEL_JRB, LEVEL_CCM, LEVEL_SSL, LEVEL_LLL, LEVEL_SL,
+    LEVEL_TTM,   /* LEVEL_WDW left out: its walls leave room for ~3 platforms */ LEVEL_THI, LEVEL_RR, LEVEL_BITDW, LEVEL_BITFS, LEVEL_BITS, LEVEL_DDD,
+    LEVEL_CASTLE_COURTYARD,
+};
+static s32 sHostIdx = 0;
+
+static u32 page_seed(void) {
+    u32 seed = 0;
+#ifdef TARGET_WEB
+    seed = (u32) EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailySeed) | 0; });
+#endif
+    return seed;
+}
+
+// Called by intro_regular (title_screen.c): which level today's course is built in.
+s32 daily_host_level(void) {
+    u32 h = page_seed() * 2654435761u;
+    s32 forced = -1;
+#ifdef TARGET_WEB
+    forced = EM_ASM_INT({ return (typeof window !== 'undefined' && window.sm64DailyHostOverride !== undefined) ? window.sm64DailyHostOverride | 0 : -1; });
+#endif
+    sHostIdx = forced >= 0 ? forced % (s32) (sizeof(sHosts) / sizeof(sHosts[0])) : (s32) ((h >> 8) % (sizeof(sHosts) / sizeof(sHosts[0])));
+    return sHosts[sHostIdx];
+}
+
+// Red coins on 8 stations spread along the course (two hovering a jump above their platform);
+// yellow coin lines on coin days and as a scattering otherwise.
+static void place_collectibles(void) {
+    s32 st[MAX_PARTS], ns = 0, i, k;
+    for (i = 1; i < sNumParts; i++) if (sPart[i].station && i != sGoal) st[ns++] = i;
+    if (sMode == MODE_RED && ns >= 8) {
+        for (k = 0; k < 8; k++) {
+            struct Part *p = &sPart[st[(k * ns) / 8 + rnd_i(DMAX(1, ns / 8))]];
+            f32 x, z;
+            struct Dyn *d;
+            local_pt(p, rnd_f(-(p->hz - 90), p->hz - 90), rnd_f(-(p->hx - 90), p->hx - 90), &x, &z);
+            d = add_dyn(DK_REDCOIN, x, p->y + (k % 4 == 3 ? 260.0f : 40.0f), z, (s32) (p - sPart));
+            if (d) d->objective = 1;
+        }
+    }
+    for (k = 0; k < ns; k++) {
+        struct Part *p = &sPart[st[k]];
+        s32 line = sMode == MODE_COINS ? (p->hz >= 200.0f) : (rnd_i(100) < 25 && p->hz >= 220.0f), j;
+        if (!line) continue;
+        for (j = 0; j < 5; j++) {
+            f32 x, z;
+            struct Dyn *d;
+            local_pt(p, -p->hz + 80.0f + j * (2 * p->hz - 160.0f) / 4.0f, 0, &x, &z);
+            d = add_dyn(DK_COIN, x, p->y + 40.0f, z, (s32) (p - sPart));
+            if (d && sMode == MODE_COINS) d->objective = 1;
+        }
+    }
+}
+
+static s32 sCoinTarget;
+
+static f32 generate_once(u32 seed, s32 dow) {
+    // Monday (1) easiest .. Sunday (0) hardest.
+    f32 hard = ((dow + 6) % 7) / 6.0f, secs = 0;
+    s32 used[MD_COUNT], cur, i, m, tries, sinceCheck = 0, last = -1, enemyMods = 0;
+    struct Part *s;
+
+    sRng = seed ? seed : 0x5EED1234;
+    for (i = 0; i < 8; i++) rnd_u32();
+    bzero(used, sizeof(used));
+    sNumParts = 0; sNumMods = 0; sNumDyn = 0; sNumEnv = 0; sKickboards = 0;
+
+    s = add_part(PT_CHECKER);
+    s->hx = 300.0f; s->hz = 300.0f; s->station = 1;
+    s->yaw = (s16) (rnd_u32() & 0xFFFF);
+    // Survey: start above a random in-bounds spot, high enough to clear everything near it.
+    for (tries = 0; tries < 600; tries++) {
+        f32 x = rnd_f(-5500, 5500), z = rnd_f(-5500, 5500), hi = -20000.0f, t;
+        s32 k, ok = TRUE;
+        for (k = 0; k < 9 && ok; k++) {
+            t = terrain_at(x + (k % 3 - 1) * 900.0f, z + (k / 3 - 1) * 900.0f);
+            if (t < -19000.0f) ok = FALSE;
+            if (t > hi) hi = t;
+        }
+        if (!ok) continue;
+        s->x = x; s->z = z; s->y = hi + SKY_CLEAR + 500.0f;
+        if (!blocked(s, 0)) break;
+    }
+    cur = 0;
+
+    while (secs < (sMode == MODE_BOSS ? TARGET_SECONDS * 0.6f : TARGET_SECONDS) && sNumParts < MAX_PARTS - 16) {
+        s32 got = -1, partsBefore = sNumParts, dynBefore = sNumDyn;
+        for (tries = 0; tries < 250 && got < 0; tries++) {
+            f32 w[MD_COUNT], sum = 0, r;
+            for (m = 0; m < MD_COUNT; m++) {
+                // Every course should mix the move set: unused modules are strongly preferred,
+                // and the same module never twice in a row. The challenge and the day's flavour tilt it.
+                w[m] = sModWeight[m] * sModOn[m] * (used[m] ? 0.6f : 1.6f);
+                if (sMode == MODE_CLEAR && (m == MD_ENEMIES)) w[m] *= enemyMods < 4 ? 6.0f : 1.0f;
+                if (sIslands && (m == MD_CANNON || m == MD_WING)) w[m] *= 3.0f;
+                if (m == last) w[m] = 0;
+                sum += w[m];
+            }
+            r = rnd_f(0, sum);
+            for (m = 0; m < MD_COUNT - 1 && r > w[m]; m++) r -= w[m];
+            {
+                s16 h = sPart[cur].yaw + (s16) rnd_f(-0x2400, 0x2400);
+                f32 cx = (AREA_X0 + AREA_X1) / 2, cz = (AREA_Z0 + AREA_Z1) / 2;
+                if (absf(sPart[cur].x - cx) > 6000.0f || absf(sPart[cur].z - cz) > 6000.0f || tries > 120)
+                    h = atan2s(cz - sPart[cur].z, cx - sPart[cur].x) + (s16) rnd_f(-0x4000, 0x4000);
+                if (tries > 200) h = (s16) (rnd_u32() & 0xFFFF);
+                got = build_module(m, cur, h, hard);
+            }
+        }
+        if (got < 0) {
+            // Out of room on this level (small worlds like the Courtyard): climb. A giant pole on
+            // the current platform leads to a new layer ~2100+ up, which may overlap the layers
+            // below (blocked() ignores parts that far apart vertically).
+            got = build_lift(cur);
+            m = MD_POLE;
+        }
+        if (got < 0) break;
+        used[m]++; last = m;
+        if (m == MD_ENEMIES) enemyMods++;
+        if (sNumMods < 64) { sModFirst[sNumMods] = cur; sModLand[sNumMods] = got; sModStart[sNumMods] = partsBefore; sModDynStart[sNumMods] = dynBefore; sMods[sNumMods++] = m; sModStart[sNumMods] = sNumParts; sModDynStart[sNumMods] = sNumDyn; }
+        secs += sModSeconds[m];
+        cur = got;
+        if (++sinceCheck >= 3) { sPart[cur].check = 1; sinceCheck = 0; }
+    }
+    if (sMode == MODE_BOSS) {
+        // The finale: the boss arena. Its star ends the run.
+        s32 got = -1, partsBefore = sNumParts, dynBefore = sNumDyn;
+        sArena = -1;
+        for (tries = 0; tries < 300 && got < 0; tries++) {
+            s16 h = tries < 100 ? sPart[cur].yaw + (s16) rnd_f(-0x3000, 0x3000) : (s16) (rnd_u32() & 0xFFFF);
+            got = build_module(MD_BOSS, cur, h, hard);
+        }
+        if (got < 0) return 0;
+        sPart[cur].check = 1;   // respawn right before the arena
+        if (sNumMods < 64) { sModFirst[sNumMods] = cur; sModLand[sNumMods] = got; sModStart[sNumMods] = partsBefore; sModDynStart[sNumMods] = dynBefore;
+                             sMods[sNumMods++] = MD_BOSS; sModStart[sNumMods] = sNumParts; sModDynStart[sNumMods] = sNumDyn; }
+        secs += sModSeconds[MD_BOSS];
+        cur = got;
+    }
+    sGoal = cur;
+    sPart[cur].goal = 1; sPart[cur].check = 0; sPart[cur].fk = 0;
+    sPart[cur].hx = DMAX(sPart[cur].hx, 280.0f); sPart[cur].hz = DMAX(sPart[cur].hz, 280.0f);
+    for (sNumStations = 0, i = 0; i < sNumParts; i++) if (sPart[i].station) sNumStations++;
+    place_collectibles();
+    if (sMode == MODE_COINS) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].kind == DK_COIN) t++;
+        sCoinTarget = (t * 7) / 10;
+        if (t < 20) secs = 0;      // too few coins to make a challenge of it: try another layout
+    }
+    if (sMode == MODE_RED) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].kind == DK_REDCOIN) t++;
+        if (t < 8) secs = 0;
+    }
+    if (sMode == MODE_CLEAR) {
+        s32 t = 0;
+        for (i = 0; i < sNumDyn; i++) if (sDyn[i].objective) t++;
+        if (t < 6) secs = 0;
+    }
+    return secs;
+}
+
+// Everything about the course is rolled from the seed. If the seed leaves the world too little
+// room for ~2:00 (or the challenge), derive another layout seed from it, deterministically.
+static f32 sGenSecs;
+static void generate(u32 seed, s32 dow) {
+    u32 k, h = (seed ^ 0x27D4EB2Fu) * 0x165667B1u;
+    sMode = mode_for_seed(seed);
+    sBoss = sMode == MODE_BOSS ? (s32) ((h >> 13) % BOSS_COUNT) : -1;
+    sTheme = (s32) ((h >> 11) % NUM_THEMES);
+    sStyle = ((h >> 5) & 3) == 0 ? STYLE_CHECKER : STYLE_BOX;
+    sIslands = ((h >> 17) % 5) == 0;
+    gTTCSpeedSetting = (s16) ((h >> 21) % 3);   // slow, fast or random: TTC's own pieces follow it
+    {
+        // This seed's palette: a handful of modules (and moving platforms, and two enemy groups) of its own,
+        // each with its own weight — so courses differ in kind, not just in layout.
+        u32 r = h ^ 0xA5A5F00Du, j, want;
+        s32 m, i;
+        #define PRNG() (r ^= r << 13, r ^= r >> 17, r ^= r << 5, r)
+        for (m = 0; m < MD_COUNT; m++) sModOn[m] = 0;
+        sModOn[MD_HOP] = 0.6f; sModOn[MD_STEPPING] = 1.0f;
+        want = 6 + PRNG() % 6;
+        for (j = 0; j < want; j++) {
+            m = 1 + (s32) (PRNG() % (MD_COUNT - 1));
+            if (m == MD_BOSS || sModOn[m] > 0) { j--; if (PRNG() % 50 == 0) break; continue; }
+            sModOn[m] = 0.5f + (PRNG() % 100) / 66.0f;
+        }
+        if (sMode == MODE_CLEAR) sModOn[MD_ENEMIES] = DMAX(sModOn[MD_ENEMIES], 1.5f);
+        if (sIslands) { sModOn[MD_CANNON] = DMAX(sModOn[MD_CANNON], 1.5f); sModOn[MD_WING] = DMAX(sModOn[MD_WING], 1.2f); }
+        // Moving platforms and hazards: the built-in ones, plus a draw from the whole inventory (sAuto).
+        sNumPieces = NUM_BUILTIN_PIECES;
+        for (i = 0; i < NUM_BUILTIN_PIECES; i++) {
+            if (sPiece[i].col == NULL) sPiece[i].col = beh_collision(sPiece[i].beh);
+            measure(&sPiece[i]); sPieceOn[i] = (PRNG() % 100) < 35;
+        }
+        {
+            static u8 claimed[256];
+            s32 a, tries;
+            bzero(claimed, sizeof(claimed));
+            for (a = 0x00; a <= 0x15; a++) claimed[a] = 1;            // Mario, our boxes
+            for (a = 0xE2; a <= 0xFF; a++) claimed[a] = 1;            // our pieces, markers
+            for (a = 0x74; a <= 0xE1; a++) claimed[a] = 1;            // the global/common set our objects use
+            for (a = 0; a < NUM_LIB; a++) if (lib_ok(a)) { claimed[sLib[a].model] = 1; claimed[sLib[a].model2] = 1; claimed[sLib[a].model3] = 1; }
+            if (sBoss >= 0) { claimed[sBosses[sBoss].model] = 1; claimed[sBosses[sBoss].model2] = 1; }
+            claimed[MODEL_WF_KICKABLE_BOARD] = claimed[MODEL_WF_KICKABLE_BOARD_FELLED] = 1;
+            claimed[MODEL_TRAMPOLINE] = claimed[MODEL_TRAMPOLINE_CENTER] = claimed[MODEL_TRAMPOLINE_BASE] = 1;
+            if (sGroupB == 15) claimed[MODEL_CHAIN_CHOMP] = claimed[MODEL_METALLIC_BALL] = claimed[MODEL_WOODEN_POST] = 1;
+            for (tries = 0; tries < 400 && sNumPieces < MAX_PIECES && sNumPieces < NUM_BUILTIN_PIECES + 18; tries++) {
+                const struct AutoPiece *ap = &sAuto[PRNG() % NUM_AUTO];
+                struct Piece *pc = &sPiece[sNumPieces];
+                const Collision *col = beh_collision(ap->beh);
+                if (claimed[ap->model]) continue;
+                bzero(pc, sizeof(*pc));
+                pc->name = ap->name; pc->beh = ap->beh; pc->geo = ap->geo; pc->bp = ap->bp; pc->model = ap->model;
+                if (col != NULL) { pc->col = col; measure(pc); }
+                if (ap->role == 1) {
+                    pc->role = R_HAZ_ANY;
+                    if (col == NULL) { pc->minY = 0; pc->maxY = 200; pc->rx = pc->rz = pc->r = 200; }
+                    if (pc->r > 1200.0f) continue;
+                } else {
+                    // A platform needs a top to land on, and must fit in a gap.
+                    if (col == NULL || pc->rx < 110.0f || pc->rz < 110.0f || pc->r > 1600.0f || pc->maxY - pc->minY > 2400.0f) continue;
+                    pc->role = (pc->rx > pc->rz * 2.0f || pc->rz > pc->rx * 2.0f) ? R_LONGSTEP : R_STEP;
+                }
+                claimed[ap->model] = 1;
+                sPieceOn[sNumPieces] = 1;
+                sNumPieces++;
+            }
+            sNumAutoDrawn = sNumPieces - NUM_BUILTIN_PIECES;
+        }
+        sGroupA = sGroupsA[PRNG() % sizeof(sGroupsA)];
+        sGroupB = sGroupsB[PRNG() % sizeof(sGroupsB)];
+        // A boss's model lives in its group's slots: that group is the course's group.
+        if (sBoss == BOSS_KING_BOBOMB) sGroupA = 4;
+        if (sBoss == BOSS_BIG_BULLY) sGroupA = 3;
+        if (sBoss == BOSS_WIGGLER) sGroupA = 12;
+        if (sBoss == BOSS_BIG_BOO) sGroupA = 10;
+        if (sBoss == BOSS_KING_WHOMP) sGroupB = 15;
+        if (sBoss == BOSS_CHESTS) sGroupB = 14;
+        #undef PRNG
+    }
+    for (k = 0; k < 8; k++) {
+        if ((sGenSecs = generate_once(seed + k * 0x9E3779B9u, dow)) >= TARGET_SECONDS * 0.85f) return;
+    }
+    sGenSecs = generate_once(seed, dow);
+}
+
+// Test hook (exported): build (but don't spawn) the course a seed gives over the current world;
+// returns a hash of every part's placement. daily_debug_gen_info() = stations*10000 + seconds.
+u32 daily_debug_gen(u32 seed, s32 dow) {
+    u32 h = 2166136261u;
+    s32 i;
+    generate(seed, dow);
+    for (i = 0; i < sNumParts; i++) {
+        s32 v[5] = { (s32) sPart[i].x, (s32) sPart[i].y, (s32) sPart[i].z, sPart[i].type, sPart[i].piece };
+        s32 j;
+        for (j = 0; j < 5; j++) { h ^= (u32) v[j]; h *= 16777619u; }
+    }
+    return h;
+}
+s32 daily_debug_gen_info(void) { return sNumStations * 10000 + (s32) sGenSecs; }
+s32 daily_debug_mode(void) { return sMode; }
+s32 daily_debug_auto(void) { return sNumAutoDrawn; }
+s32 daily_debug_modules(s32 i) { return i < sNumMods ? sMods[i] : -1; }
+// Test hook: module k's [0] id, [1] the station it starts from, [2] the station it lands on.
+// [3] its first part, [4] one past its last part, [5] its first dyn, [6] one past its last dyn.
+s32 daily_debug_mod_info(s32 k, s32 f) {
+    if (k >= sNumMods) return -1;
+    switch (f) { case 0: return sMods[k]; case 1: return sModFirst[k]; case 2: return sModLand[k]; case 3: return sModStart[k];
+                 case 4: return sModStart[k + 1]; case 5: return sModDynStart[k]; default: return sModDynStart[k + 1]; }
+}
+s32 daily_debug_num_parts(void) { return sNumParts; }
+// Test hook: part i's [0..2] x y z, [3] type, [4] box kind, [5] hx, [6] hz, [7] yaw, [8] param, [9] kind.
+s32 daily_debug_part(s32 i, s32 f) {
+    struct Part *p = &sPart[i];
+    switch (f) { case 0: return (s32) p->x; case 1: return (s32) p->y; case 2: return (s32) p->z; case 3: return p->type; case 4: return p->box;
+                 case 5: return (s32) p->hx; case 6: return (s32) p->hz; case 7: return p->yaw; case 8: return p->param; default: return p->kind; }
+}
+
+// ── objects ─────────────────────────────────────────────────────────────────
+static struct Object *sGhostObj;
+static struct Object *sGoalCap, *sGoalStar;
+
+// The host level's own objects go: its stars would end the run early, its enemies wander into
+// nothing, and its model slots are free for ours. Its terrain, water and skybox stay.
+static void clear_host_objects(void) {
+    s32 i;
+    for (i = 0; i < NUM_OBJ_LISTS; i++) {
+        struct ObjectNode *head = &gObjectLists[i], *nd;
+        for (nd = head->next; nd != head; nd = nd->next) {
+            struct Object *o = (struct Object *) nd;
+            if (o != gMarioObject) obj_mark_for_deletion(o);
+        }
+    }
+}
+
+static s32 box_kind_of(struct Part *p) {
+    if (p->type == PT_BOX || p->type == PT_DECOR) return p->box;
+    if (p->fk) return p->fk;
+    return sStyle == STYLE_BOX ? BK_STATION : -1;   // -1: checkerboard
+}
+
+static void spawn_part_obj(s32 i) {
+    struct Part *p = &sPart[i];
+    struct Object *o = NULL;
+    s32 k = box_kind_of(p);
+    switch (p->type) {
+        case PT_CHECKER: case PT_BOX:
+            if (k < 0) {
+                // The checkerboard collision spans y -25..26 and x +-256, z +-153.5 (checkerboard_platform/collision.inc.c).
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CHECKER, bhvDailyPlatform,
+                                              (s16) p->x, (s16) (p->y - 26.0f * (p->h / 51.0f)), (s16) p->z, 0, p->yaw, 0);
+                obj_scale_xyz(o, p->hx / 256.0f, p->h / 51.0f, p->hz / 153.5f);
+            } else {
+                o = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + k, bhvDailyPlatform,
+                                              (s16) p->x, (s16) p->y, (s16) p->z, p->pitch, p->yaw, 0);
+                obj_scale_xyz(o, p->hx / 50.0f, p->h / 100.0f, p->hz / 50.0f);
+            }
+            o->oBehParams = i;
+            break;
+        case PT_DECOR:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + p->box, bhvDailyMarker,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+            obj_scale_xyz(o, p->hx / 50.0f, p->h / 100.0f, p->hz / 50.0f);
+            o->oBehParams = i | 0x400;   // 0x400: static decoration
+            break;
+        case PT_PIECE: {
+            struct Piece *pc = &sPiece[p->piece];
+            o = spawn_object_abs_with_rot(gMarioObject, 0, pc->model, pc->beh,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+            o->oBehParams = pc->bp;
+            o->oBehParams2ndByte = (pc->bp >> 16) & 0xFF;
+            o->oDrawingDistance = 30000.0f;
+            break;
+        }
+        case PT_POLE:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_GIANT_POLE, bhvGiantPole,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, 0, 0);
+            break;
+        case PT_FIREBAR:
+            o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_FIREBAR_BLOCK, bhvLllRotatingBlockWithFireBars,
+                                          (s16) p->x, (s16) p->y, (s16) p->z, 0, 0, 0);
+            break;
+        case PT_OBJ:
+            if (p->kind == OK_CANNON) {
+                // bhvCannon drops itself 340 into the ground (behavior_data.c:633); on a platform it sits on top.
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CANNON_BASE, bhvCannon,
+                                              (s16) p->x, (s16) (p->y + 340.0f), (s16) p->z, 0, p->yaw, 0);
+                o->oBehParams2ndByte = ((u16) p->yaw >> 8) & 0xFF;   // its resting yaw (cannon.inc.c:12)
+                o->oBehParams = (u32) o->oBehParams2ndByte << 16;
+            } else if (p->kind == OK_SWITCH) {
+                o = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_PURPLE_SWITCH, bhvFloorSwitchHiddenObjects,
+                                              (s16) p->x, (s16) p->y, (s16) p->z, 0, p->yaw, 0);
+                o->oBehParams2ndByte = 2;
+            }
+            break;
+    }
+    if (o != NULL && p->type != PT_CHECKER && p->type != PT_BOX && p->type != PT_DECOR) o->parentObj = o;   // see spawn_dyn
+    p->obj = o;
+}
+
+static void spawn_course(void) {
+    s32 i;
+    for (i = 0; i < sNumParts; i++) spawn_part_obj(i);
+    // Checkpoints: a green cap on the platform and a see-through star over it (gone once reached).
+    for (i = 0; i < sNumParts; i++) {
+        struct Part *p = &sPart[i];
+        struct Object *c;
+        if (!p->check) continue;
+        c = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_CHECKCAP, bhvDailyPlatform,
+                                      (s16) p->x, (s16) (p->y + 6.0f), (s16) p->z, 0, p->yaw, 0);
+        obj_scale_xyz(c, p->hx / 50.0f * 0.98f, 0.06f, p->hz / 50.0f * 0.98f);
+        c->oBehParams = i | 0x100;
+        c = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_CHECK_STAR, bhvDailyMarker,
+                                      (s16) p->x, (s16) (p->y + 260.0f), (s16) p->z, 0, 0, 0);
+        c->oBehParams = i;
+    }
+    // The goal: a gold cap, and a Power Star spinning over it at grabbing height.
+    sGoalStar = spawn_object_abs_with_rot(gMarioObject, 0, MODEL_GOAL_STAR, bhvDailyMarker,
+                                          (s16) sPart[sGoal].x, (s16) (sPart[sGoal].y + 150.0f), (s16) sPart[sGoal].z, 0, 0, 0);
+    sGoalStar->oBehParams = sGoal | 0x200;
+    obj_scale(sGoalStar, 1.3f);
+    sGoalCap = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_GOALCAP, bhvDailyPlatform,
+                                         (s16) sPart[sGoal].x, (s16) (sPart[sGoal].y + 6.0f), (s16) sPart[sGoal].z, 0, sPart[sGoal].yaw, 0);
+    obj_scale_xyz(sGoalCap, sPart[sGoal].hx / 50.0f * 0.98f, 0.06f, sPart[sGoal].hz / 50.0f * 0.98f);
+    sGoalCap->oBehParams = sGoal | 0x100;   // 0x100: decoration with its own (box) collision
+    sGhostObj = spawn_object_abs_with_rot(gMarioObject, 0, BOX_MODEL_BASE + BK_GHOST, bhvDailyGhost,
+                                          (s16) sPart[0].x, (s16) sPart[0].y, (s16) sPart[0].z, 0, 0, 0);
+    obj_scale_xyz(sGhostObj, 1.1f, 1.6f, 1.1f);
+    sGhostObj->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+    // Our water and gas, in front of the level's own regions.
+    {
+        s16 *w = sEnvBuf, *hp = sHostEnv;
+        s32 n = 0, hn = hp ? *hp++ : 0;
+        w++;
+        for (i = 0; i < sNumEnv; i++, n++) { *w++ = sEnv[i].id; *w++ = sEnv[i].x0; *w++ = sEnv[i].z0; *w++ = sEnv[i].x1; *w++ = sEnv[i].z1; *w++ = sEnv[i].y; }
+        for (i = 0; i < hn && n < 24; i++, n++, hp += 6) { s32 j; for (j = 0; j < 6; j++) *w++ = hp[j]; }
+        sEnvBuf[0] = (s16) n;
+        gEnvironmentRegions = sEnvBuf;
+    }
+}
+
+static s32 dyn_alive(struct Dyn *d) {
+    return d->obj != NULL && d->obj->activeFlags != ACTIVE_FLAG_DEACTIVATED && d->obj->behavior == segmented_to_virtual(dyn_beh_of(d));
+}
+static void spawn_dyn(struct Dyn *d) {
+    struct Object *o = spawn_object_abs_with_rot(gMarioObject, 0, dyn_model_of(d), dyn_beh_of(d),
+                                                 (s16) d->x, (s16) d->y, (s16) d->z, 0, d->yaw, 0);
+    o->oBehParams = d->bp;
+    o->oBehParams2ndByte = (d->bp >> 16) & 0xFF;
+    o->oDrawingDistance = 30000.0f;
+    // Level-placed objects are their own parent (spawn_object.c:277); spawned ones get Mario
+    // (object_helpers.c:532). Some behaviors act on their parent — a Goomba deletes itself when its
+    // parent's oAction is 0 (goomba.inc.c:274-279) — so ours are their own parent, like the level's.
+    o->parentObj = o;
+    d->obj = o; d->gone = 0; d->spawned = 1;
+}
+static void respawn_all_dyn(void) {
+    s32 i;
+    for (i = 0; i < sNumDyn; i++) {
+        if (dyn_alive(&sDyn[i])) obj_mark_for_deletion(sDyn[i].obj);
+        sDyn[i].obj = NULL; sDyn[i].spawned = 0;
+        if (!lazy(sDyn[i].kind)) spawn_dyn(&sDyn[i]);
+    }
+}
+
+void bhv_daily_platform_loop(void) {
+    struct Object *o = gCurrentObject;
+    struct Part *p = &sPart[o->oBehParams & 0xFF];
+    s32 k;
+    // Collision must match the drawn model: checkerboard collision for checkerboard platforms
+    // (same +-256 x +-153.5 extents as its model), unit-box collision (of the right surface) for boxes.
+    if (o->oBehParams & 0x100) o->collisionData = (void *) make_box_col(SURFACE_NOT_SLIPPERY, 0);
+    else if ((k = box_kind_of(p)) < 0) o->collisionData = segmented_to_virtual(checkerboard_platform_seg8_collision_0800D710);
+    else o->collisionData = (void *) make_box_col(box_surface(k), p->force);
+    obj_build_transform_from_pos_and_angle(o, O_POS_INDEX, O_FACE_ANGLE_INDEX);
+    o->oCollisionDistance = DMAX(p->hx, p->hz) + p->h + LAZY_RADIUS + 400.0f;   // loaded wherever an enemy on it is active
+    o->oDrawingDistance = 30000.0f;
+}
+
+static s32 sLastCheck, sFinished, sUnlocked;
+
+void bhv_daily_marker_loop(void) {
+    struct Object *o = gCurrentObject;
+    o->oDrawingDistance = 30000.0f;
+    if (o->oBehParams & 0x400) return;   // static decoration (water, gas)
+    o->oFaceAngleYaw += (o->oBehParams & 0x200) ? 0x500 : 0x300;
+    // The goal star: see-through until the challenge is done, then gone into Mario's hands.
+    if (o->oBehParams & 0x200) {
+        if (sFinished || sMode == MODE_BOSS) { o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE; return; }
+        o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+        o->header.gfx.sharedChild = gLoadedGraphNodes[sUnlocked ? MODEL_GOAL_STAR : MODEL_CHECK_STAR];
+        return;
+    }
+    // A checkpoint's star goes once that checkpoint (or a later one) has been reached.
+    if ((o->oBehParams & 0xFF) <= sLastCheck) o->header.gfx.node.flags &= ~GRAPH_RENDER_ACTIVE;
+    else o->header.gfx.node.flags |= GRAPH_RENDER_ACTIVE;
+}
