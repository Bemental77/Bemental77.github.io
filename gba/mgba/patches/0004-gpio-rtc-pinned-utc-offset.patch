diff --git a/src/gba/cart/gpio.c b/src/gba/cart/gpio.c
index f714cf8..7428bcd 100644
--- a/src/gba/cart/gpio.c
+++ b/src/gba/cart/gpio.c
@@ -16,6 +16,10 @@ mLOG_DEFINE_CATEGORY(GBA_HW, "GBA Pak Hardware", "gba.hardware");
 
 MGBA_EXPORT const int GBA_LUX_LEVELS[10] = { 5, 11, 18, 27, 42, 62, 84, 109, 139, 183 };
 
+// Set by the host (gba/mgba/bridge) when it pins the RTC. 0 / 0 keeps stock behaviour (host local time).
+int bementalRtcPinned = 0;
+int32_t bementalRtcUtcOffsetSec = 0;
+
 static void _readPins(struct GBACartridgeHardware* hw);
 static void _outputPins(struct GBACartridgeHardware* hw, unsigned pins);
 
@@ -312,7 +316,15 @@ void _rtcUpdateClock(struct GBACartridgeHardware* hw) {
 	t -= hw->rtc.offset;
 
 	struct tm date;
-	localtime_r(&t, &date);
+	if (bementalRtcPinned) {
+		// Pinned wall clock (bemental patch): the calendar of (t + a fixed offset) read as UTC, never the host's
+		// time zone. localtime_r() goes through the host's tzset, which makes two machines in different zones
+		// (or one machine across a DST change) feed the game different RTC bytes.
+		time_t shifted = t + (time_t) bementalRtcUtcOffsetSec;
+		gmtime_r(&shifted, &date);
+	} else {
+		localtime_r(&t, &date);
+	}
 	hw->rtc.time[0] = _rtcBCD(date.tm_year - 100);
 	hw->rtc.time[1] = _rtcBCD(date.tm_mon + 1);
 	hw->rtc.time[2] = _rtcBCD(date.tm_mday);
